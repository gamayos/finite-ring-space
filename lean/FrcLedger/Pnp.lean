/-- 26:B5 — the Gauss-sum product on a finite field into any domain (`FRC.HorizonML.gauss_product`,
`Theme/Horizon.lean`). -/
theorem gauss_product {F : Type*} [Field F] [Fintype F] {R' : Type*} [CommRing R'] [IsDomain R']
    {χ : MulChar F R'} (hχ : χ ≠ 1) {ψ : AddChar F R'} (hψ : ψ.IsPrimitive) :
    gaussSum χ ψ * gaussSum χ⁻¹ ψ⁻¹ = Fintype.card F :=
  FRC.HorizonML.gauss_product hχ hψ

/-- 26:B5 — the Gauss-sum modulus over the complex numbers (`FRC.Chart.gauss_modulus`, `Theme/Chart.lean`). -/
theorem gauss_modulus {F : Type*} [Field F] [Fintype F] {χ : MulChar F ℂ} (hχ : χ ≠ 1) {ψ : AddChar F ℂ}
    (hψ : ψ.IsPrimitive) :
    gaussSum χ ψ * star (gaussSum χ ψ) = Fintype.card F ∧ Complex.normSq (gaussSum χ ψ) = Fintype.card F :=
  FRC.Chart.gauss_modulus hχ hψ

/-- 26:C2 [chart] — the family's bits and the table beyond the horizon (`FRC.Chart.family_bits`, `Theme/Chart.lean`). -/
theorem family_bits (Λ ℓP r S Ω : ℝ) (hΛ : Λ = 1.088e-52) (hℓ : ℓP = 1.616255e-35)
    (hr2 : r ^ 2 = 3 / Λ) (hS : S = π * (r / ℓP) ^ 2) (hΩ : Ω = 4 * S + 1) :
    (2 : ℝ) ^ 204 < √Ω ∧ √Ω < (2 : ℝ) ^ 205 ∧ (2 : ℝ) ^ 102 < √(√Ω) ∧ √(√Ω) < (2 : ℝ) ^ 103 :=
  FRC.Chart.family_bits Λ ℓP r S Ω hΛ hℓ hr2 hS hΩ

/-- 26:B4 [chart] — the dilation generator's eigenfunction (`FRC.Chart.dilation_eigen`, `Theme/Chart.lean`). -/
theorem dilation_eigen (ν x : ℝ) (hx : 0 < x) :
    -Complex.I * ((x : ℂ) * deriv (fun t : ℝ => (t : ℂ) ^ (-(1 / 2 : ℂ) + Complex.I * ν)) x
      + (1 / 2 : ℂ) * (x : ℂ) ^ (-(1 / 2 : ℂ) + Complex.I * ν))
      = ν * (x : ℂ) ^ (-(1 / 2 : ℂ) + Complex.I * ν) :=
  FRC.Chart.dilation_eigen ν x hx

