  @FRC.Ledger.p25024
/-- 25:F3 (p25025) — Quotation exceeds mention: a formula's arity is below its length. No sentence $\lambda$ contains a subformula whose truth depends on all coordinates of a tuple of arity at least $\lvert \lambda\rvert$. Under any coding that spends at least $\lvert \lambda\rvert$ coordinates on $\lambda$, per-symbol coding included, no sentence's truth is sensitive to every coordinate of its own code. -/
theorem p25025 : (∀ (φ : FRC.Godel.Fm) (j N : Nat), (∀ (i : Nat), i < N → FRC.Godel.occ (i + j) φ = true) → N < FRC.Godel.size φ) ∧ (∀ (p : Nat) (φ : FRC.Godel.Fm) (j N : Nat), (∀ (i : Nat), i < N → ∃ env v, FRC.Godel.holds p (FRC.Godel.upd env (i + j) v) φ ≠ FRC.Godel.holds p env φ) → N < FRC.Godel.size φ) ∧ ∀ (p : Nat) {ψ lam : FRC.Godel.Fm}, FRC.Godel.Subformula ψ lam → ∀ (j N : Nat), FRC.Godel.size lam ≤ N → ¬∀ (i : Nat), i < N → ∃ env v, FRC.Godel.holds p (FRC.Godel.upd env (i + j) v) ψ ≠ FRC.Godel.holds p env ψ :=
  @FRC.Ledger.p25025
/-- 25:F4 (p25048) — Density: $m$ has $d$ base-$a$ digits. An injective coding of length-$n$ strings by $k$-tuples, $k\ge1$, needs $m^{k}\ge a^{n}$, so $n<dk$. In F2's $\delta(u)=\exists v\,(\mathrm{Diag}(u,v)\wedge\theta(v))$ let $v$ have $k$ coordinates and $u$ have $k_{1}$. Each coordinate of $v$ is named three times, each of $u$ once. So $\lvert\delta\rvert\ge2c(k)+c(k+k_{1})$, and $\lambda=\delta(\ulcorner\delta\urcorner)$ has $\lvert\lambda\rvert\ge3c(k)+k_{1}$, $c(j)$ the total length of the $j$ shortest names. -/
theorem p25048 : (∀ {a n m k : Nat} (c : Nat → Nat), (∀ (i : Nat), i < a ^ n → c i < m ^ k) → (∀ (i j : Nat), i < a ^ n → j < a ^ n → c i = c j → i = j) → a ^ n ≤ m ^ k) ∧ ∀ {a n m k d : Nat}, (0 : Nat) < a → m < a ^ d → a ^ n ≤ m ^ (k + (1 : Nat)) → n < d * (k + (1 : Nat)) :=
  @FRC.Ledger.p25048
/-- 25:F6 (p25047) — The threshold lies inside the count: the code of $\delta$ fills $u$, that of $\lambda$ fills $v$. By F4 the template needs $2c(k)+c(k+k_{1})<dk_{1}$ and $3c(k)+k_{1}<dk$. Let $k^{*}(\M)$ be the largest such $k$, or $0$ if none, and $t(\M)=d\,k^{*}(\M)$. No instance codes $\lambda$ at length $n\ge t(\M)$, and $t(\M)<m$ in every structure. $k^{*}(\M)<6a^{\lfloor d/3\rfloor+1}$, and $k<6a^{\lfloor d/4\rfloor+1}$ at one scale, $k_{1}=k$. -/
theorem p25047 : (∀ (a : Nat), (2 : Nat) ≤ a → ∀ (k J : Nat), k * J + (2 : Nat) ≤ FRC.Diagonal.nameCost a k + (2 : Nat) * a ^ J) ∧ (∀ {a d k k₁ : Nat}, (2 : Nat) ≤ a → FRC.Diagonal.admits a d k k₁ = true → k < a ^ (FRC.Diagonal.third d + (4 : Nat))) ∧ (∀ {a d k : Nat}, (2 : Nat) ≤ a → FRC.Diagonal.admits a d k k = true → k < (6 : Nat) * a ^ (FRC.Diagonal.quarter d + (1 : Nat))) ∧ (∀ {a d k k₁ : Nat}, (0 : Nat) < a → d ≤ (4 : Nat) → FRC.Diagonal.admits a d k k₁ = false) ∧ (∀ {a d k k₁ : Nat}, (2 : Nat) ≤ a → FRC.Diagonal.admits a d k k₁ = true → k ≤ FRC.Diagonal.kstar a d) ∧ (∀ {a d : Nat}, (2 : Nat) ≤ a → FRC.Diagonal.kstar a d < a ^ (FRC.Diagonal.third d + (4 : Nat))) ∧ (∀ {a d k k₁ m n : Nat}, (2 : Nat) ≤ a → FRC.Diagonal.admits a d (k + (1 : Nat)) k₁ = true → m < a ^ d → a ^ n ≤ m ^ (k + (1 : Nat)) → n < FRC.Diagonal.threshold a d) ∧ (∀ {a d m : Nat}, (2 : Nat) ≤ a → a ^ (d - (1 : Nat)) ≤ m → FRC.Diagonal.threshold a d < m) ∧ ∀ {a d : Nat}, (2 : Nat) ≤ a → FRC.Diagonal.threshold a d < a ^ (d - (1 : Nat)) :=
  @FRC.Ledger.p25047
/-- 25:F7 (p25049) — Decoders: over $\M_p$ with $+$, $\times$, $0$ and $1$, a formula $\mathrm{Int}_{J}(x)$ of $50J+29$ symbols in the syntax of F8 defines $\{0,\dots,2^{J}-1\}$ when $2^{J}\le p$. It writes the binary expansion with six bound variables, four of them reused. A formula $\mathrm{Dig}(y,r,s)$ defines digit $r$ of $y<\beta^{n}$ in base $\beta=2^{b}$ when $2^{bn+1}<p$, at a length linear in $bn$. -/
theorem p25049 : (∀ (p : Nat), (2 : Nat) ≤ p → ∀ (J : Nat), (2 : Nat) ^ J ≤ p → ∀ (env : Nat → Nat) (x : Nat), env x < p → (FRC.Diagonal.holds p env (FRC.Diagonal.IntJ J x) = true ↔ env x < (2 : Nat) ^ J)) ∧ (∀ (p : Nat), (0 : Nat) < p → ∀ (J w x : Nat), FRC.Diagonal.InSeg p J w x ↔ ∃ c, c < (2 : Nat) ^ J ∧ x = c * w % p) ∧ ∀ (J x : Nat), FRC.Diagonal.size (FRC.Diagonal.IntJ J x) = (25 : Nat) * J + (10 : Nat) :=
  @FRC.Ledger.p25049
/-- 25:G1 (p25028) — Length horizon: a certificate contains its designated end sentence, so no sentence longer than $B=\min(K,H)$ is certifiable. None longer than $H$ has a derivation of length at most $H$ in any system. Beyond every budget there are truths, by counting alone (E1, E2). -/
theorem p25028 : (∀ (l : List FRC.Logic.FForm) (φ : FRC.Logic.FForm), φ ∈ l → ∀ (B : Nat), FRC.Reach.csize l ≤ B → FRC.Reach.fsize φ ≤ B) ∧ (∀ (l : List FRC.Logic.FForm) (φ : FRC.Logic.FForm), φ ∈ l → ∀ (H : Nat), H < FRC.Reach.fsize φ → ¬FRC.Reach.csize l ≤ H) ∧ ∀ (p : Nat), (0 : Nat) < p → ∀ (B : Nat), ∃ s t, FRC.Reach.leaves s = FRC.Reach.leaves t ∧ B < FRC.Reach.leaves s ∧ FRC.Reach.val ((1 : Nat) % p) (fun x y => (x + y) % p) s = FRC.Reach.val ((1 : Nat) % p) (fun x y => (x + y) % p) t :=
  @FRC.Ledger.p25028
/-- 25:G2 (p25029) — The evaluation ceiling: without the local-checkability clause the one-rule system $\D_{\mathrm{tt}}$ asserts $\varphi$ outright on exhaustive evaluation. It is sound, and every true $\varphi$ has a derivation of length $\lvert \varphi\rvert$. So a truth lacks a derivation of length at most $H$ exactly when it is longer than $H$. The step-check of $\D_{\mathrm{tt}}$ costs on the order of $m^{q}$ evaluations. -/
theorem p25029 : (∀ (M : FRC.Logic.FinStr) (env : Nat → Nat) (φ : FRC.Logic.FForm), FRC.Reach.DttDerives M env φ ↔ FRC.Logic.Sat M env φ) ∧ (∀ (M : FRC.Logic.FinStr) (env : Nat → Nat) (φ : FRC.Logic.FForm) (H : Nat), FRC.Logic.Sat M env φ ∧ FRC.Reach.csize [φ] ≤ H ↔ FRC.Reach.DttDerives M env φ ∧ FRC.Reach.fsize φ ≤ H) ∧ ∀ (M : FRC.Logic.FinStr) (q : Nat) (φ : FRC.Logic.FForm), FRC.Reach.cost M (FRC.Reach.allBlock q φ) = M.m ^ q * FRC.Reach.cost M φ :=
  @FRC.Ledger.p25029
/-- 25:G4 (p25031) — Prefix simulation: $Q_{1}z_{1}\cdots Q_{d}z_{d}\,\psi(\bar z)$ holds in $\M$ exactly when $\forall y_{1}\exists x_{1}\cdots\forall y_{d}\exists x_{d}\,[\bigwedge_{i:Q_{i}=\forall}x_{i}=y_{i}\wedge\psi(\bar x)]$ does: one uniform prefix simulates every coded quantifier pattern. -/
theorem p25031 : (∀ (m : Nat), (0 : Nat) < m → ∀ (ψ : List Nat → Bool) (pat : List Bool) (acc : List Nat) (c : Bool), FRC.Godel.paired m ψ pat acc c = (c && FRC.Godel.direct m ψ pat acc)) ∧ ∀ (m : Nat), (0 : Nat) < m → ∀ (ψ : List Nat → Bool) (pat : List Bool), FRC.Godel.paired m ψ pat [] true = FRC.Godel.direct m ψ pat [] :=
  @FRC.Ledger.p25031
/-- 25:G6 (p25033) — What remains undefinable: no single formula defines truth across all lengths, since a formula has fixed arity. Under per-symbol coding none defines truth for sentences longer than itself, by F1. Between the two, truth is definable fragment by fragment, from just above and never from within. -/
theorem p25033 : (∀ (φ : FRC.Diagonal.Fm) (j N : Nat), (∀ (i : Nat), i < N → FRC.Diagonal.occ (i + j) φ = true) → N < FRC.Diagonal.size φ) ∧ (∀ (p : Nat) (φ : FRC.Diagonal.Fm) (j N : Nat), (∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env (i + j) v) φ ≠ FRC.Diagonal.holds p env φ) → N < FRC.Diagonal.size φ) ∧ ∀ (p : Nat) {ψ lam : FRC.Diagonal.Fm}, FRC.Diagonal.Subformula ψ lam → ∀ (j N : Nat), FRC.Diagonal.size lam ≤ N → ¬∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env (i + j) v) ψ ≠ FRC.Diagonal.holds p env ψ :=
  @FRC.Ledger.p25033
/-- 25:G7 (p25034) — Decomposition: each classical limitation (G\"odel I and II, Tarski, speed-up) splits into a counting and a complexity face. The counting face is a theorem (E2, G1, D1, G6), and $\Con{H}(\D)$ is true at grade (ii). The complexity face is imported (G3), with one reversal (G5). The diagonal is unavailable: per-symbol at every scale (F2), any coding beyond $t(\M)$ (F6). -/
theorem p25034 : (∀ (a : Nat), (2 : Nat) ≤ a → ∀ (B N L : Nat), a ^ (B + (1 : Nat)) * N ≤ L → FRC.Logic.records a B * N < (2 : Nat) ^ L) ∧ (∀ (l : List FRC.Logic.FForm) (φ : FRC.Logic.FForm), φ ∈ l → ∀ (B : Nat), FRC.Reach.csize l ≤ B → FRC.Reach.fsize φ ≤ B) ∧ (∀ {m R : Nat}, R < m → ∀ (ρ : Nat → Nat), (∀ (i : Nat), i < m → ρ i < R) → ¬∀ (i j : Nat), i < m → j < m → ρ i = ρ j → i = j) ∧ (∀ (p : Nat) {ψ lam : FRC.Diagonal.Fm}, FRC.Diagonal.Subformula ψ lam → ∀ (j N : Nat), FRC.Diagonal.size lam ≤ N → ¬∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env (i + j) v) ψ ≠ FRC.Diagonal.holds p env ψ) ∧ (∀ (p N : Nat) (diag θ : FRC.Diagonal.Fm), (∀ (i : Nat), i < (2 : Nat) * N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) diag ≠ FRC.Diagonal.holds p env diag) → (2 : Nat) * N + FRC.Diagonal.size θ + (3 : Nat) * N ≤ FRC.Diagonal.size (FRC.Diagonal.exBlock N (diag.conj θ))) ∧ ∀ {a d m : Nat}, (2 : Nat) ≤ a → a ^ (d - (1 : Nat)) ≤ m → FRC.Diagonal.threshold a d < m :=
  @FRC.Ledger.p25034
/-- 25:H2 (p25036) — Finiteness, the finite direction: for finite $\M$ the full second-order theory $\ThSO(\M)$ is decidable. A second-order quantifier over $k$-ary relations ranges over the $2^{m^{k}}$ subsets of $\M^{k}$, and exhaustive evaluation decides every second-order sentence. -/
theorem p25036 : (∀ (M : FRC.Logic.FinStr) (φ : FRC.Logic.SForm) (env senv renv : Nat → Nat), FRC.Logic.sval2 M env senv renv φ = true ↔ FRC.Logic.Sat2 M env senv renv φ) ∧ ∀ (M : FRC.Logic.FinStr) (φ : FRC.Logic.SForm) (env senv renv : Nat → Nat), FRC.Logic.Sat2 M env senv renv φ ∨ FRC.Logic.Sat2 M env senv renv φ.neg :=
  @FRC.Ledger.p25036
/-- 25:H4 (p25038) — Determinacy meets effectivity only on the finite. The structures whose entire theory, second-order included under full semantics, is decidable are exactly the finite ones, in H3's sense of infinite (H2, H3). Infinite structures offer determinacy at grade (i) or effectivity over a fragment. Finitude delivers both, at grade (ii). -/
theorem p25038 : (∀ (M : FRC.Logic.FinStr) (φ : FRC.Logic.SForm) (env senv renv : Nat → Nat), FRC.Logic.sval2 M env senv renv φ = true ↔ FRC.Logic.Sat2 M env senv renv φ) ∧ ∀ (M : FRC.Logic.FinStr) (φ : FRC.Logic.SForm) (env senv renv : Nat → Nat), FRC.Logic.Sat2 M env senv renv φ ∨ FRC.Logic.Sat2 M env senv renv φ.neg :=
  @FRC.Ledger.p25038
/-- 25:H5 (p25039) — Trichotomy: consistent, effectively axiomatised theories fall into three disjoint, exhaustive cells. (i) Essentially undecidable theories, whose incompleteness is irreparable. (ii) Theories outside (i) with no finite model, whose incompleteness an effective extension removes. ``At least $n$ elements, for every $n$'' with a free predicate is one. (iii) Theories with a finite model. Irreparable incompleteness tracks effective self-representation, not cardinality. -/
theorem p25039 : (∀ (M : FRC.Logic.FinStr) (env : Nat → Nat) (n : Nat), n ≤ M.m → FRC.Logic.Sat M env (FRC.Reach.atLeast n)) ∧ (∀ (M : FRC.Logic.FinStr) (env : Nat → Nat), ¬FRC.Logic.Sat M env (FRC.Reach.atLeast (M.m + (1 : Nat)))) ∧ ∀ (N : Nat), (0 : Nat) < N → ∀ (env : Nat → Nat), (∀ (n : Nat), n ≤ N → FRC.Logic.Sat (FRC.Reach.withP N) env (FRC.Reach.atLeast n)) ∧ FRC.Logic.Sat (FRC.Reach.withP N) env FRC.Reach.someP ∧ (∀ (n : Nat), n ≤ N → FRC.Logic.Sat (FRC.Reach.withoutP N) env (FRC.Reach.atLeast n)) ∧ ¬FRC.Logic.Sat (FRC.Reach.withoutP N) env FRC.Reach.someP :=
  @FRC.Ledger.p25039
/-- 25:J2 (p25041) — Neutrality, certificate level: place a bounded agent in an infinite world under a consistent, effective $\mathsf{Q}$-interpreting description, or in a sufficiently large finite structure. Categorical contents are realised certificate for certificate (D4), and conditional contents transfer verbatim. No certificate available to a bounded agent discriminates the two situations. -/
theorem p25041 : (∀ (u : Nat) (f g : Nat → Nat → Nat) (t : FRC.Reach.Tm), FRC.Reach.Agree u f g t → FRC.Reach.val u g t = FRC.Reach.val u f t) ∧ ∀ (u : Nat) (f g : Nat → Nat → Nat) (s t : FRC.Reach.Tm), FRC.Reach.Agree u f g s → FRC.Reach.Agree u f g t → FRC.Reach.val u f s = FRC.Reach.val u f t → FRC.Reach.val u g s = FRC.Reach.val u g t :=
  @FRC.Ledger.p25041
-- end ledger predicates

end FRC.Godel
