/-- 25:D4 — `FRC.Reach.trace_transport`. -/
theorem trace_transport (u : Nat) (f g : Nat → Nat → Nat) : ∀ t : Tm, Agree u f g t → val u g t = val u f t :=
  FRC.Reach.trace_transport u f g
/-- 25:D4 — `FRC.Reach.wrap_equation`. -/
theorem wrap_equation (u : Nat) (f g : Nat → Nat → Nat) (s t : Tm) (hs : Agree u f g s) (ht : Agree u f g t)
    (h : val u f s = val u f t) : val u g s = val u g t :=
  FRC.Reach.wrap_equation u f g s t hs ht h
/-- 25:D4 — `FRC.Reach.lookups_succ`. -/
theorem lookups_succ : ∀ t : Tm, lookups t + 1 = leaves t :=
  FRC.Reach.lookups_succ
