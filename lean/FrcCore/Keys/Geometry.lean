-- Keys of the geometry theme (generated by make_keys.py from the ledgers' Lean bindings; edit the ledgers, not this file)
/-- p02008 — 2:B4. Cellular automorphisms of the index grid: $m\mapsto\pm m+c$, the dihedral group of the phase cycle; on the completion also meridian reversal $a\mapsto\pi-a$, exchanging the poles. The reindexing $\rho_{u}\colon m\mapsto um$ preserves latitude adjacency only for $u\equiv\pm1\pmod{\p-1}$; $\sigma$ is not a map of $\Sp$ ($\north$ one vertex, $L_{\pi}$ has $\p-1$). -/
theorem p02008 : (∀ (n u : Nat), (3 : Nat) ≤ n → ((∀ (m : Nat), m < n → FRC.Geometry.Adj n (FRC.Geometry.rho n u m) (FRC.Geometry.rho n u ((m + (1 : Nat)) % n))) ↔ u % n = (1 : Nat) ∨ u % n = n - (1 : Nat))) ∧ (∀ (n c m : Nat), (0 : Nat) < n → FRC.Geometry.Adj n ((m + c) % n) (((m + (1 : Nat)) % n + c) % n)) ∧ FRC.Complex.cellular (13 : Nat) (1 : Nat) = true ∧ FRC.Complex.cellular (13 : Nat) (5 : Nat) = false ∧ FRC.Complex.cellular (13 : Nat) (7 : Nat) = false ∧ FRC.Complex.cellular (13 : Nat) (11 : Nat) = true ∧ FRC.Complex.poleExchange (13 : Nat) = true :=
  And.intro @FRC.Geometry.rho_adj_iff (And.intro @FRC.Geometry.rotation_adj (@FRC.Complex.census13))
/-- p02010 — 2:C2. Counts: $|V|=\pi(\p-1)+1$, $|E|=2\pi(\p-1)$, $|F|=\pi(\p-1)$, $\chi(\Sp)=1$; the completion has $(\pi-1)(\p-1)+2$ vertices, $(2\pi-1)(\p-1)$ edges, $\pi(\p-1)$ faces, $\chi=2$. -/
theorem p02010 : (∀ (m n : Nat), (m + (1 : Nat)) * n + (1 : Nat) + (m + (1 : Nat)) * n = (2 : Nat) * ((m + (1 : Nat)) * n) + (1 : Nat) ∧ m * n + (2 : Nat) + (m + (1 : Nat)) * n = ((2 : Nat) * m + (1 : Nat)) * n + (2 : Nat)) ∧ FRC.Complex.vertexCount (12 : Nat) (6 : Nat) = (62 : Nat) ∧ (FRC.Complex.faces (12 : Nat) (6 : Nat)).length = (72 : Nat) :=
  And.intro @FRC.Geometry.euler_characteristic (@FRC.Complex.counts13)
/-- p02011 — 2:C3. Canonical spherical completion: collapsing $L_{\pi}$ to $\south$ gives a closed orientable surface --- every edge in two faces, every vertex link a cycle --- with $\chi=2$, hence $S^{2}$ (A3), on every shell. -/
theorem p02011 : (∀ (m n : Nat), (m + (1 : Nat)) * n + (1 : Nat) + (m + (1 : Nat)) * n = (2 : Nat) * ((m + (1 : Nat)) * n) + (1 : Nat) ∧ m * n + (2 : Nat) + (m + (1 : Nat)) * n = ((2 : Nat) * m + (1 : Nat)) * n + (2 : Nat)) ∧ FRC.Complex.closed (13 : Nat) = true ∧ FRC.Complex.edgesInTwoFaces (FRC.Complex.facesOpen (12 : Nat) (6 : Nat)) = false ∧ (FRC.Complex.facesOpen (12 : Nat) (6 : Nat)).length = (72 : Nat) :=
  And.intro @FRC.Geometry.euler_characteristic (And.intro @FRC.Complex.closed13 (@FRC.Complex.open13))
/-- p02012 — 2:C4. Frame covariance: $\Sp$ is one complex for every generator --- the index grid $I_{\p}\times\Phi_{\p}$ with its step relations; the frame $\gen'=\gen^{u}$ moves the field labels, $a\gen^{m}\mapsto a\gen^{um}$, by the automorphism $\rho_{u}$ of $\Phi_{\p}$, not the cells. The reindexing $\varphi_{u}$ is cellular only for $u\equiv\pm1$. -/
theorem p02012 : (∀ {p : Nat} [FRC.Pos p] {κ : Nat} {g : FRC.Shell p}, FRC.Shell.Frame p κ g → ∀ (u : Nat) (a : FRC.Shell p) (m : Nat), FRC.Geometry.label (g ^ u) a m = FRC.Geometry.label g a (FRC.Geometry.rho (p - (1 : Nat)) u m)) ∧ ∀ (n u : Nat), (3 : Nat) ≤ n → ((∀ (m : Nat), m < n → FRC.Geometry.Adj n (FRC.Geometry.rho n u m) (FRC.Geometry.rho n u ((m + (1 : Nat)) % n))) ↔ u % n = (1 : Nat) ∨ u % n = n - (1 : Nat)) :=
  And.intro @FRC.Geometry.label_covariance (@FRC.Geometry.rho_adj_iff)
/-- p02018 — 2:D6. The Euler identity on the shell: $\eu^{\im\pi}=\gen^{2\kap\im^{2}}=(-1)^{\im}$, equal to $-1$ exactly when the representative of $\im$ is odd (00:C14); the oriented frames of a shell are those with $-\gen^{\kap}$ odd --- on $\F_{13}$, $\gen=2$ ($\im=5$) is one and $\gen=7$ ($\im=8$) is not. -/
theorem p02018 : (∀ {p : Nat} [FRC.Pos p] {κ : Nat} {g : FRC.Shell p}, FRC.Shell.Frame p κ g → ∀ (i : Nat), (g ^ i) ^ (i * ((2 : Nat) * κ)) = if i % (2 : Nat) = (0 : Nat) then (1 : FRC.Shell p) else (-1 : FRC.Shell p)) ∧ FRC.Shell.Frame.quarterTurn (2 : FRC.Shell (13 : Nat)) (3 : Nat) = (5 : FRC.Shell (13 : Nat)) ∧ FRC.Shell.Frame.quarterTurn (7 : FRC.Shell (13 : Nat)) (3 : Nat) = (8 : FRC.Shell (13 : Nat)) ∧ ((2 : FRC.Shell (13 : Nat)) ^ (5 : Nat)) ^ ((5 : Nat) * (6 : Nat)) = (-1 : FRC.Shell (13 : Nat)) ∧ ((7 : FRC.Shell (13 : Nat)) ^ (8 : Nat)) ^ ((8 : Nat) * (6 : Nat)) = (1 : FRC.Shell (13 : Nat)) ∧ (2 : FRC.Shell (13 : Nat)) ^ (11 : Nat) = (7 : FRC.Shell (13 : Nat)) :=
  And.intro @FRC.Shell.Frame.euler_identity (@FRC.Geometry.s13_orientation)
/-- p02023 — 2:E3. Fixed-shell refinement is bounded: with $\gen^{m}\le2\kap+1<\gen^{m+1}$ no point $x/\gen^{n}$, $0\le x\le2\kap$, lies in $(\max(1-\gen^{-m},2\kap\gen^{-m-1}),1)$ at any depth, so the covering radius of the scale grids in $[0,1]$ is $\ge\tfrac12\min(\gen^{-m},1-2\kap\gen^{-m-1})\ge1/(\p+1)$: $1/8$ at $(13,2)$, $5/22$ at $(13,11)$. -/
theorem p02023 : (∀ (g κ m n x : Nat), (2 : Nat) ≤ g → x ≤ (2 : Nat) * κ → x < g ^ n → x * g ^ m + g ^ n ≤ g ^ m * g ^ n ∨ x * g ^ (m + (1 : Nat)) ≤ (2 : Nat) * κ * g ^ n) ∧ (∀ (g κ m : Nat), (0 : Nat) < κ → (2 : Nat) * κ + (1 : Nat) < g ^ (m + (1 : Nat)) → g ^ (m + (1 : Nat)) < (g ^ (m + (1 : Nat)) - (2 : Nat) * κ) * ((2 : Nat) * κ + (1 : Nat))) ∧ ∀ (n x : Nat), x ≤ (6 : Nat) → ¬((3 : Nat) * (2 : Nat) ^ n < (4 : Nat) * x ∧ x < (2 : Nat) ^ n) :=
  And.intro @FRC.Geometry.fixed_shell_bound (And.intro @FRC.Geometry.fixed_shell_floor (@FRC.Geometry.fixed_shell_gap))
/-- p02030 — 2:F6. Exact external transport [chart]: $\chi(\gen^{m})=e^{-2\pi_{\R}im/n}$ is an isomorphism of $\Fpx$ onto the complex $n$-th roots of unity with $\chi(\gen^{m+1})=e^{-2\pi_{\R}i/n}\chi(\gen^{m})$, $\chi(\gen^{m+\pi})=-\chi(\gen^{m})$, $\chi(\im\gen^{m})=i\,\chi(\gen^{m})$; in the exponents, $\gen^{m+\pi}=-\gen^{m}$ and $\im\gen^{m}=\gen^{m+3\kap}$. -/
theorem p02030 : ∀ {p : Nat} [FRC.Pos p] {κ : Nat} {g : FRC.Shell p}, FRC.Shell.Frame p κ g → ∀ (m j r : Nat), g ^ (m + (2 : Nat) * κ) = -g ^ m ∧ FRC.Shell.Frame.quarterTurn g κ * g ^ m = g ^ (m + (3 : Nat) * κ) ∧ (g ^ j) ^ r = g ^ (j * r) :=
  @FRC.Geometry.transport_exponents
