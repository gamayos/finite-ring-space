/-- p25023 — 25:F1. Mention cost: if the truth of a formula in $\M$ depends on coordinate $i$ of a tuple of variables, then $v_{i}$ occurs in it. A formula whose truth depends on all $N$ coordinates has length at least $N$. A quantifier block binding an $N$-tuple contributes at least $N$ symbols. -/
theorem p25023 : (∀ (p : Nat) (φ : FRC.Diagonal.Fm) {env env' : Nat → Nat}, (∀ (i : Nat), FRC.Diagonal.occ i φ = true → env i = env' i) → FRC.Diagonal.holds p env φ = FRC.Diagonal.holds p env' φ) ∧ (∀ (p : Nat) (φ : FRC.Diagonal.Fm) (env : Nat → Nat) (i v : Nat), FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) φ ≠ FRC.Diagonal.holds p env φ → FRC.Diagonal.occ i φ = true) ∧ (∀ (φ : FRC.Diagonal.Fm) (N : Nat), (∀ (i : Nat), i < N → FRC.Diagonal.occ i φ = true) → N ≤ FRC.Diagonal.size φ) ∧ (∀ (p : Nat) (φ : FRC.Diagonal.Fm) (N : Nat), (∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) φ ≠ FRC.Diagonal.holds p env φ) → N ≤ FRC.Diagonal.size φ) ∧ ∀ (n : Nat) (φ : FRC.Diagonal.Fm), FRC.Diagonal.size (FRC.Diagonal.exBlock n φ) = FRC.Diagonal.size φ + (3 : Nat) * n :=
  And.intro @FRC.Diagonal.holds_congr (And.intro @FRC.Diagonal.mention (And.intro @FRC.Diagonal.arity_le_size (And.intro @FRC.Diagonal.mention_cost (@FRC.Diagonal.size_exBlock))))
/-- p25024 — 25:F2. No compression: code strings of length at most $N$ as tuples in $\M^{N}$, one coordinate per symbol, signature and alphabet fixed independently of $N$, $\theta$ non-degenerate. The G\"odel template has no instance at any scale. The diagonal formula needs $\lvert \delta\rvert\ge3N+\lvert \theta\rvert>N$ symbols, so its code is not in $\M^{N}$. Splitting the scales fails: $\delta$ outgrows the scale $\theta$ reads. -/
theorem p25024 : (∀ (p N : Nat) (diag θ : FRC.Diagonal.Fm), (∀ (i : Nat), i < (2 : Nat) * N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) diag ≠ FRC.Diagonal.holds p env diag) → (2 : Nat) * N + FRC.Diagonal.size θ + (3 : Nat) * N ≤ FRC.Diagonal.size (FRC.Diagonal.exBlock N (diag.conj θ))) ∧ (∀ (N : Nat), (1 : Nat) ≤ N → ∀ (φ : FRC.Diagonal.Fm), ¬FRC.Diagonal.size (FRC.Diagonal.exBlock N φ) ≤ N) ∧ (∀ (p N N₂ : Nat) (diag θ : FRC.Diagonal.Fm), (∀ (i : Nat), i < N₂ → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) θ ≠ FRC.Diagonal.holds p env θ) → N₂ < FRC.Diagonal.size (FRC.Diagonal.exBlock N (diag.conj θ))) ∧ ∀ (p : Nat) (φ : FRC.Diagonal.Fm) (N : Nat), (∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) φ ≠ FRC.Diagonal.holds p env φ) → N ≤ FRC.Diagonal.size φ :=
