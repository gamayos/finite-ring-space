/-- p05018 — 5:D2. Antinomy normal form: Cns $+$ AT $+$ comprehension is inconsistent (Russell, Burali--Forti); the witness of Cns $+\neg$AT is bounded comprehension --- every set $u$ has a subset not among its members and no universal set exists, decided on $V_4$. -/
theorem p05018 : And (∀ {α : Type} (M : α → α → Prop), Not (@Exists α fun r => ∀ (x : α), Iff (M x r) (Not (M x x)))) (And (∀ {α : Type} (M : α → α → Prop) (sep : α → α), (∀ (u x : α), Iff (M x (sep u)) (And (M x u) (Not (M x x)))) → Not (@Exists α fun v => ∀ (x : α), M x v)) (And (∀ {α : Type} (M : α → α → Prop) (u r : α), (∀ (x : α), Iff (M x r) (And (M x u) (Not (M x x)))) → Not (M r u)) (And (∀ (x : FRC.Sets.HF), Not (x.Mem x)) (And (∀ (u : FRC.Sets.HF), Not ((FRC.Sets.russell u).Mem u)) (∀ (v : FRC.Sets.HF), @Exists FRC.Sets.HF fun x => Not (x.Mem v)))))) :=
  And.intro @FRC.Sets.no_russell_class (And.intro @FRC.Sets.no_universal_of_separation (And.intro @FRC.Sets.russell_not_mem (And.intro @FRC.Sets.not_mem_self (And.intro @FRC.Sets.russell_not_mem_hf (@FRC.Sets.no_universal)))))
/-- p05019 — 5:D3. Diagonal normal form: $\{$Eff, Cns, Cmp, IR$\}$ inconsistent (B2), Tarski a variant with the truth predicate for Cmp; the diagonal is a theorem when external --- Cantor's theorem, $n<2^{n}$ on every frame, uncountability, halting --- and a paradox engine only over an internalised registry with completeness demanded. -/
theorem p05019 : ∀ (n : Nat), n < (2 : Nat) ^ n :=
  @FRC.Logic.cantor_finite
