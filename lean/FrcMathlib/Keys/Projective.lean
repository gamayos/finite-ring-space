-- Keys of the projective theme (generated by make_keys.py from the ledgers' Lean bindings; edit the ledgers, not this file)
/-- p07015 — 7:D5. No definite space: every three-dimensional subspace of the register square contains a null vector. -/
theorem p07015 : ∀ {p : ℕ} [hp : Fact (Nat.Prime p)] (ν : ZMod p) (u v w : Fin (4 : ℕ) → ZMod p), ∃ a, a ≠ (0 : Fin (3 : ℕ) → ZMod p) ∧ FRC.Lorentz.Qf ν (a (0 : Fin (3 : ℕ)) • u + a (1 : Fin (3 : ℕ)) • v + a (2 : Fin (3 : ℕ)) • w) = (0 : ZMod p) :=
  @FRC.Lorentz.isotropic_three
