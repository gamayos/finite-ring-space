/-- p38022 — 38:C7. The two faces of the leak: angular $\kap/\dS$ (the curl), temporal $\kap/(2\dS)$ (the ring, on $C_{464}$); ratio exactly $2$, the double cover. -/
theorem p38022 : ∀ (κ S rg psl : ℚ), κ ≠ (0 : ℚ) → S ≠ (0 : ℚ) → rg ≠ (0 : ℚ) → psl ≠ (0 : ℚ) → ((3 / 2 : ℚ) * (rg / psl) = κ / ((2 : ℚ) * S) ↔ psl = (3 : ℚ) * (S / κ) * rg) ∧ (psl = (3 : ℚ) * (S / κ) * rg → (3 : ℚ) * rg / psl = κ / S ∧ psl / rg = (3 : ℚ) * S / κ) ∧ κ / S / (κ / ((2 : ℚ) * S)) = (2 : ℚ) ∧ (3 : ℚ) * (58 : ℚ) / (3 : ℚ) = (58 : ℚ) ∧ (3 : ℚ) * (58 : ℚ) / (1 : ℚ) = (174 : ℚ) :=
