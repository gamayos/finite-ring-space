namespace FRC.LedgerML

-- Keys of the geometry theme (generated by make_keys.py from the ledgers' Lean bindings; edit the ledgers, not this file)
/-- p02007 — 2:B3. Primitive generators form one orbit: every generator is $\gen^{u}$ with $u\in\Zp^{\times}$, a torsor for $\operatorname{Aut}(C_{\p-1})$. -/
theorem p02007 : ∀ {F : Type u_1} [Field F] [Fintype F] (g : F), IsPrimitiveRoot g (Fintype.card F - (1 : ℕ)) → ∀ (h : F), IsPrimitiveRoot h (Fintype.card F - (1 : ℕ)) ↔ ∃ u < Fintype.card F - (1 : ℕ), u.Coprime (Fintype.card F - (1 : ℕ)) ∧ h = g ^ u :=
  @FRC.GeometryML.generator_orbit
/-- p02010 — 2:C2. Counts: $|V|=\pi(\p-1)+1$, $|E|=2\pi(\p-1)$, $|F|=\pi(\p-1)$, $\chi(\Sp)=1$; the completion has $(\pi-1)(\p-1)+2$ vertices, $(2\pi-1)(\p-1)$ edges, $\pi(\p-1)$ faces, $\chi=2$. -/
theorem p02010 : ∀ (π n : ℤ), π * n + (1 : ℤ) - (2 : ℤ) * π * n + π * n = (1 : ℤ) ∧ (π - (1 : ℤ)) * n + (2 : ℤ) - ((2 : ℤ) * π - (1 : ℤ)) * n + π * n = (2 : ℤ) :=
  @FRC.GeometryML.euler_characteristic
/-- p02013 — 2:D1. The half-period: $\gen^{\pi}=-1$ for every primitive $\gen$, $\pi=2\kap$; $2\pi\equiv-1$ (00:C1). -/
theorem p02013 : ∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → ∀ (g : F), IsPrimitiveRoot g (Fintype.card F - (1 : ℕ)) → g ^ ((2 : ℕ) * κ) = (-1 : F) :=
  @FRC.GeometryML.half_period
/-- p02014 — 2:D2. The quarter-turn subgroup $\Qp=\{x:x^{4}=1\}$ is the unique subgroup of order four; $\gen^{\kap}$ has order four with $(\gen^{\kap})^{2}=-1$; $\Qp=\{\pm1,\pm\im\}$ (1:B2). -/
theorem p02014 : ∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → ∀ (g : F), IsPrimitiveRoot g (Fintype.card F - (1 : ℕ)) → (g ^ κ) ^ (2 : ℕ) = (-1 : F) ∧ (g ^ κ) ^ (4 : ℕ) = (1 : F) :=
  @FRC.GeometryML.quarter_turn_order
/-- p02017 — 2:D5. Orientation classes: for $\gen'=\gen^{u}$, $\im'=-\gen'^{\kap}$ equals $\im$ when $u\equiv1\pmod4$ and $-\im$ when $u\equiv3\pmod4$; the oriented quarter-turn is frame-covariant within one class of generators, not under every generator change. -/
theorem p02017 : ∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → ∀ (g : F), IsPrimitiveRoot g (Fintype.card F - (1 : ℕ)) → ∀ (u : ℕ), (u % (4 : ℕ) = (1 : ℕ) → -(g ^ u) ^ κ = -g ^ κ) ∧ (u % (4 : ℕ) = (3 : ℕ) → -(g ^ u) ^ κ = - -g ^ κ) :=
  @FRC.GeometryML.orientation_class
/-- p02018 — 2:D6. The Euler identity on the shell: $\eu^{\im\pi}=\gen^{2\kap\im^{2}}=(-1)^{\im}$, equal to $-1$ exactly when the representative of $\im$ is odd (00:C14); the oriented frames of a shell are those with $-\gen^{\kap}$ odd --- on $\F_{13}$, $\gen=2$ ($\im=5$) is one and $\gen=7$ ($\im=8$) is not. -/
theorem p02018 : ∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → ∀ (g : F), IsPrimitiveRoot g (Fintype.card F - (1 : ℕ)) → ∀ (i : ℕ), (g ^ i) ^ (i * ((2 : ℕ) * κ)) = (-1 : F) ^ i :=
  @FRC.GeometryML.euler_identity
/-- p02023 — 2:E3. Fixed-shell refinement is bounded: with $\gen^{m}\le2\kap+1<\gen^{m+1}$ no point $x/\gen^{n}$, $0\le x\le2\kap$, lies in $(\max(1-\gen^{-m},2\kap\gen^{-m-1}),1)$ at any depth, so the covering radius of the scale grids in $[0,1]$ is $\ge\tfrac12\min(\gen^{-m},1-2\kap\gen^{-m-1})\ge1/(\p+1)$: $1/8$ at $(13,2)$, $5/22$ at $(13,11)$. -/
theorem p02023 : ∀ (g κ m n x : ℕ), (2 : ℕ) ≤ g → x ≤ (2 : ℕ) * κ → ↑x / ↑g ^ n < (1 : ℚ) → ↑x / ↑g ^ n ≤ max ((1 : ℚ) - (1 : ℚ) / ↑g ^ m) ((2 : ℚ) * ↑κ / ↑g ^ (m + (1 : ℕ))) :=
  @FRC.GeometryML.fixed_shell_bound
/-- p02025 — 2:F1. $\gen$ is a principal $n$-th root of unity, $n=\p-1$: $\gen^{n}=1$, $\sum_{j<n}\gen^{jk}=0$ for $0<k<n$, and $n^{-1}=-1$ in $\Fp$ ($2\pi\equiv-1$). -/
theorem p02025 : ∀ {F : Type u_1} [Field F] [Fintype F] (g : F), IsPrimitiveRoot g (Fintype.card F - (1 : ℕ)) → ∀ (k : ℕ), (0 : ℕ) < k → k < Fintype.card F - (1 : ℕ) → ∑ j ∈ Finset.range (Fintype.card F - (1 : ℕ)), (g ^ k) ^ j = (0 : F) ∧ ↑(Fintype.card F - (1 : ℕ)) = (-1 : F) :=
  @FRC.GeometryML.principal_root
set_option linter.defProp false in
