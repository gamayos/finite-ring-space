theorem register_levels (a₀ a₁ b₀ b₁ c₀ c₁ : ℚ) (ha0 : a₀ = 2.2519) (ha1 : a₁ = 3.3870) (hb0 : b₀ = 2.2324)
    (hb1 : b₁ = 3.3302) (hc0 : c₀ = 2.2323) (hc1 : c₁ = 3.3300) :
    (2.2515 : ℚ) < a₀ ∧ a₀ < 2.2525 ∧ (2.2315 : ℚ) < b₀ ∧ b₀ < 2.2325 ∧ (2.2315 : ℚ) < c₀ ∧ c₀ < 2.2325 ∧
