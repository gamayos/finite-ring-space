theorem p28035 : (∀ {p : Nat} [FRC.Pos p] {ν : FRC.Shell p} (c : FRC.Extension.Ext p ν) (M : FRC.Unitary.M3 p ν), FRC.Unitary.mmul (FRC.Unitary.mmul M (FRC.Unitary.adj (FRC.Unitary.smul c M))) (FRC.Flavour.transpose M) = FRC.Unitary.smul (c * c * FRC.Unitary.det M) (FRC.Flavour.transpose M)) ∧ (∀ {p : Nat} [FRC.Pos p] {ν : FRC.Shell p} (a b c a' b' c' : FRC.Extension.Ext p ν), ∃ x y z, FRC.Unitary.mmul (FRC.Unitary.mmul (FRC.Flavour.circ a b c) (FRC.Unitary.adj (FRC.Flavour.circ a' b' c'))) (FRC.Flavour.transpose (FRC.Flavour.circ a b c)) = FRC.Flavour.circ x y z) ∧ ∀ {p : Nat} [FRC.Pos p] {ν : FRC.Shell p} (a b c ω : FRC.Extension.Ext p ν), ω * ω + ω + (1 : FRC.Extension.Ext p ν) = (0 : FRC.Extension.Ext p ν) → c + a * ω + b * (ω * ω) = ω * (a + b * ω + c * (ω * ω)) ∧ b + c * ω + a * (ω * ω) = ω * ω * (a + b * ω + c * (ω * ω)) ∧ c + a * (ω * ω) + b * ω = ω * ω * (a + b * (ω * ω) + c * ω) ∧ b + c * (ω * ω) + a * ω = ω * (a + b * (ω * ω) + c * ω) :=
  @FRC.Ledger.p28035
/-- 28:P1 (p28036) — Charged-lepton Koide $Q_\ell=2/3$ exact on B5 (measured $0.666661\pm0.000007$); $m_e=0.5106$ vs $0.5110$ MeV. Falsifier: a lepton-mass shift of $Q_\ell$ off $2/3$ beyond the $\tau$-mass tolerance. -/
theorem p28036 : (∀ {p : Nat} [FRC.Pos p] (a₀ a₁ a₂ ω : FRC.Shell p), ω * ω + ω + (1 : FRC.Shell p) = (0 : FRC.Shell p) → ((3 : FRC.Shell p) * (a₀ * a₀ + a₁ * a₁ + a₂ * a₂) = (2 : FRC.Shell p) * ((a₀ + a₁ + a₂) * (a₀ + a₁ + a₂)) ↔ (2 : FRC.Shell p) * ((a₀ + a₁ * ω + a₂ * (ω * ω)) * (a₀ + a₁ * (ω * ω) + a₂ * ω)) = (a₀ + a₁ + a₂) * (a₀ + a₁ + a₂))) ∧ ∀ {p : Nat} [FRC.Pos p] {ν h : FRC.Shell p}, h + h = (1 : FRC.Shell p) → ν + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) = (0 : FRC.Shell p) → ∀ (a₀ a₁ a₂ : FRC.Shell p), FRC.Interactions.omega3 ν h * FRC.Interactions.omega3 ν h + FRC.Interactions.omega3 ν h + (1 : FRC.Extension.Ext p ν) = (0 : FRC.Extension.Ext p ν) ∧ FRC.Interactions.hat2 ν h a₀ a₁ a₂ = (FRC.Interactions.hat1 ν h a₀ a₁ a₂).conj ∧ FRC.Interactions.hat1 ν h a₀ a₁ a₂ * FRC.Interactions.hat2 ν h a₀ a₁ a₂ = FRC.Extension.Ext.ofShell (FRC.Interactions.hat1 ν h a₀ a₁ a₂).norm ∧ (3 : FRC.Shell p) * (a₀ * a₀ + a₁ * a₁ + a₂ * a₂) = (a₀ + a₁ + a₂) * (a₀ + a₁ + a₂) + (2 : FRC.Shell p) * (FRC.Interactions.hat1 ν h a₀ a₁ a₂).norm ∧ ((3 : FRC.Shell p) * (a₀ * a₀ + a₁ * a₁ + a₂ * a₂) = (2 : FRC.Shell p) * ((a₀ + a₁ + a₂) * (a₀ + a₁ + a₂)) ↔ (2 : FRC.Shell p) * (FRC.Interactions.hat1 ν h a₀ a₁ a₂).norm = (a₀ + a₁ + a₂) * (a₀ + a₁ + a₂)) :=
  @FRC.Ledger.p28036
/-- 28:P2 (p28037) — Up-quark Koide $Q_u=5/6$ in framed arithmetic, $r_u^2=N(1-\omega)=3$; continuum $0.849$ in the working scheme, $0.832$ with pole masses, band $0.83$--$0.89$. Falsifier: up/charm/top masses moving $Q_u$ outside the band in every standard scheme. -/
theorem p28037 : (∀ {p : Nat} [FRC.Pos p] {ν h : FRC.Shell p}, h + h = (1 : FRC.Shell p) → ν + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) = (0 : FRC.Shell p) → ((1 : FRC.Extension.Ext p ν) + -FRC.Interactions.omega3 ν h).norm = (3 : FRC.Shell p)) ∧ ∀ {p : Nat} [FRC.Pos p] (a₀ a₁ a₂ ω : FRC.Shell p), ω * ω + ω + (1 : FRC.Shell p) = (0 : FRC.Shell p) → (((1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p)) * (a₀ * a₀ + a₁ * a₁ + a₂ * a₂) = ((1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p)) * ((a₀ + a₁ + a₂) * (a₀ + a₁ + a₂)) ↔ ((1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p)) * ((a₀ + a₁ * ω + a₂ * (ω * ω)) * (a₀ + a₁ * (ω * ω) + a₂ * ω)) = ((1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p)) * ((a₀ + a₁ + a₂) * (a₀ + a₁ + a₂))) :=
  @FRC.Ledger.p28037
/-- 28:P3 (p28038) — Cabibbo $V_{us}=|\sqrt{m_d/m_s}-e^{i\varphi}\sqrt{m_u/m_c}|$: leading term $0.224^{+0.011}_{-0.004}$ vs $0.2243$ ($0.3\%$), the up term $\pm0.04$ with $\varphi$ open. Falsifier: no $\varphi$ satisfying the relation within the input band. -/
theorem p28038 : (∀ {p : Nat} [FRC.Pos p] {ν : FRC.Shell p} (sd cu cd su z : FRC.Extension.Ext p ν), z * z.conj = (1 : FRC.Extension.Ext p ν) → (sd * cu + -(cd * su * z)) * (sd * cu + -(cd * su * z.conj)) = sd * cu * (sd * cu) + cd * su * (cd * su) + -(sd * cu * (cd * su) * (z + z.conj))) ∧ ∀ {p : Nat} [FRC.Pos p] (c s m₁ m₂ : FRC.Shell p), c * c + s * s = (1 : FRC.Shell p) → m₁ * (c * c) + m₂ * (s * s) = (0 : FRC.Shell p) → m₂ * (s * s) = -(m₁ * (c * c)) :=
  @FRC.Ledger.p28038
/-- 28:P5 (p28039) — Normal neutrino ordering, from $Q_\nu=2/3$, the two $\Delta m^2$ and the boundary branch (B6); the signed circulant solves both orderings (C11b). Falsifier: inverted ordering. -/
theorem p28039 : (∀ {p : Nat} [FRC.Pos p] {ν : FRC.Shell p} (c : FRC.Extension.Ext p ν) (M : FRC.Unitary.M3 p ν), FRC.Unitary.mmul (FRC.Unitary.mmul M (FRC.Unitary.adj (FRC.Unitary.smul c M))) (FRC.Flavour.transpose M) = FRC.Unitary.smul (c * c * FRC.Unitary.det M) (FRC.Flavour.transpose M)) ∧ ∀ {p : Nat} [FRC.Pos p] {ν : FRC.Shell p} (a b c : FRC.Extension.Ext p ν), FRC.Flavour.transpose (FRC.Flavour.circ a b c) = FRC.Flavour.circ a c b :=
  @FRC.Ledger.p28039
/-- 28:P8 (p28042) — Leptonic CP locked to the octant by \eqref{eq:tm2}: $\delta_{\mathrm{CP}}\in(204^\circ,310^\circ)$ over the $3\sigma$ $\theta_{23}$ range, $\pm124^\circ$/$\pm74^\circ$ at the NuFIT~6.0 best fits, $\sin\delta_{\mathrm{CP}}{<}0$, $J=1/(6\sqrt3)$. Falsifier: CP-conserving $\delta_{\mathrm{CP}}$, $\sin\delta_{\mathrm{CP}}{>}0$, or $(\theta_{23},\delta_{\mathrm{CP}})$ off the relation. -/
theorem p28042 : (∀ {p : Nat} [FRC.Pos p] {ν h : FRC.Shell p}, h + h = (1 : FRC.Shell p) → ν + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) = (0 : FRC.Shell p) → ((1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p)) * -(ν * (h * h)) = (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p)) ∧ (∀ {p : Nat} [FRC.Pos p] {ν : FRC.Shell p}, FRC.Flavour.mulvec FRC.Flavour.shift (1 : FRC.Extension.Ext p ν) (1 : FRC.Extension.Ext p ν) (1 : FRC.Extension.Ext p ν) = ((1 : FRC.Extension.Ext p ν), (1 : FRC.Extension.Ext p ν), (1 : FRC.Extension.Ext p ν)) ∧ FRC.Flavour.mulvec FRC.Flavour.shift ((1 : FRC.Extension.Ext p ν) + (1 : FRC.Extension.Ext p ν)) (-1 : FRC.Extension.Ext p ν) (-1 : FRC.Extension.Ext p ν) = ((-1 : FRC.Extension.Ext p ν), (-1 : FRC.Extension.Ext p ν), (1 : FRC.Extension.Ext p ν) + (1 : FRC.Extension.Ext p ν)) ∧ ∀ (l : FRC.Extension.Ext p ν), l * ((1 : FRC.Extension.Ext p ν) + (1 : FRC.Extension.Ext p ν)) = (-1 : FRC.Extension.Ext p ν) → l * (-1 : FRC.Extension.Ext p ν) = (-1 : FRC.Extension.Ext p ν) → l * (-1 : FRC.Extension.Ext p ν) = (1 : FRC.Extension.Ext p ν) + (1 : FRC.Extension.Ext p ν) → (1 : FRC.Extension.Ext p ν) + (1 : FRC.Extension.Ext p ν) + (1 : FRC.Extension.Ext p ν) = (0 : FRC.Extension.Ext p ν)) ∧ ∀ {p : Nat} [FRC.Pos p] {ν h : FRC.Shell p}, h + h = (1 : FRC.Shell p) → ν + (1 : FRC.Shell p) + (1 : FRC.Shell p) + (1 : FRC.Shell p) = (0 : FRC.Shell p) → (FRC.Interactions.omega3 ν h).norm = (1 : FRC.Shell p) ∧ (FRC.Interactions.omega3 ν h * FRC.Interactions.omega3 ν h).norm = (1 : FRC.Shell p) :=
  @FRC.Ledger.p28042
