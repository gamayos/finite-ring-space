/-- `adj (c A) = c² adj A`. -/
theorem adj_smul (c : Ext p ν) (A : M3 p ν) : adj (smul c A) = smul (c * c) (adj A) := by
  cases A; exact adj_smul_entry _ _ _ _ _ _ _ _ _ _

