is `1` or `−1`. -/
theorem cycles_meet (hdom : ∀ a b : Shell p, a * b = 0 → a = 0 ∨ b = 0) {w : Ext p ν} (h0 : w.im = 0)
    (hw : Ext.conj w * w = 1) : w.re + -1 = 0 ∨ w.re + 1 = 0 := by
  have e : w.re * w.re + ν * (-w.im * w.im) = 1 := Ext.re_congr hw
