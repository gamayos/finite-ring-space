/-- `adj U · U = det U · I₃`. -/
theorem adj_mul (U : M3 p ν) : mmul (adj U) U = scal (det U) :=
  mext (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7)))) (.var 0)) (.mul (.add (.mul (.var 2) (.var 7)) (.neg (.mul (.var 1) (.var 8)))) (.var 3))) (.mul (.add (.mul (.var 1) (.var 5)) (.neg (.mul (.var 2) (.var 4)))) (.var 6))) (.add (.add (.mul (.var 0) (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7))))) (.neg (.mul (.var 1) (.add (.mul (.var 3) (.var 8)) (.neg (.mul (.var 5) (.var 6))))))) (.mul (.var 2) (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))))) (by decide +kernel))
    (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7)))) (.var 1)) (.mul (.add (.mul (.var 2) (.var 7)) (.neg (.mul (.var 1) (.var 8)))) (.var 4))) (.mul (.add (.mul (.var 1) (.var 5)) (.neg (.mul (.var 2) (.var 4)))) (.var 7))) .zero (by decide +kernel))
    (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7)))) (.var 2)) (.mul (.add (.mul (.var 2) (.var 7)) (.neg (.mul (.var 1) (.var 8)))) (.var 5))) (.mul (.add (.mul (.var 1) (.var 5)) (.neg (.mul (.var 2) (.var 4)))) (.var 8))) .zero (by decide +kernel))
    (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 5) (.var 6)) (.neg (.mul (.var 3) (.var 8)))) (.var 0)) (.mul (.add (.mul (.var 0) (.var 8)) (.neg (.mul (.var 2) (.var 6)))) (.var 3))) (.mul (.add (.mul (.var 2) (.var 3)) (.neg (.mul (.var 0) (.var 5)))) (.var 6))) .zero (by decide +kernel))
    (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 5) (.var 6)) (.neg (.mul (.var 3) (.var 8)))) (.var 1)) (.mul (.add (.mul (.var 0) (.var 8)) (.neg (.mul (.var 2) (.var 6)))) (.var 4))) (.mul (.add (.mul (.var 2) (.var 3)) (.neg (.mul (.var 0) (.var 5)))) (.var 7))) (.add (.add (.mul (.var 0) (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7))))) (.neg (.mul (.var 1) (.add (.mul (.var 3) (.var 8)) (.neg (.mul (.var 5) (.var 6))))))) (.mul (.var 2) (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))))) (by decide +kernel))
    (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 5) (.var 6)) (.neg (.mul (.var 3) (.var 8)))) (.var 2)) (.mul (.add (.mul (.var 0) (.var 8)) (.neg (.mul (.var 2) (.var 6)))) (.var 5))) (.mul (.add (.mul (.var 2) (.var 3)) (.neg (.mul (.var 0) (.var 5)))) (.var 8))) .zero (by decide +kernel))
    (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))) (.var 0)) (.mul (.add (.mul (.var 1) (.var 6)) (.neg (.mul (.var 0) (.var 7)))) (.var 3))) (.mul (.add (.mul (.var 0) (.var 4)) (.neg (.mul (.var 1) (.var 3)))) (.var 6))) .zero (by decide +kernel))
    (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))) (.var 1)) (.mul (.add (.mul (.var 1) (.var 6)) (.neg (.mul (.var 0) (.var 7)))) (.var 4))) (.mul (.add (.mul (.var 0) (.var 4)) (.neg (.mul (.var 1) (.var 3)))) (.var 7))) .zero (by decide +kernel))
    (xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))) (.var 2)) (.mul (.add (.mul (.var 1) (.var 6)) (.neg (.mul (.var 0) (.var 7)))) (.var 5))) (.mul (.add (.mul (.var 0) (.var 4)) (.neg (.mul (.var 1) (.var 3)))) (.var 8))) (.add (.add (.mul (.var 0) (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7))))) (.neg (.mul (.var 1) (.add (.mul (.var 3) (.var 8)) (.neg (.mul (.var 5) (.var 6))))))) (.mul (.var 2) (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))))) (by decide +kernel))

/-- `det (adj U) = (det U)²`. -/
theorem det_adj (U : M3 p ν) : det (adj U) = det U * det U :=
  xsound (xlook (ents U)) (.add (.add (.mul (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7)))) (.add (.mul (.add (.mul (.var 0) (.var 8)) (.neg (.mul (.var 2) (.var 6)))) (.add (.mul (.var 0) (.var 4)) (.neg (.mul (.var 1) (.var 3))))) (.neg (.mul (.add (.mul (.var 2) (.var 3)) (.neg (.mul (.var 0) (.var 5)))) (.add (.mul (.var 1) (.var 6)) (.neg (.mul (.var 0) (.var 7)))))))) (.neg (.mul (.add (.mul (.var 2) (.var 7)) (.neg (.mul (.var 1) (.var 8)))) (.add (.mul (.add (.mul (.var 5) (.var 6)) (.neg (.mul (.var 3) (.var 8)))) (.add (.mul (.var 0) (.var 4)) (.neg (.mul (.var 1) (.var 3))))) (.neg (.mul (.add (.mul (.var 2) (.var 3)) (.neg (.mul (.var 0) (.var 5)))) (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))))))))) (.mul (.add (.mul (.var 1) (.var 5)) (.neg (.mul (.var 2) (.var 4)))) (.add (.mul (.add (.mul (.var 5) (.var 6)) (.neg (.mul (.var 3) (.var 8)))) (.add (.mul (.var 1) (.var 6)) (.neg (.mul (.var 0) (.var 7))))) (.neg (.mul (.add (.mul (.var 0) (.var 8)) (.neg (.mul (.var 2) (.var 6)))) (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6))))))))) (.mul (.add (.add (.mul (.var 0) (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7))))) (.neg (.mul (.var 1) (.add (.mul (.var 3) (.var 8)) (.neg (.mul (.var 5) (.var 6))))))) (.mul (.var 2) (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))))) (.add (.add (.mul (.var 0) (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7))))) (.neg (.mul (.var 1) (.add (.mul (.var 3) (.var 8)) (.neg (.mul (.var 5) (.var 6))))))) (.mul (.var 2) (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6))))))) (by decide +kernel)

/-- **G4, the group of a three-form, by elements.** For every three-form `H` over the extension, the set `SU(H)` of the
`U` with `U† H U = H` and `det U = 1` holds the identity and every scalar `c I₃` with `c̄ c = 1` and `c³ = 1`. It is
closed under the product. Each member's adjugate is a two-sided inverse and a member. The proof never uses `H† = H`, so
it covers the Hermitian forms of the row. -/
theorem su_group (H : M3 p ν) :
    SU H mone ∧
    (∀ c : Ext p ν, Ext.conj c * c = 1 → c ^ 3 = 1 → SU H (scal c)) ∧
    (∀ U V : M3 p ν, SU H U → SU H V → SU H (mmul U V)) ∧
    ∀ U : M3 p ν, SU H U → SU H (adj U) ∧ mmul U (adj U) = mone ∧ mmul (adj U) U = mone := by
  have hone : SU H mone := scal_SU H (by rw [conj_one]; exact Ext.one_mul 1) one_cube
  refine ⟨hone, fun c hu h3 => scal_SU H hu h3, fun U V hU hV => ⟨?_, ?_⟩, fun U hU => ?_⟩
  · rw [sandwich, hU.1, hV.1]
  · rw [det_mul, hU.2, hV.2, Ext.one_mul]
  · have hr : mmul U (adj U) = mone := by rw [mul_adj, hU.2]; rfl
    have hl : mmul (adj U) U = mone := by rw [adj_mul, hU.2]; rfl
    have s := sandwich U (adj U) H
    rw [hr, hU.1, hone.1] at s
    exact ⟨⟨s.symm, by rw [det_adj, hU.2, Ext.one_mul]⟩, hr, hl⟩

/-! ## G4: the rank forced as the minimal triality frame -/

/-- **G4, the rank forced as the minimal triality frame.** Take a shell without zero divisors whose base has no root of
`x² + x + 1` (on the Carrier, B5: p00015), with a half `h + h = 1`. Then `−3` is not a square, and `Ext p (−3)` is the
quadratic extension. It holds a root `ω` of `x² + x + 1`. In every extension `Ext p ν`, each such root lies off the
base, with `ω̄ = ω²`, norm one and `ω̄ ω = 1`. So `ω Iₙ` is unitary for every `n`. Its determinant `ωⁿ` is one exactly
when `3 ∣ n`, with `ω¹ ≠ 1`, `ω² ≠ 1` and `ω³ = 1`. The least rank is therefore three, and `ω I₃` lies in `SU(H)` for
every three-form `H`. -/
theorem triality_frame (hdom : ∀ a b : Shell p, a * b = 0 → a = 0 ∨ b = 0)
    (hno : ¬ ∃ a : Shell p, a * a + a + 1 = 0) {h : Shell p} (hh : h + h = 1) :
    (¬ ∃ s : Shell p, s * s = -3) ∧ (∃ ω : Ext p (-3), ω * ω + ω + 1 = 0) ∧
    ∀ (ν : Shell p) (ω : Ext p ν), ω * ω + ω + 1 = 0 →
      ω.im ≠ 0 ∧ Ext.conj ω = ω * ω ∧ Ext.norm ω = 1 ∧ Ext.conj ω * ω = 1 ∧
      ω ^ 1 ≠ 1 ∧ ω ^ 2 ≠ 1 ∧ ω ^ 3 = 1 ∧ (∀ n : Nat, ω ^ n = 1 ↔ n % 3 = 0) ∧
      ∀ H : M3 p ν, SU H (scal ω) := by
  refine ⟨nonsquare hno hh neg_three, ⟨omega h, omega_root hh neg_three⟩, fun ν ω hω => ?_⟩
  obtain ⟨a, b, c, d, e, f, g, k⟩ := triality_scalar hdom hno hω
  exact ⟨a, b, c, d, e, f, g, k, fun H => scal_SU H d g⟩


/-! ## Hermitian determinants and class functions (27-fields, 16 October 2026)

Frobenius conjugation is a ring map of the extension (`conj_add`, `Ext.conj_mul`, `conj_neg`), so it commutes with
every expression of the normaliser (`conj_xeval`). The determinant of a Hermitian matrix, `A† = A`, is therefore its own
conjugate: `conj (det A) = det (conj-entrywise A) = det (Aᵀ)† … = det A†  = det A`, the middle step the ring identity
`det Aᵀ = det A`. A determinant equal to its conjugate lies in the shell (`im = 0`): the strong-CP angle `arg det M`
vanishes on every shell (27:X11, P9). -/

theorem conj_neg (a : Ext p ν) : Ext.conj (-a) = -Ext.conj a := Ext.ext rfl rfl

/-- Conjugation commutes with the normaliser's evaluation. -/
theorem conj_xeval (env : Nat → Ext p ν) : ∀ e : RE, Ext.conj (xeval env e) = xeval (fun i => Ext.conj (env i)) e
  | .var _ => rfl
  | .zero => conj_zero
  | .one => conj_one
  | .add a b => by
    show Ext.conj (xeval env a + xeval env b) = xeval (fun i => Ext.conj (env i)) a + xeval (fun i => Ext.conj (env i)) b
    rw [conj_add, conj_xeval env a, conj_xeval env b]
  | .mul a b => by
    show Ext.conj (xeval env a * xeval env b) = xeval (fun i => Ext.conj (env i)) a * xeval (fun i => Ext.conj (env i)) b
    rw [Ext.conj_mul, conj_xeval env a, conj_xeval env b]
  | .neg a => by
    show Ext.conj (-(xeval env a)) = -(xeval (fun i => Ext.conj (env i)) a)
    rw [conj_neg, conj_xeval env a]

/-- The determinant of `M3` as an expression of the normaliser, in the nine entries of `ents`. -/
def detRE : RE := .add (.add (.mul (.var 0) (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 5) (.var 7))))) (.neg (.mul (.var 1) (.add (.mul (.var 3) (.var 8)) (.neg (.mul (.var 5) (.var 6))))))) (.mul (.var 2) (.add (.mul (.var 3) (.var 7)) (.neg (.mul (.var 4) (.var 6)))))

/-- The same determinant on the transposed entries (`i ↦ 3 (i mod 3) + i div 3`). -/
def detRE' : RE := .add (.add (.mul (.var 0) (.add (.mul (.var 4) (.var 8)) (.neg (.mul (.var 7) (.var 5))))) (.neg (.mul (.var 3) (.add (.mul (.var 1) (.var 8)) (.neg (.mul (.var 7) (.var 2))))))) (.mul (.var 6) (.add (.mul (.var 1) (.var 5)) (.neg (.mul (.var 4) (.var 2)))))

/-- 27:X11, 27:P9, 00:G7 — the determinant of a Hermitian `3 × 3` matrix over the extension is its own conjugate:
`A† = A` gives `conj (det A) = det A`; its imaginary part is then `2`-torsion (`hermitian_det_shell`), so on every odd
shell `det A` lies in the shell and `arg det A = 0`. -/
theorem hermitian_det_real (A : M3 p ν) (h : dag A = A) : Ext.conj (det A) = det A := by
  have e1 : Ext.conj (det A) = xeval (fun i => Ext.conj (xlook (ents A) i)) detRE := by
    rw [← conj_xeval]; rfl
  have e2 : xeval (fun i => Ext.conj (xlook (ents A) i)) detRE = xeval (fun i => Ext.conj (xlook (ents A) i)) detRE' :=
    xsound _ detRE detRE' (by decide +kernel)
  have e3 : xeval (fun i => Ext.conj (xlook (ents A) i)) detRE' = det (dag A) := rfl
  rw [e1, e2, e3, h]

/-- A conjugation-fixed element of the extension has `2`-torsion imaginary part, `im + im = 0`: on every odd shell it
lies in the shell. -/
theorem im_of_conj_fixed {z : Ext p ν} (h : Ext.conj z = z) : z.im + z.im = 0 := by
  have e : -z.im = z.im := Ext.im_congr h
  have t := Shell.neg_add z.im
  rw [e] at t
  exact t

/-- 27:X11, 27:P9, 00:G7 — the determinant of a Hermitian `3 × 3` matrix has `2`-torsion imaginary part: on every odd shell
it lies in the shell. -/
theorem hermitian_det_shell (A : M3 p ν) (h : dag A = A) : (det A).im + (det A).im = 0 :=
  im_of_conj_fixed (hermitian_det_real A h)

/-- 27:X11, 27:P9, 00:G7 — the square of a Hermitian matrix: `det (A A) = det A · det A`, with `det A` its own conjugate and its
imaginary part `2`-torsion. Where `det A` lies in the shell, `det (A A)` is the square of a residue of the shell. -/
theorem gram_det (A : M3 p ν) (h : dag A = A) :
    det (mmul A A) = det A * det A ∧ Ext.conj (det A) = det A ∧ (det A).im + (det A).im = 0 ∧
    ((det A).im = 0 → (det (mmul A A)).re = (det A).re * (det A).re ∧ (det (mmul A A)).im = 0) := by
  refine ⟨det_mul A A, hermitian_det_real A h, hermitian_det_shell A h, fun h0 => ⟨?_, ?_⟩⟩
  · rw [det_mul, Ext.mul_re, h0]
    exact Shell.Frame.RE.sound (Shell.Frame.look [(det A).re, ν]) (.add (.mul (.var 0) (.var 0)) (.mul (.var 1) (.mul .zero .zero))) (.mul (.var 0) (.var 0)) (by decide +kernel)
  · rw [det_mul, Ext.mul_im, h0]
    exact Shell.Frame.RE.sound (Shell.Frame.look [(det A).re]) (.add (.mul (.var 0) .zero) (.mul .zero (.var 0))) .zero (by decide +kernel)

/-! ### The Wilson term under orientation reversal (27-fields, 17 October 2026) -/

/-- The trace. -/
def tr (A : M3 p ν) : Ext p ν := A.a00 + A.a11 + A.a22

/-- The trace of the conjugate transpose is the conjugate of the trace. -/
theorem tr_dag (A : M3 p ν) : tr (dag A) = Ext.conj (tr A) := by
  show Ext.conj A.a00 + Ext.conj A.a11 + Ext.conj A.a22 = Ext.conj (A.a00 + A.a11 + A.a22)
  rw [conj_add, conj_add]

/-- `I₃ · A = A`. -/
theorem mone_mul (A : M3 p ν) : mmul mone A = A := by
  show mmul (scal 1) A = A
  rw [scal_mul, one_smul]

/-- `A · I₃ = A`. -/
theorem mul_mone (A : M3 p ν) : mmul A mone = A := by
  show mmul A (scal 1) = A
  rw [mul_scal, one_smul]

/-- A unitary matrix of determinant one has its adjugate, its inverse, equal to its conjugate transpose: `U⁻¹ = U†`. -/
theorem adj_eq_dag (U : M3 p ν) (hU : SU mone U) : adj U = dag U := by
  obtain ⟨h1, hd⟩ := hU
  have h1' : mmul (dag U) U = mone := by rw [mul_mone] at h1; exact h1
  calc adj U = mmul mone (adj U) := (mone_mul _).symm
    _ = mmul (mmul (dag U) U) (adj U) := by rw [h1']
    _ = mmul (dag U) (mmul U (adj U)) := mmul_assoc _ _ _
    _ = mmul (dag U) (scal 1) := by rw [mul_adj, hd]
    _ = dag U := by rw [mul_scal, one_smul]

/-- 27:X11, 27:P9, 00:G7 — the Wilson plaquette term `tr U + conj (tr U)`, twice the real part of the trace, is unchanged
when the plaquette's orientation is reversed, `U ↦ U⁻¹`: for `U ∈ SU(3)`, `U⁻¹ = U†` and `tr U† = conj (tr U)`. The term is
orientation-even, so the Wilson action class (the realisation B2) carries no orientation-odd term, no topological term. -/
theorem wilson_orientation_even (U : M3 p ν) (hU : SU mone U) :
    tr (adj U) = Ext.conj (tr U) ∧ tr (adj U) + Ext.conj (tr (adj U)) = tr U + Ext.conj (tr U) := by
  have e : tr (adj U) = Ext.conj (tr U) := by rw [adj_eq_dag U hU, tr_dag]
  refine ⟨e, ?_⟩
  rw [e, Ext.conj_conj, x_add_comm]

/-! ### `2 × 2` matrices over the extension: the weak doublet's frame -/

/-- A `2 × 2` matrix over the extension. -/
structure M2 (p : Nat) [Pos p] (ν : Shell p) where
  a00 : Ext p ν
  a01 : Ext p ν
  a10 : Ext p ν
  a11 : Ext p ν

/-- The product. -/
def mmul2 (A B : M2 p ν) : M2 p ν :=
  ⟨A.a00 * B.a00 + A.a01 * B.a10, A.a00 * B.a01 + A.a01 * B.a11,
   A.a10 * B.a00 + A.a11 * B.a10, A.a10 * B.a01 + A.a11 * B.a11⟩

/-- The conjugate transpose. -/
def dag2 (A : M2 p ν) : M2 p ν := ⟨Ext.conj A.a00, Ext.conj A.a10, Ext.conj A.a01, Ext.conj A.a11⟩

/-- The determinant. -/
def det2 (A : M2 p ν) : Ext p ν := A.a00 * A.a11 + -(A.a01 * A.a10)

/-- The trace. -/
def tr2 (A : M2 p ν) : Ext p ν := A.a00 + A.a11

/-- The adjugate, `g⁻¹` when `det g = 1`. -/
def adj2 (A : M2 p ν) : M2 p ν := ⟨A.a11, -A.a01, -A.a10, A.a00⟩

/-- The four entries in reading order. -/
def ents2 (A : M2 p ν) : List (Ext p ν) := [A.a00, A.a01, A.a10, A.a11]

theorem m2ext {A B : M2 p ν} (h00 : A.a00 = B.a00) (h01 : A.a01 = B.a01) (h10 : A.a10 = B.a10) (h11 : A.a11 = B.a11) :
    A = B := by
  cases A; cases B; cases h00; cases h01; cases h10; cases h11; rfl

/-- `g · adj g = det g · I₂`. -/
theorem mul_adj2 (g : M2 p ν) : mmul2 g (adj2 g) = ⟨det2 g, 0, 0, det2 g⟩ :=
  m2ext
    (xsound (xlook (ents2 g)) (.add (.mul (.var 0) (.var 3)) (.mul (.var 1) (.neg (.var 2)))) (.add (.mul (.var 0) (.var 3)) (.neg (.mul (.var 1) (.var 2)))) (by decide +kernel))
    (xsound (xlook (ents2 g)) (.add (.mul (.var 0) (.neg (.var 1))) (.mul (.var 1) (.var 0))) .zero (by decide +kernel))
    (xsound (xlook (ents2 g)) (.add (.mul (.var 2) (.var 3)) (.mul (.var 3) (.neg (.var 2)))) .zero (by decide +kernel))
