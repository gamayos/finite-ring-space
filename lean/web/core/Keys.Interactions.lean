theorem koide_half {κ : Nat} (hκ : p = 4 * κ + 1) :
    (ofNat (2 * κ + 1) : Shell p) + ofNat (2 * κ + 1) = 1 ∧ (-3 : Shell p) + 1 + 1 + 1 = 0 := by
