/-- p27064 — 27:C21. The integers of the one-loop form on the colour ranks $2$ to $408$: $11m-3\cdot2^{m-1}$ is positive for $m$ from $2$ to $5$ and not positive from $6$ to $408$; $11m-2^{m-1}$ is positive from $2$ to $7$ and not positive from $8$ to $408$. On this range a multiple of three with the first positive is three, and so is an odd multiple of three with the second positive. -/
theorem p27064 : (∀ (k : Nat), k ≤ (402 : Nat) → (11 : Nat) * (k + (6 : Nat)) ≤ (3 : Nat) * (2 : Nat) ^ (k + (5 : Nat))) ∧ (∀ (k : Nat), k ≤ (400 : Nat) → (11 : Nat) * (k + (8 : Nat)) ≤ (2 : Nat) ^ (k + (7 : Nat))) ∧ ((3 : Nat) * (2 : Nat) ^ ((2 : Nat) - (1 : Nat)) < (11 : Nat) * (2 : Nat) ∧ (3 : Nat) * (2 : Nat) ^ ((3 : Nat) - (1 : Nat)) < (11 : Nat) * (3 : Nat) ∧ (3 : Nat) * (2 : Nat) ^ ((4 : Nat) - (1 : Nat)) < (11 : Nat) * (4 : Nat) ∧ (3 : Nat) * (2 : Nat) ^ ((5 : Nat) - (1 : Nat)) < (11 : Nat) * (5 : Nat)) ∧ ((2 : Nat) ^ ((2 : Nat) - (1 : Nat)) < (11 : Nat) * (2 : Nat) ∧ (2 : Nat) ^ ((3 : Nat) - (1 : Nat)) < (11 : Nat) * (3 : Nat) ∧ (2 : Nat) ^ ((4 : Nat) - (1 : Nat)) < (11 : Nat) * (4 : Nat) ∧ (2 : Nat) ^ ((5 : Nat) - (1 : Nat)) < (11 : Nat) * (5 : Nat) ∧ (2 : Nat) ^ ((6 : Nat) - (1 : Nat)) < (11 : Nat) * (6 : Nat) ∧ (2 : Nat) ^ ((7 : Nat) - (1 : Nat)) < (11 : Nat) * (7 : Nat)) ∧ (∀ (m : Nat), (6 : Nat) ≤ m → m ≤ (408 : Nat) → ¬(3 : Nat) * (2 : Nat) ^ (m - (1 : Nat)) < (11 : Nat) * m) ∧ (∀ (m : Nat), (8 : Nat) ≤ m → m ≤ (408 : Nat) → ¬(2 : Nat) ^ (m - (1 : Nat)) < (11 : Nat) * m) ∧ (∀ (m : Nat), (0 : Nat) < m → m ≤ (408 : Nat) → m % (3 : Nat) = (0 : Nat) → (3 : Nat) * (2 : Nat) ^ (m - (1 : Nat)) < (11 : Nat) * m → m = (3 : Nat)) ∧ ∀ (m : Nat), (0 : Nat) < m → m ≤ (408 : Nat) → m % (3 : Nat) = (0 : Nat) → m % (2 : Nat) = (1 : Nat) → (2 : Nat) ^ (m - (1 : Nat)) < (11 : Nat) * m → m = (3 : Nat) :=
