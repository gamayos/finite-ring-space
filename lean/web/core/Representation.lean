          have hβ' : β' = 0 := by rw [hb', h0, zero_mul]
          exact h2.elim (fun h => h hα') (fun h => h hβ')
        refine ⟨α' * s, hμ, M2.ext' ?_ ?_ ?_ ?_⟩
        · show α' = α' * s * α; rw [mul_assoc, mul_comm s, hs, mul_one]
        · show ν * β' = α' * s * (ν * β); rw [hb', mul_left_comm]
        · show β' = α' * s * β; exact hb'
