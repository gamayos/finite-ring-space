def decideAllRelations {M : Type*} [Fintype M] [DecidableEq M] (k : ℕ) (P : Finset (Fin k → M) → Prop)
    [DecidablePred P] : Decidable (∀ R, P R) := FRC.Logic.decideAllRelations k P
