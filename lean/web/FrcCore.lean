/-! #### The frame invariants (13:I5) -/

/-- The Fermat quotient of `4` at `p`: `(4^{p−1} − 1)/p mod p`. -/
def fermatQuotient4 (p : Nat) : Nat := ((4 ^ (p - 1) % (p * p) + p * p - 1) / p) % p

