namespace FRC.Diagonal

open FRC.Logic FRC.Reach

/-! ### 25:F1, 25:F3 — mention cost: truth depends only on variables that occur -/

/-- Terms with variables (de Bruijn indices) over the signature of `M_p`. -/
inductive VTm where
  | var : Nat → VTm
  | zero : VTm
  | one : VTm
  | add : VTm → VTm → VTm
  | mul : VTm → VTm → VTm

/-- First-order formulas: equations, negation, conjunction, and the quantifier over the whole structure
(the bound variable is variable `0` of the body, the others shift up). -/
inductive Fm where
  | eq : VTm → VTm → Fm
  | neg : Fm → Fm
  | conj : Fm → Fm → Fm
  | all : Fm → Fm

/-- The value of a term in `M_p` under an assignment. -/
def tval (p : Nat) (env : Nat → Nat) : VTm → Nat
  | .var i => env i
  | .zero => 0
  | .one => 1 % p
  | .add s t => (tval p env s + tval p env t) % p
  | .mul s t => (tval p env s * tval p env t) % p

/-- Truth in `M_p` under an assignment: the quantifier ranges over the `p` elements. -/
def holds (p : Nat) (env : Nat → Nat) : Fm → Bool
  | .eq s t => decide (tval p env s = tval p env t)
  | .neg φ => !(holds p env φ)
  | .conj φ ψ => holds p env φ && holds p env ψ
  | .all φ => allBelow (fun x => holds p (cons x env) φ) p

/-- Variable `i` occurs in the term. -/
def occT (i : Nat) : VTm → Bool
  | .var j => decide (j = i)
  | .zero => false
  | .one => false
  | .add s t => occT i s || occT i t
  | .mul s t => occT i s || occT i t

/-- Variable `i` occurs free in the formula. -/
def occ (i : Nat) : Fm → Bool
  | .eq s t => occT i s || occT i t
  | .neg φ => occ i φ
  | .conj φ ψ => occ i φ || occ i ψ
  | .all φ => occ (i + 1) φ

/-- The length of a term, in symbols. -/
def tsize : VTm → Nat
  | .var _ => 1
  | .zero => 1
  | .one => 1
  | .add s t => tsize s + tsize t + 1
  | .mul s t => tsize s + tsize t + 1

/-- The length of a formula, in symbols. -/
def size : Fm → Nat
  | .eq s t => tsize s + tsize t + 1
  | .neg φ => size φ + 1
  | .conj φ ψ => size φ + size ψ + 1
  | .all φ => size φ + 1

theorem tval_congr (p : Nat) {env env' : Nat → Nat} :
    ∀ t : VTm, (∀ i, occT i t = true → env i = env' i) → tval p env t = tval p env' t
  | .var j, h => h j (decide_eq_true rfl)
  | .zero, _ => rfl
  | .one, _ => rfl
  | .add s t, h => by
    show (tval p env s + tval p env t) % p = (tval p env' s + tval p env' t) % p
    rw [tval_congr p s (fun i hi => h i (or_intro_left hi)), tval_congr p t (fun i hi => h i (or_intro_right hi))]
  | .mul s t, h => by
    show (tval p env s * tval p env t) % p = (tval p env' s * tval p env' t) % p
    rw [tval_congr p s (fun i hi => h i (or_intro_left hi)), tval_congr p t (fun i hi => h i (or_intro_right hi))]

/-- 25:F1 (Lemma mention, the coincidence form) — two assignments that agree on the variables occurring free in
a formula give it the same truth value in `M_p`. -/
theorem holds_congr (p : Nat) : ∀ (φ : Fm) {env env' : Nat → Nat},
    (∀ i, occ i φ = true → env i = env' i) → holds p env φ = holds p env' φ
  | .eq s t, env, env', h => by
    show decide (tval p env s = tval p env t) = decide (tval p env' s = tval p env' t)
    rw [tval_congr p s (fun i hi => h i (or_intro_left hi)), tval_congr p t (fun i hi => h i (or_intro_right hi))]
  | .neg φ, env, env', h => by
    show (!(holds p env φ)) = (!(holds p env' φ))
    rw [holds_congr p φ h]
  | .conj φ ψ, env, env', h => by
    show (holds p env φ && holds p env ψ) = (holds p env' φ && holds p env' ψ)
    rw [holds_congr p φ (fun i hi => h i (or_intro_left hi)), holds_congr p ψ (fun i hi => h i (or_intro_right hi))]
  | .all φ, env, env', h => by
    show allBelow (fun x => holds p (cons x env) φ) p = allBelow (fun x => holds p (cons x env') φ) p
    exact allBelow_congr (fun x _ => holds_congr p φ (fun i hi =>
      match i, hi with
      | 0, _ => rfl
      | j + 1, hj => h j hj))

/-- The assignment changed at one coordinate. -/
def upd (env : Nat → Nat) (i v : Nat) : Nat → Nat := fun j => if j = i then v else env j

/-- 25:F1 (Lemma mention) — if the truth of a formula in `M_p` depends on coordinate `i` (reassigning it changes
the truth value), then variable `i` occurs in the formula. -/
theorem mention (p : Nat) (φ : Fm) (env : Nat → Nat) (i v : Nat)
    (hdep : holds p (upd env i v) φ ≠ holds p env φ) : occ i φ = true :=
  match h : occ i φ with
  | true => rfl
  | false => absurd (holds_congr p φ (fun j hj =>
      match Nat.decEq j i with
      | isTrue e => Bool.noConfusion ((e ▸ hj : occ i φ = true).symm.trans h)
      | isFalse e => (ite_eq_right e : (if j = i then v else env j) = env j))) hdep

/-! #### counting the coordinates a formula can read -/

theorem tcount_le : ∀ (t : VTm) (N : Nat), count (fun i => occT i t) N ≤ tsize t
  | .var j, N => (count_single j N).1
  | .zero, N => by show count (fun _ => false) N ≤ 1; rw [count_false N]; exact Nat.zero_le 1
  | .one, N => by show count (fun _ => false) N ≤ 1; rw [count_false N]; exact Nat.zero_le 1
  | .add s t, N =>
    Nat.le_trans (count_or_le (fun i => occT i s) (fun i => occT i t) N)
      (Nat.le_succ_of_le (Nat.add_le_add (tcount_le s N) (tcount_le t N)))
  | .mul s t, N =>
    Nat.le_trans (count_or_le (fun i => occT i s) (fun i => occT i t) N)
      (Nat.le_succ_of_le (Nat.add_le_add (tcount_le s N) (tcount_le t N)))

theorem fcount_le : ∀ (φ : Fm) (N : Nat), count (fun i => occ i φ) N ≤ size φ
  | .eq s t, N =>
    Nat.le_trans (count_or_le (fun i => occT i s) (fun i => occT i t) N)
      (Nat.le_succ_of_le (Nat.add_le_add (tcount_le s N) (tcount_le t N)))
  | .neg φ, N => Nat.le_succ_of_le (fcount_le φ N)
  | .conj φ ψ, N =>
    Nat.le_trans (count_or_le (fun i => occ i φ) (fun i => occ i ψ) N)
      (Nat.le_succ_of_le (Nat.add_le_add (fcount_le φ N) (fcount_le ψ N)))
  | .all φ, N =>
    Nat.le_succ_of_le (Nat.le_trans (count_shift (fun i => occ i φ) N) (fcount_le φ (N + 1)))

/-- 25:F1 (Lemma mention, the arity) — a formula in which the `N` variables `0, …, N − 1` occur has length at
least `N`. -/
theorem arity_le_size (φ : Fm) (N : Nat) (h : ∀ i, i < N → occ i φ = true) : N ≤ size φ :=
  (count_full h) ▸ fcount_le φ N

/-- 25:F1, 25:F2, 00:Z9 (Lemma mention, the cost) — a formula whose truth in `M_p` depends on all `N` coordinates of a
tuple (the variables `0, …, N − 1`) has length at least `N`. -/
theorem mention_cost (p : Nat) (φ : Fm) (N : Nat)
    (h : ∀ i, i < N → ∃ env v, holds p (upd env i v) φ ≠ holds p env φ) : N ≤ size φ :=
  arity_le_size φ N (fun i hi => match h i hi with
    | ⟨env, v, hdep⟩ => mention p φ env i v hdep)

theorem fcount_lt : ∀ (φ : Fm) (N : Nat), count (fun i => occ i φ) N < size φ
  | .eq s t, N =>
    Nat.lt_succ_of_le (Nat.le_trans (count_or_le (fun i => occT i s) (fun i => occT i t) N)
      (Nat.add_le_add (tcount_le s N) (tcount_le t N)))
  | .neg φ, N => Nat.lt_succ_of_lt (fcount_lt φ N)
  | .conj φ ψ, N =>
    Nat.lt_succ_of_le (Nat.le_trans (count_or_le (fun i => occ i φ) (fun i => occ i ψ) N)
      (Nat.add_le_add (Nat.le_of_lt (fcount_lt φ N)) (Nat.le_of_lt (fcount_lt ψ N))))
  | .all φ, N =>
    Nat.lt_succ_of_lt (Nat.lt_of_le_of_lt (count_shift (fun i => occ i φ) N) (fcount_lt φ (N + 1)))

/-- 25:F3, 25:G6 (Corollary quotation, the arity) — a formula in which the `N` variables `j, …, j + N − 1` occur has more
than `N` symbols: a formula's arity is below its length. -/
theorem arity_lt_size (φ : Fm) (j N : Nat) (h : ∀ i, i < N → occ (i + j) φ = true) : N < size φ :=
  have h1 : count (fun i => occ (i + j) φ) N = N := count_full h
  Nat.lt_of_le_of_lt (Nat.le_trans (Nat.le_of_eq h1.symm) (count_shift_by j (fun i => occ i φ) N)) (fcount_lt φ (N + j))

/-- 25:F3, 25:G6 (Corollary quotation, the cost) — a formula whose truth in `M_p` depends on all `N` coordinates of a
tuple, the variables `j, …, j + N − 1`, has more than `N` symbols. -/
theorem mention_cost_lt (p : Nat) (φ : Fm) (j N : Nat)
    (h : ∀ i, i < N → ∃ env v, holds p (upd env (i + j) v) φ ≠ holds p env φ) : N < size φ :=
  arity_lt_size φ j N (fun i hi => match h i hi with
    | ⟨env, v, hdep⟩ => mention p φ env (i + j) v hdep)

/-- `Subformula ψ φ`: `ψ` is a subformula of `φ`. -/
inductive Subformula (ψ : Fm) : Fm → Prop where
  | refl : Subformula ψ ψ
  | neg {φ : Fm} : Subformula ψ φ → Subformula ψ (.neg φ)
  | conjL {φ χ : Fm} : Subformula ψ φ → Subformula ψ (.conj φ χ)
  | conjR {φ χ : Fm} : Subformula ψ χ → Subformula ψ (.conj φ χ)
  | all {φ : Fm} : Subformula ψ φ → Subformula ψ (.all φ)

theorem sub_size {ψ : Fm} : ∀ {φ : Fm}, Subformula ψ φ → size ψ ≤ size φ
  | _, .refl => Nat.le_refl _
  | _, .neg h => Nat.le_succ_of_le (sub_size h)
  | .conj φ χ, .conjL h => Nat.le_succ_of_le (Nat.le_trans (sub_size h) (Nat.le_add_right (size φ) (size χ)))
  | .conj φ χ, .conjR h => Nat.le_succ_of_le (Nat.le_trans (sub_size h) (Nat.le_add_left (size χ) (size φ)))
  | _, .all h => Nat.le_succ_of_le (sub_size h)

/-- 25:F3, 25:G6, 25:G7, 00:Z9 (Corollary quotation) — no sentence `lam` contains a subformula whose truth depends on all coordinates
of a tuple of arity `N ≥ |lam|`, wherever the tuple's variables `j, …, j + N − 1` sit in the subformula's frame:
the subformula would have more than `N` symbols, and it is no longer than `lam`. -/
theorem no_self_reading (p : Nat) {ψ lam : Fm} (hsub : Subformula ψ lam) (j N : Nat) (hN : size lam ≤ N) :
    ¬ ∀ i, i < N → ∃ env v, holds p (upd env (i + j) v) ψ ≠ holds p env ψ := fun h =>
  Nat.lt_irrefl N (Nat.lt_of_lt_of_le (mention_cost_lt p ψ j N h) (Nat.le_trans (sub_size hsub) hN))

/-! ### 25:F2 — the diagonal template does not fit at any scale -/

/-- `∃ x, φ`, written with the language's one quantifier: `¬ ∀ x, ¬ φ`. -/
def ex (φ : Fm) : Fm := .neg (.all (.neg φ))

/-- A block of `n` existential quantifiers in front of a formula. -/
def exBlock : Nat → Fm → Fm
  | 0, φ => φ
  | n + 1, φ => ex (exBlock n φ)

/-- 25:F1 (Lemma mention, the quantifier block) — a block binding an `n`-tuple contributes `3n` symbols in this
syntax, at least `n`. -/
theorem size_exBlock : ∀ (n : Nat) (φ : Fm), size (exBlock n φ) = size φ + 3 * n
  | 0, _ => rfl
  | n + 1, φ => by
    show size (exBlock n φ) + 1 + 1 + 1 = size φ + 3 * (n + 1)
    rw [size_exBlock n φ, Nat.mul_succ]; rfl

/-- 25:F2, 25:G7, 00:Z9 (Theorem nocompress, the accounting) — the diagonal formula `δ = ∃ v (Diag_N ∧ θ)`, with a block of `N`
quantifiers and a diagonal relation whose truth depends on all `2N` coordinates, has length at least
`2N + |θ| + 3N`: `2N` for the relation (mention cost), then `θ`, and three symbols for each quantifier of the
block (the paper counts one, which gives its `3N + |θ|`). -/
theorem template_size (p N : Nat) (diag θ : Fm)
    (hdep : ∀ i, i < 2 * N → ∃ env v, holds p (upd env i v) diag ≠ holds p env diag) :
    2 * N + size θ + 3 * N ≤ size (exBlock N (.conj diag θ)) := by
  have h2 : 2 * N ≤ size diag := mention_cost p diag (2 * N) hdep
  rw [size_exBlock]
  show 2 * N + size θ + 3 * N ≤ size diag + size θ + 1 + 3 * N
  exact Nat.add_le_add_right (Nat.le_trans (Nat.add_le_add_right h2 (size θ)) (Nat.le_succ _)) (3 * N)

/-- 25:F2, 00:Z9 (Theorem nocompress, the scale) — a formula that binds an `N`-tuple, `N ≥ 1`, is longer than `N`: the
diagonal formula `∃ v (Diag_N ∧ θ)` has no code in `M^N`.  The block alone gives this clause; no hypothesis on
`Diag_N` or `θ` enters. -/
theorem no_template (N : Nat) (hN : 1 ≤ N) (φ : Fm) : ¬ size (exBlock N φ) ≤ N := fun hle => by
  rw [size_exBlock] at hle
  have h3 : 3 * N ≤ N := Nat.le_trans (Nat.le_add_left (3 * N) (size φ)) hle
  have h4 : N + 1 ≤ 3 * N := by
    have : N + N ≤ 3 * N := by rw [← Nat.two_mul]; exact Nat.mul_le_mul_right N (by decide)
    exact Nat.le_trans (Nat.add_le_add_left hN N) this
  exact Nat.not_succ_le_self N (Nat.le_trans h4 h3)

/-- 25:F2, 00:Z9 (Theorem nocompress, splitting the scales) — if `θ` reads all `N₂` coordinates of its argument (the
non-degeneracy clause, at the scale `N₂` of the code of the fixed point), the diagonal formula is longer than
`N₂`, whatever the scale `N` of its own block: here the mention cost is what excludes the instance. -/
theorem split_scale (p N N₂ : Nat) (diag θ : Fm)
    (hθ : ∀ i, i < N₂ → ∃ env v, holds p (upd env i v) θ ≠ holds p env θ) :
    N₂ < size (exBlock N (.conj diag θ)) := by
  have h : N₂ ≤ size θ := mention_cost p θ N₂ hθ
  rw [size_exBlock]
  show N₂ < size diag + size θ + 1 + 3 * N
  exact Nat.lt_of_le_of_lt h (Nat.lt_of_lt_of_le (Nat.lt_succ_of_le (Nat.le_add_left (size θ) (size diag))) (Nat.le_add_right _ (3 * N)))

/-! ### 25:F4 — density does not rescue the template -/

/-! ### 25:G4 — the prefix simulation -/

/-- The coded prefix evaluated directly over a structure of `m` elements: `true` codes `∀`, `false` codes `∃`;
the matrix `ψ` reads the chosen values (the last chosen first). -/
def direct (m : Nat) (ψ : List Nat → Bool) : List Bool → List Nat → Bool
  | [], acc => ψ acc
  | true :: pat, acc => allBelow (fun x => direct m ψ pat (x :: acc)) m
  | false :: pat, acc => anyBelow (fun x => direct m ψ pat (x :: acc)) m

/-- The uniform prefix `∀ y₁ ∃ x₁ … ∀ y_d ∃ x_d` with the clause `x_i = y_i` conjoined at the coded universal
positions and the matrix read on the `x`s; `c` carries the clauses collected so far. -/
def paired (m : Nat) (ψ : List Nat → Bool) : List Bool → List Nat → Bool → Bool
  | [], acc, c => c && ψ acc
  | q :: pat, acc, c =>
    allBelow (fun y => anyBelow (fun x => paired m ψ pat (x :: acc) (c && (!q || decide (x = y)))) m) m

/-- 25:G4 (Lemma prefix) — the prefix simulation: over a structure of `m ≥ 1` elements the uniform pairing
prefix with the copy clauses decides exactly what the coded prefix `Q₁ … Q_d` decides, for every pattern and
every matrix. -/
theorem prefix_simulation (m : Nat) (hm : 0 < m) (ψ : List Nat → Bool) :
    ∀ (pat : List Bool) (acc : List Nat) (c : Bool), paired m ψ pat acc c = (c && direct m ψ pat acc)
  | [], _, _ => rfl
  | true :: pat, acc, c => by
    show allBelow (fun y => anyBelow (fun x => paired m ψ pat (x :: acc) (c && (!true || decide (x = y)))) m) m
        = (c && allBelow (fun x => direct m ψ pat (x :: acc)) m)
    rw [← allBelow_and_const c (fun x => direct m ψ pat (x :: acc)) m hm]
    refine allBelow_congr (fun y hy => ?_)
    have h1 : anyBelow (fun x => paired m ψ pat (x :: acc) (c && (!true || decide (x = y)))) m
        = anyBelow (fun x => (c && decide (x = y)) && direct m ψ pat (x :: acc)) m :=
      anyBelow_congr (fun x _ => prefix_simulation m hm ψ pat (x :: acc) (c && decide (x = y)))
    rw [h1, anyBelow_pick c (fun x => direct m ψ pat (x :: acc)) y m, ite_eq_left hy]
  | false :: pat, acc, c => by
    show allBelow (fun y => anyBelow (fun x => paired m ψ pat (x :: acc) (c && (!false || decide (x = y)))) m) m
        = (c && anyBelow (fun x => direct m ψ pat (x :: acc)) m)
    have h1 : ∀ y, anyBelow (fun x => paired m ψ pat (x :: acc) (c && (!false || decide (x = y)))) m
        = (c && anyBelow (fun x => direct m ψ pat (x :: acc)) m) := fun y => by
      rw [← anyBelow_and_const c (fun x => direct m ψ pat (x :: acc)) m]
      refine anyBelow_congr (fun x _ => ?_)
      have h2 : paired m ψ pat (x :: acc) (c && (!false || decide (x = y))) = ((c && true) && direct m ψ pat (x :: acc)) :=
        prefix_simulation m hm ψ pat (x :: acc) (c && true)
      rw [and_true' c] at h2
      exact h2
    rw [allBelow_congr (fun y _ => h1 y)]
    exact allBelow_const _ m hm

/-- 25:G4 (Lemma prefix, the statement) — with no clause collected, the pairing prefix equals the coded prefix. -/
theorem prefix_simulation_closed (m : Nat) (hm : 0 < m) (ψ : List Nat → Bool) (pat : List Bool) :
    paired m ψ pat [] true = direct m ψ pat [] :=
  prefix_simulation m hm ψ pat [] true

/-! ### 25:F7 — the decoders: `Int_J(x)` defines `{0, …, 2^J − 1}` -/

/-- `φ ∨ ψ`, with the language's connectives: `¬(¬φ ∧ ¬ψ)`. -/
def orF (φ ψ : Fm) : Fm := .neg (.conj (.neg φ) (.neg ψ))

theorem holds_conj_iff (p : Nat) (env : Nat → Nat) (φ ψ : Fm) :
    holds p env (.conj φ ψ) = true ↔ holds p env φ = true ∧ holds p env ψ = true :=
  ⟨fun h => ⟨band_l h, band_r h⟩, fun ⟨h1, h2⟩ => by show (holds p env φ && holds p env ψ) = true; rw [h1, h2]; rfl⟩

theorem holds_orF_iff (p : Nat) (env : Nat → Nat) (φ ψ : Fm) :
    holds p env (orF φ ψ) = true ↔ holds p env φ = true ∨ holds p env ψ = true := by
  show (!(!(holds p env φ) && !(holds p env ψ))) = true ↔ _
  match holds p env φ, holds p env ψ with
  | true, _ => exact ⟨fun _ => .inl rfl, fun _ => rfl⟩
  | false, true => exact ⟨fun _ => .inr rfl, fun _ => rfl⟩
  | false, false => exact ⟨fun h => Bool.noConfusion h, fun h => match h with | .inl e => Bool.noConfusion e | .inr e => Bool.noConfusion e⟩

theorem not_allBelow_not (f : Nat → Bool) : ∀ n, (!(allBelow (fun y => !(f y)) n)) = anyBelow f n
  | 0 => rfl
  | n + 1 => by
    show (!((!(f n)) && allBelow (fun y => !(f y)) n)) = (f n || anyBelow f n)
    rw [← not_allBelow_not f n]
    cases f n <;> cases allBelow (fun y => !(f y)) n <;> rfl

theorem holds_ex_iff (p : Nat) (env : Nat → Nat) (φ : Fm) :
    holds p env (ex φ) = true ↔ ∃ y, y < p ∧ holds p (cons y env) φ = true := by
  show (!(allBelow (fun y => !(holds p (cons y env) φ)) p)) = true ↔ _
  rw [not_allBelow_not]
  exact anyBelow_true_iff _ p

theorem holds_eq_iff (p : Nat) (env : Nat → Nat) (s t : VTm) :
    holds p env (.eq s t) = true ↔ tval p env s = tval p env t :=
  ⟨of_decide_eq_true, decide_eq_true⟩

/-- `seg_J(x, w)`: `x ∈ {0, w, 2w, …, (2^J − 1) w}` in `M_p`, written with two reused bound variables per level:
`seg_0(x, w) := x = 0`; `seg_{J+1}(x, w) := ∃ y ((x = y ∨ x = y + w) ∧ ∃ w' (w' = w + w ∧ seg_J(y, w')))`. The arguments
are variable indices; under each quantifier the outer variables shift up by one. -/
def seg : Nat → Nat → Nat → Fm
  | 0, x, _ => .eq (.var x) .zero
  | J + 1, x, w =>
    ex (.conj (orF (.eq (.var (x + 1)) (.var 0)) (.eq (.var (x + 1)) (.add (.var 0) (.var (w + 1)))))
      (ex (.conj (.eq (.var 0) (.add (.var (w + 2)) (.var (w + 2)))) (seg J 1 0))))

/-- `Int_J(x) := ∃ w (w = 1 ∧ seg_J(x, w))`. -/
def IntJ (J x : Nat) : Fm := ex (.conj (.eq (.var 0) .one) (seg J (x + 1) 0))

/-- The values `seg_J(·, w)` admits, in the arithmetic of `M_p`: the multiples `c·w mod p` for `c < 2^J`, built level by
level. -/
def InSeg (p : Nat) : Nat → Nat → Nat → Prop
  | 0, _, x => x = 0
  | J + 1, w, x => ∃ y, y < p ∧ InSeg p J ((w + w) % p) y ∧ (x = y ∨ x = (y + w) % p)

/-- 25:F7 (Lemma decoders, the semantics of `seg`) — `seg_J(x, w)` holds exactly when `x` is among the values the levels
admit. -/
theorem holds_seg_iff (p : Nat) : ∀ (J : Nat) (env : Nat → Nat) (x w : Nat),
    holds p env (seg J x w) = true ↔ InSeg p J (env w) (env x)
  | 0, env, x, w => by
    show decide (env x = 0) = true ↔ env x = 0
    exact ⟨of_decide_eq_true, decide_eq_true⟩
  | J + 1, env, x, w => by
    show holds p env (ex (.conj (orF (.eq (.var (x + 1)) (.var 0)) (.eq (.var (x + 1)) (.add (.var 0) (.var (w + 1)))))
      (ex (.conj (.eq (.var 0) (.add (.var (w + 2)) (.var (w + 2)))) (seg J 1 0))))) = true
      ↔ ∃ y, y < p ∧ InSeg p J ((env w + env w) % p) y ∧ (env x = y ∨ env x = (y + env w) % p)
    refine (holds_ex_iff p env _).trans ⟨?_, ?_⟩
    · intro ⟨y, hy, h⟩
      have h' := (holds_conj_iff _ _ _ _).1 h
      have hor := (holds_orF_iff _ _ _ _).1 h'.1
      have hin := (holds_ex_iff _ _ _).1 h'.2
      match hin with
      | ⟨w', hw', h2⟩ =>
        have h2' := (holds_conj_iff _ _ _ _).1 h2
        have ew' : w' = (env w + env w) % p := (holds_eq_iff _ _ _ _).1 h2'.1
        have hseg := (holds_seg_iff p J (cons w' (cons y env)) 1 0).1 h2'.2
        -- cons w' (cons y env) reads 0 ↦ w', 1 ↦ y
        have hseg' : InSeg p J ((env w + env w) % p) y := by
          have e : InSeg p J (cons w' (cons y env) 0) (cons w' (cons y env) 1) = InSeg p J w' y := rfl
          rw [e, ew'] at hseg; exact hseg
        refine ⟨y, hy, hseg', ?_⟩
        match hor with
        | .inl e => exact .inl ((holds_eq_iff _ _ _ _).1 e)
        | .inr e => exact .inr ((holds_eq_iff _ _ _ _).1 e)
    · intro ⟨y, hy, hseg, hor⟩
      refine ⟨y, hy, (holds_conj_iff _ _ _ _).2 ⟨(holds_orF_iff _ _ _ _).2 ?_, (holds_ex_iff _ _ _).2
        ⟨(env w + env w) % p, FRC.Nat.mod_lt' _ (Nat.lt_of_le_of_lt (Nat.zero_le _) hy),
          (holds_conj_iff _ _ _ _).2 ⟨(holds_eq_iff _ _ _ _).2 rfl, (holds_seg_iff p J _ 1 0).2 hseg⟩⟩⟩⟩
      match hor with
      | .inl e => exact .inl ((holds_eq_iff _ _ _ _).2 e)
      | .inr e => exact .inr ((holds_eq_iff _ _ _ _).2 e)

/-- Every natural is `2c' + r` with `r < 2`, by induction (no division). -/
theorem half_decomp : ∀ c : Nat, ∃ c' r, r < 2 ∧ c = 2 * c' + r
  | 0 => ⟨0, 0, Nat.zero_lt_two, rfl⟩
  | c + 1 =>
    match half_decomp c with
    | ⟨c', 0, _, e⟩ => ⟨c', 1, Nat.lt_succ_self 1, by rw [e]⟩
    | ⟨c', 1, _, e⟩ => ⟨c' + 1, 0, Nat.zero_lt_two, by rw [e, Nat.mul_succ]⟩
    | ⟨_, r + 2, hr, _⟩ => absurd hr (Nat.not_lt_of_ge (Nat.le_add_left 2 r))

theorem lt_of_two_mul_lt {a b : Nat} (h : 2 * a < 2 * b) : a < b :=
  Nat.lt_of_not_ge (fun hge => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h (Nat.mul_le_mul_left 2 hge)))

/-- 25:F7 (Lemma decoders, the arithmetic of the levels) — the values `seg_J(·, w)` admits are exactly the multiples
`c·w mod p` with `c < 2^J`. -/
theorem inSeg_iff (p : Nat) (hp : 0 < p) : ∀ (J w x : Nat), InSeg p J w x ↔ ∃ c, c < 2 ^ J ∧ x = (c * w) % p
  | 0, w, x => by
    show x = 0 ↔ ∃ c, c < 2 ^ 0 ∧ x = (c * w) % p
    exact ⟨fun e => ⟨0, Nat.lt_succ_self 0, by rw [e, Nat.zero_mul]; rfl⟩,
      fun ⟨c, hc, e⟩ => by
        have e0 : c = 0 := Nat.le_zero.1 (Nat.le_of_lt_succ hc)
        rw [e, e0, Nat.zero_mul]; rfl⟩
  | J + 1, w, x => by
    show (∃ y, y < p ∧ InSeg p J ((w + w) % p) y ∧ (x = y ∨ x = (y + w) % p)) ↔ ∃ c, c < 2 ^ (J + 1) ∧ x = (c * w) % p
    have key : ∀ c', (c' * ((w + w) % p)) % p = (2 * c' * w) % p := fun c' => by
      rw [FRC.Nat.mul_mod_mod _ _ _ hp, ← Nat.two_mul, FRC.Nat.mul_left_comm, ← FRC.Nat.mul_assoc]
    constructor
    · intro ⟨y, _, hy, hor⟩
      match (inSeg_iff p hp J _ y).1 hy with
      | ⟨c', hc', ey⟩ =>
        rw [key c'] at ey
        have hc'2 : 2 * c' < 2 * 2 ^ J := Nat.mul_lt_mul_of_pos_left hc' Nat.zero_lt_two
        match hor with
        | .inl e => exact ⟨2 * c', by rw [Nat.pow_succ, Nat.mul_comm (2 ^ J) 2]; exact hc'2, e.trans ey⟩
        | .inr e =>
          have h21 : 2 * c' + 1 < 2 * 2 ^ J := by
            have : 2 * (c' + 1) ≤ 2 * 2 ^ J := Nat.mul_le_mul_left 2 (Nat.succ_le_of_lt hc')
            rw [Nat.mul_succ] at this
            exact Nat.lt_of_lt_of_le (Nat.lt_succ_self _) this
          exact ⟨2 * c' + 1, by rw [Nat.pow_succ, Nat.mul_comm (2 ^ J) 2]; exact h21,
            by rw [e, ey, FRC.Nat.mod_add_mod _ _ _ hp, FRC.Nat.add_mul, Nat.one_mul]⟩
    · intro ⟨c, hc, ex⟩
      match half_decomp c with
      | ⟨c', r, hr, ec⟩ =>
        have hc' : c' < 2 ^ J := by
          have : 2 * c' < 2 * 2 ^ J := by
            rw [Nat.pow_succ, Nat.mul_comm (2 ^ J) 2] at hc
            exact Nat.lt_of_le_of_lt (Nat.le_add_right _ r) (ec ▸ hc)
          exact lt_of_two_mul_lt this
        refine ⟨(c' * ((w + w) % p)) % p, FRC.Nat.mod_lt' _ hp, (inSeg_iff p hp J _ _).2 ⟨c', hc', rfl⟩, ?_⟩
        rw [key c', ex, ec]
        match r, hr with
        | 0, _ => exact .inl (by rw [Nat.add_zero])
        | 1, _ => exact .inr (by rw [FRC.Nat.mod_add_mod _ _ _ hp, FRC.Nat.add_mul, Nat.one_mul])
        | r + 2, hr => exact absurd hr (Nat.not_lt_of_ge (Nat.le_add_left 2 r))

/-- 25:F7 (Lemma decoders) — over `M_p` with `2^J ≤ p`, `Int_J(x)` holds exactly when `x < 2^J`: the formula defines
`{0, …, 2^J − 1}` by writing the binary expansion along `J` doublings of the unit. -/
theorem intJ_defines (p : Nat) (hp : 2 ≤ p) (J : Nat) (hJ : 2 ^ J ≤ p) (env : Nat → Nat) (x : Nat) (hx : env x < p) :
    holds p env (IntJ J x) = true ↔ env x < 2 ^ J := by
  have hp0 : 0 < p := Nat.lt_of_lt_of_le Nat.zero_lt_two hp
  show holds p env (ex (.conj (.eq (.var 0) .one) (seg J (x + 1) 0))) = true ↔ _
  refine (holds_ex_iff p env _).trans ⟨?_, ?_⟩
  · intro ⟨w, _, h⟩
    have h' := (holds_conj_iff _ _ _ _).1 h
    have ew : w = 1 % p := (holds_eq_iff _ _ _ _).1 h'.1
    rw [FRC.Nat.mod_eq_of_lt (Nat.lt_of_lt_of_le Nat.one_lt_two hp)] at ew
    have hseg := (holds_seg_iff p J (cons w env) (x + 1) 0).1 h'.2
    have e : InSeg p J (cons w env 0) (cons w env (x + 1)) = InSeg p J w (env x) := rfl
    rw [e, ew] at hseg
    match (inSeg_iff p hp0 J 1 (env x)).1 hseg with
    | ⟨c, hc, ec⟩ =>
      rw [Nat.mul_one, FRC.Nat.mod_eq_of_lt (Nat.lt_of_lt_of_le hc hJ)] at ec
      rw [ec]; exact hc
  · intro hlt
    refine ⟨1, Nat.lt_of_lt_of_le Nat.one_lt_two hp, (holds_conj_iff _ _ _ _).2
      ⟨(holds_eq_iff _ _ _ _).2 (FRC.Nat.mod_eq_of_lt (Nat.lt_of_lt_of_le Nat.one_lt_two hp)).symm, ?_⟩⟩
    refine (holds_seg_iff p J (cons 1 env) (x + 1) 0).2 ?_
    show InSeg p J 1 (env x)
    exact (inSeg_iff p hp0 J 1 (env x)).2 ⟨env x, hlt, by rw [Nat.mul_one, FRC.Nat.mod_eq_of_lt hx]⟩

/-- 25:F7 (Lemma decoders, the length) — `seg_J` has `25J + 3` symbols in this syntax (a variable is one symbol here; the
row's `50J + 29` counts the alphabet of 25:F8, where the names are spelt out). -/
theorem size_seg : ∀ (J x w : Nat), size (seg J x w) = 25 * J + 3
  | 0, _, _ => rfl
  | J + 1, x, w => by
    have e : size (seg (J + 1) x w) = 12 + (5 + size (seg J 1 0) + 1 + 1 + 1 + 1) + 1 + 1 + 1 + 1 := rfl
    rw [e, Nat.add_comm 12, Nat.add_comm 5, size_seg J 1 0, Nat.mul_succ]

/-- 25:F7 (Lemma decoders, the length) — `Int_J` has `25J + 10` symbols: linear in `J`. -/
theorem size_IntJ (J x : Nat) : size (IntJ J x) = 25 * J + 10 := by
  have e : size (IntJ J x) = 3 + size (seg J (x + 1) 0) + 1 + 1 + 1 + 1 := rfl
  rw [e, Nat.add_comm 3, size_seg]

/-! ### 00:Z9 — the window's digits against the totality -/

/-- 00:Z9 (the window, in digit counts) — the chart's bound of `Ω` (`00:A7`, `Ω < 1.33 × 10^123`) has `82` base-32 digits
(`32^81 ≤ 1.32 × 10^123` and `1.33 × 10^123 < 32^82`), fewer than the `1,024` base-32 symbols an element of the
dense-coded instance of 25:F8 holds: that instance exists in no shell of the totality. No number above `Ω`'s digit bound
is named. -/
theorem window_beyond_totality : 32 ^ 81 ≤ 132 * 10 ^ 121 ∧ 133 * 10 ^ 121 < 32 ^ 82 ∧ 82 < 1024 := by decide

end FRC.Diagonal

/-! inlined: FrcCore/Theme/Threshold.lean -/

/-!
# FrcCore.Theme.Threshold — the threshold of the dense coding (the logic theme; 25-godel's migration, 20 October 2026)

What the names of the diagonal template cost, and where the count closes (25:F6, 00:Z9), with no axioms. The `k`
shortest distinct names over `a` letters cost `c(k)` symbols (`nameCost`), and `kJ + 2 ≤ c(k) + 2a^J` for every `J`
(`nameCost_lower`): a name is one symbol at least, and at most `2a^j − 2` names have `j` letters or fewer. A dense instance
with `k` coordinates in `v` and `k₁` in `u` needs `2c(k) + c(k + k₁) < d·k₁` and `3c(k) + k₁ < d·k` (`admits`, 25:F4),
which force `k < 6a^{⌊d/3⌋+1}` (`admits_bound`; `k` has at most `⌊d/3⌋ + 4` base-`a` digits, `admits_digits`),
`k < 6a^{⌊d/4⌋+1}` at one scale (`one_scale_bound`), and nothing at `d ≤ 4` (`no_instance_small_d`). The largest admitted
`k` is `k*` (`kstar`, a bounded search that misses nothing, `kstar_max`), the threshold is `t = d·k*`, no instance codes
`λ` at length `n ≥ t` (`no_instance_at_threshold`, with 25:F4's digit bound), and `t < a^{d−1} ≤ m` in every structure
(`threshold_lt`, `threshold_digits`): for `d ≥ 13` and for `a ≥ 6` by `6d·a^{⌊d/3⌋+1} ≤ a^{d−1}`, the pairs with `a ≤ 5`
and `5 ≤ d ≤ 12` by the kernel's computation of `k*`. `⌊d/3⌋` and `⌊d/4⌋` are `third` and `quarter`, by recursion.
-/

namespace FRC.Diagonal

open FRC.Logic FRC.Reach

/-! ### 25:F6 — the threshold: the names the template must spend -/

/-- `⌊d/3⌋`, by the core's recursion (no division). -/
def third : Nat → Nat
  | 0 => 0
  | 1 => 0
  | 2 => 0
  | n + 3 => third n + 1

/-- `⌊d/4⌋`, by the core's recursion. -/
def quarter : Nat → Nat
  | 0 => 0
  | 1 => 0
  | 2 => 0
  | 3 => 0
  | n + 4 => quarter n + 1

theorem third_spec : ∀ d, 3 * third d ≤ d ∧ d < 3 * third d + 3
  | 0 => by decide
  | 1 => by decide
  | 2 => by decide
  | n + 3 => by
    have ih := third_spec n
    show 3 * (third n + 1) ≤ n + 3 ∧ n + 3 < 3 * (third n + 1) + 3
    rw [Nat.mul_succ]
    exact ⟨Nat.add_le_add_right ih.1 3, Nat.add_lt_add_right ih.2 3⟩

theorem quarter_spec : ∀ d, 4 * quarter d ≤ d ∧ d < 4 * quarter d + 4
  | 0 => by decide
  | 1 => by decide
  | 2 => by decide
  | 3 => by decide
  | n + 4 => by
    have ih := quarter_spec n
    show 4 * (quarter n + 1) ≤ n + 4 ∧ n + 4 < 4 * (quarter n + 1) + 4
    rw [Nat.mul_succ]
    exact ⟨Nat.add_le_add_right ih.1 4, Nat.add_lt_add_right ih.2 4⟩

/-- The number of names of a length between `L` and `j` over `a` letters: `a^L + … + a^j` (`0` when `j < L`). -/
def namesBetween (a L : Nat) : Nat → Nat
  | 0 => 0
  | j + 1 => namesBetween a L j + (if L ≤ j + 1 then a ^ (j + 1) else 0)

theorem namesBetween_zero_of_lt (a L : Nat) : ∀ j, j < L → namesBetween a L j = 0
  | 0, _ => rfl
  | j + 1, h => by
    show namesBetween a L j + (if L ≤ j + 1 then a ^ (j + 1) else 0) = 0
    rw [namesBetween_zero_of_lt a L j (Nat.lt_of_succ_lt h), ite_eq_right (Nat.not_le_of_gt h)]

theorem namesBetween_split (a L : Nat) (hL : 1 ≤ L) : ∀ j, L ≤ j → namesBetween a L j = a ^ L + namesBetween a (L + 1) j
  | 0, h => absurd (Nat.le_trans hL h) (Nat.not_le_of_gt Nat.zero_lt_one)
  | j + 1, h => by
    show namesBetween a L j + (if L ≤ j + 1 then a ^ (j + 1) else 0)
        = a ^ L + (namesBetween a (L + 1) j + (if L + 1 ≤ j + 1 then a ^ (j + 1) else 0))
    rw [ite_eq_left h]
    match Nat.lt_or_ge j L with
    | .inl hlt =>
      have e : L = j + 1 := Nat.le_antisymm h (Nat.succ_le_of_lt hlt)
      rw [namesBetween_zero_of_lt a L j hlt, namesBetween_zero_of_lt a (L + 1) j (Nat.lt_succ_of_lt hlt),
        ite_eq_right (fun h' : L + 1 ≤ j + 1 => Nat.lt_irrefl j (Nat.lt_of_lt_of_le hlt (Nat.le_of_succ_le_succ h'))), e]
      exact (Nat.zero_add _).trans (Nat.add_zero _).symm
    | .inr hge =>
      rw [namesBetween_split a L hL j hge, ite_eq_left (Nat.succ_le_succ hge), Nat.add_assoc]

theorem pow_le_namesBetween (a L : Nat) (hL : 1 ≤ L) (j : Nat) (h : L ≤ j) : a ^ L ≤ namesBetween a L j := by
  rw [namesBetween_split a L hL j h]; exact Nat.le_add_right _ _

/-- The cost of the `k` shortest names of length at least `L`: `a^L` of them cost `L` each, the rest are longer. -/
def costFrom (a : Nat) : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | fuel + 1, L, k => if k ≤ a ^ L then k * L else a ^ L * L + costFrom a fuel (L + 1) (k - a ^ L)

/-- The total length of the `k` shortest distinct names over `a` letters: `a` of one letter, `a²` of two, …
(25:F4's `c(k)`). -/
def nameCost (a k : Nat) : Nat := costFrom a k 1 k

theorem lt_of_mul_lt_mul_left' {a b c : Nat} (h : c * a < c * b) : a < b :=
  Nat.lt_of_not_ge (fun hge => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h (Nat.mul_le_mul_left c hge)))

theorem sub_add_eq' (k x : Nat) : ∀ y, k - (x + y) = k - x - y
  | 0 => rfl
  | y + 1 => by
    show k - (x + y + 1) = k - x - (y + 1)
    rw [Nat.sub_succ, Nat.sub_succ, sub_add_eq' k x y]

theorem le_sub_add' (k x : Nat) : k ≤ k - x + x :=
  match Nat.lt_or_ge k x with
  | .inl h => by rw [FRC.Nat.sub_eq_zero_of_le (Nat.le_of_lt h), Nat.zero_add]; exact Nat.le_of_lt h
  | .inr h => by rw [FRC.Nat.sub_add_cancel h]; exact Nat.le_refl k

theorem sumBelow_le_mul (g : Nat → Nat) (c : Nat) (h : ∀ j, g j ≤ c) : ∀ J, sumBelow g J ≤ J * c := fun J =>
  Nat.le_trans (sumBelow_le_sumBelow (fun j _ => h j)) (Nat.le_of_eq (sumBelow_const c J))

theorem sumBelow_ite_le (c L : Nat) : ∀ J, sumBelow (fun j => if j < L then c else 0) J ≤ L * c
  | 0 => Nat.zero_le _
  | J + 1 => by
    show sumBelow (fun j => if j < L then c else 0) J + (if J < L then c else 0) ≤ L * c
    match Nat.lt_or_ge J L with
    | .inl hlt =>
      rw [ite_eq_left hlt]
      have h1 : sumBelow (fun j => if j < L then c else 0) J ≤ J * c :=
        sumBelow_le_mul _ c (fun j => by split <;> first | exact Nat.le_refl c | exact Nat.zero_le c) J
      have h2 : J * c + c ≤ L * c := by rw [← Nat.succ_mul]; exact Nat.mul_le_mul_right c (Nat.succ_le_of_lt hlt)
      exact Nat.le_trans (Nat.add_le_add_right h1 c) h2
    | .inr hge =>
      rw [ite_eq_right (Nat.not_lt_of_ge hge), Nat.add_zero]; exact sumBelow_ite_le c L J

/-- The lower bound behind 25:F6 (i): the `k` shortest names of length at least `L` cost at least
`Σ_{j<J} (k − N_L(j))`, `N_L(j)` the number of such names of length at most `j` — summed over the levels `j`, each name
contributes one to every level below its length. -/
theorem costFrom_lower (a : Nat) (ha : 0 < a) :
    ∀ fuel L k J, 1 ≤ L → k ≤ fuel → sumBelow (fun j => k - namesBetween a L j) J ≤ costFrom a fuel L k
  | 0, L, k, J, _, hk => by
    have e : k = 0 := Nat.le_zero.1 hk
    subst e
    have : sumBelow (fun j => 0 - namesBetween a L j) J = sumBelow (fun _ => 0) J :=
      sumBelow_congr (fun j _ => Nat.zero_sub _)
    rw [this, sumBelow_const, Nat.mul_zero]; exact Nat.le_refl 0
  | fuel + 1, L, k, J, hL, hk => by
    show sumBelow (fun j => k - namesBetween a L j) J
        ≤ (if k ≤ a ^ L then k * L else a ^ L * L + costFrom a fuel (L + 1) (k - a ^ L))
    match Nat.lt_or_ge (a ^ L) k with
    | .inr hle =>
      rw [ite_eq_left hle]
      -- each level below L contributes k, each level from L on contributes nothing
      have hpt : ∀ j, k - namesBetween a L j ≤ (if j < L then k else 0) := fun j =>
        match Nat.lt_or_ge j L with
        | .inl hj => by rw [ite_eq_left hj]; exact Nat.sub_le k _
        | .inr hj => by
          rw [ite_eq_right (Nat.not_lt_of_ge hj)]
          exact Nat.le_of_eq (FRC.Nat.sub_eq_zero_of_le (Nat.le_trans hle (pow_le_namesBetween a L hL j hj)))
      exact Nat.le_trans (sumBelow_le_sumBelow (fun j _ => hpt j))
        (Nat.le_trans (sumBelow_ite_le k L J) (Nat.le_of_eq (Nat.mul_comm L k)))
    | .inl hlt =>
      rw [ite_eq_right (Nat.not_le_of_gt hlt)]
      have hk' : k - a ^ L ≤ fuel :=
        Nat.le_of_lt_succ (Nat.lt_of_lt_of_le (Nat.sub_lt (Nat.lt_of_le_of_lt (Nat.zero_le _) hlt) (Nat.pow_pos ha)) hk)
      have ih := costFrom_lower a ha fuel (L + 1) (k - a ^ L) J (Nat.le_succ_of_le hL) hk'
      -- pointwise: k − N_L(j) ≤ (k − a^L) − N_{L+1}(j) + (if j < L then a^L else 0)
      have hpt : ∀ j, k - namesBetween a L j
          ≤ (k - a ^ L - namesBetween a (L + 1) j) + (if j < L then a ^ L else 0) := fun j =>
        match Nat.lt_or_ge j L with
        | .inl hj => by
          rw [ite_eq_left hj, namesBetween_zero_of_lt a L j hj, namesBetween_zero_of_lt a (L + 1) j (Nat.lt_succ_of_lt hj),
            Nat.sub_zero, Nat.sub_zero, FRC.Nat.sub_add_cancel (Nat.le_of_lt hlt)]
          exact Nat.le_refl k
        | .inr hj => by
          rw [ite_eq_right (Nat.not_lt_of_ge hj), Nat.add_zero, namesBetween_split a L hL j hj, sub_add_eq']
          exact Nat.le_refl _
      have hsum := sumBelow_le_sumBelow (R := J) (fun j _ => hpt j)
      rw [sumBelow_add] at hsum
      exact Nat.le_trans hsum (Nat.le_trans (Nat.add_le_add ih (sumBelow_ite_le (a ^ L) L J))
        (Nat.le_of_eq (by rw [Nat.add_comm, Nat.mul_comm])))

/-- `N(j) = a + … + a^j`, the names of length at most `j`, number at most `2a^j − 2` for `a ≥ 2`. -/
theorem namesBetween_one_le (a : Nat) (ha : 2 ≤ a) : ∀ j, namesBetween a 1 j + 2 ≤ 2 * a ^ j
  | 0 => show 0 + 2 ≤ 2 * 1 from Nat.le_refl 2
  | j + 1 => by
    show namesBetween a 1 j + (if 1 ≤ j + 1 then a ^ (j + 1) else 0) + 2 ≤ 2 * a ^ (j + 1)
    rw [ite_eq_left (Nat.succ_le_succ (Nat.zero_le j))]
    have ih := namesBetween_one_le a ha j
    have h2 : 2 * a ^ j ≤ a ^ (j + 1) := by rw [Nat.pow_succ, Nat.mul_comm (a ^ j) a]; exact Nat.mul_le_mul_right _ ha
    have : namesBetween a 1 j + a ^ (j + 1) + 2 = (namesBetween a 1 j + 2) + a ^ (j + 1) := by
      rw [Nat.add_right_comm]
    rw [this, Nat.two_mul]
    exact Nat.add_le_add (Nat.le_trans ih h2) (Nat.le_refl _)

/-- `Σ_{j<J} N(j) ≤ 2a^J − 2` for `a ≥ 2`. -/
theorem sumBelow_namesBetween_le (a : Nat) (ha : 2 ≤ a) : ∀ J, sumBelow (namesBetween a 1) J + 2 ≤ 2 * a ^ J
  | 0 => show 0 + 2 ≤ 2 * 1 from Nat.le_refl 2
  | J + 1 => by
    show sumBelow (namesBetween a 1) J + namesBetween a 1 J + 2 ≤ 2 * a ^ (J + 1)
    have ih := sumBelow_namesBetween_le a ha J
    have hN := namesBetween_one_le a ha J
    have h2 : 2 * a ^ J ≤ a ^ (J + 1) := by
      rw [Nat.pow_succ, Nat.mul_comm (a ^ J) a]; exact Nat.mul_le_mul_right _ ha
    have h4 : 2 * a ^ J + 2 * a ^ J ≤ 2 * a ^ (J + 1) := by
      rw [← Nat.two_mul]; exact Nat.mul_le_mul_left 2 h2
    have : sumBelow (namesBetween a 1) J + namesBetween a 1 J + 2
        = (sumBelow (namesBetween a 1) J + 2) + namesBetween a 1 J := by rw [Nat.add_right_comm]
    rw [this]
    exact Nat.le_trans (Nat.add_le_add ih (Nat.le_trans (Nat.le_add_right _ 2) hN)) h4

/-- 25:F6 (i), 00:Z9 — the name-cost bound: for every `J`, `kJ + 2 ≤ c(k) + 2a^J`: the `k` shortest names cannot all be
short. -/
theorem nameCost_lower (a : Nat) (ha : 2 ≤ a) (k J : Nat) : k * J + 2 ≤ nameCost a k + 2 * a ^ J := by
  have h1 : sumBelow (fun j => k - namesBetween a 1 j) J ≤ nameCost a k :=
    costFrom_lower a (Nat.lt_of_lt_of_le Nat.zero_lt_two ha) k 1 k J (Nat.le_refl 1) (Nat.le_refl k)
  have h2 : sumBelow (fun _ => k) J ≤ sumBelow (fun j => k - namesBetween a 1 j) J + sumBelow (namesBetween a 1) J := by
    rw [← sumBelow_add]; exact sumBelow_le_sumBelow (fun j _ => le_sub_add' k _)
  rw [sumBelow_const, Nat.mul_comm] at h2
  have h3 := sumBelow_namesBetween_le a ha J
  calc k * J + 2 ≤ sumBelow (fun j => k - namesBetween a 1 j) J + sumBelow (namesBetween a 1) J + 2 :=
        Nat.add_le_add_right h2 2
    _ = sumBelow (fun j => k - namesBetween a 1 j) J + (sumBelow (namesBetween a 1) J + 2) := Nat.add_assoc _ _ _
    _ ≤ nameCost a k + 2 * a ^ J := Nat.add_le_add h1 h3

/-- Every name has at least one letter: `c(k) ≥ k`. -/
theorem le_nameCost (a : Nat) (ha : 0 < a) (k : Nat) : k ≤ nameCost a k := by
  have h := costFrom_lower a ha k 1 k 1 (Nat.le_refl 1) (Nat.le_refl k)
  show k ≤ costFrom a k 1 k
  have e : sumBelow (fun j => k - namesBetween a 1 j) 1 = k := by
    show 0 + (k - 0) = k; rw [Nat.sub_zero, Nat.zero_add]
  rw [e] at h; exact h

/-- The least total length of the variable names in `δ(u) = ∃ v (Diag(u, v) ∧ θ(v))`: each coordinate of `v` named three
times, each of `u` once, the weight on the shortest names (25:F4). -/
def deltaNames (a k k₁ : Nat) : Nat := 2 * nameCost a k + nameCost a (k + k₁)

/-- The least number of symbols the coordinates cost in `λ = δ(⌜δ⌝)`: each coordinate of `v` three times and a closed term
of at least one symbol in each place of `u` (25:F4). -/
def lambdaNames (a k k₁ : Nat) : Nat := 3 * nameCost a k + k₁

/-- The name count leaves an instance open: `λ`'s symbols fit a code of `k` coordinates and `δ`'s a code of `k₁`, a tuple
of `j` coordinates over a structure of `d` digits holding fewer than `d·j` letters. -/
def admits (a d k k₁ : Nat) : Bool :=
  decide (lambdaNames a k k₁ < d * k) && decide (deltaNames a k k₁ < d * k₁)

theorem admits_lambda {a d k k₁ : Nat} (h : admits a d k k₁ = true) : 3 * nameCost a k + k₁ < d * k :=
  of_decide_eq_true (band_l h)

theorem admits_delta {a d k k₁ : Nat} (h : admits a d k k₁ = true) : 2 * nameCost a k + nameCost a (k + k₁) < d * k₁ :=
  of_decide_eq_true (band_r h)

theorem mul3_add_two {x y z : Nat} (h : x + 2 ≤ y + 2 * z) : 3 * x + 6 ≤ 3 * y + 6 * z := by
  have := Nat.mul_le_mul_left 3 h
  rw [Nat.mul_add, Nat.mul_add, ← FRC.Nat.mul_assoc] at this
  exact this

theorem mul2_add_two {x y z : Nat} (h : x + 2 ≤ y + 2 * z) : 2 * x + 4 ≤ 2 * y + 4 * z := by
  have := Nat.mul_le_mul_left 2 h
  rw [Nat.mul_add, Nat.mul_add, ← FRC.Nat.mul_assoc] at this
  exact this

theorem add_self_mul (k J : Nat) : (k + k) * J = 2 * (k * J) := by rw [FRC.Nat.add_mul, Nat.two_mul]

theorem two_add_two_add (x : Nat) : 2 * x + 4 + (2 * x + 2) = 4 * x + 6 := by
  rw [Nat.add_assoc, Nat.add_left_comm 4, ← Nat.add_assoc, ← Nat.two_mul, ← FRC.Nat.mul_assoc]

theorem add_four_add_two (y z w : Nat) : y + 4 * w + (z + 2 * w) = y + z + 6 * w := by
  rw [Nat.add_assoc, Nat.add_left_comm (4 * w), ← Nat.add_assoc, ← FRC.Nat.add_mul]

/-- 25:F6 (the bound), 00:Z9 — an admitted instance has `k < 6a^{⌊d/3⌋+1}`: from `3c(k) < dk` and the name-cost bound at
`J = ⌊d/3⌋ + 1`, where `3J ≥ d + 1`. -/
theorem admits_bound {a d k k₁ : Nat} (ha : 2 ≤ a) (h : admits a d k k₁ = true) : k < 6 * a ^ (third d + 1) := by
  have h3 : 3 * nameCost a k < d * k := Nat.lt_of_le_of_lt (Nat.le_add_right _ k₁) (admits_lambda h)
  have hJ : d + 1 ≤ 3 * (third d + 1) := by rw [Nat.mul_succ]; exact (third_spec d).2
  have h4 := mul3_add_two (nameCost_lower a ha k (third d + 1))
  have h5 : d * k + k ≤ 3 * (k * (third d + 1)) := by
    have := Nat.mul_le_mul_left k hJ
    rw [Nat.mul_succ, FRC.Nat.mul_left_comm, Nat.mul_comm k d] at this
    exact this
  have h6 : d * k + (k + 6) < d * k + 6 * a ^ (third d + 1) := by
    rw [← Nat.add_assoc]
    exact Nat.lt_of_le_of_lt (Nat.le_trans (Nat.add_le_add_right h5 6) h4) (Nat.add_lt_add_right h3 _)
  exact Nat.lt_of_le_of_lt (Nat.le_add_right k 6) (Nat.lt_of_add_lt_add_left h6)

/-- 25:F6 (the digit form), 00:Z9 — an admitted `k` has at most `⌊d/3⌋ + 4` base-`a` digits: `6a^J < a^{J+3}`. -/
theorem admits_digits {a d k k₁ : Nat} (ha : 2 ≤ a) (h : admits a d k k₁ = true) : k < a ^ (third d + 4) := by
  have h1 := admits_bound ha h
  have h2 : 6 * a ^ (third d + 1) < 8 * a ^ (third d + 1) :=
    FRC.Nat.mul_lt_mul_of_lt_of_pos (by decide) (Nat.pow_pos (Nat.lt_of_lt_of_le Nat.zero_lt_two ha))
  have h3 : 8 * a ^ (third d + 1) ≤ a ^ 3 * a ^ (third d + 1) :=
    Nat.mul_le_mul_right _ (Nat.pow_le_pow_left ha 3)
  have e : a ^ 3 * a ^ (third d + 1) = a ^ (third d + 4) := by
    rw [← FRC.Nat.pow_add, Nat.add_comm 3]
  exact Nat.lt_of_lt_of_le h1 (Nat.le_trans (Nat.le_of_lt h2) (e ▸ h3))

/-- 25:F6 (one scale) — with `k₁ = k` the count `2c(k) + c(2k) < dk` forces `k < 6a^{⌊d/4⌋+1}`. -/
theorem one_scale_bound {a d k : Nat} (ha : 2 ≤ a) (h : admits a d k k = true) : k < 6 * a ^ (quarter d + 1) := by
  have hdel : 2 * nameCost a k + nameCost a (k + k) < d * k := admits_delta h
  have hJ : d + 1 ≤ 4 * (quarter d + 1) := by rw [Nat.mul_succ]; exact (quarter_spec d).2
  have b1 := mul2_add_two (nameCost_lower a ha k (quarter d + 1))
  have b2 := nameCost_lower a ha (k + k) (quarter d + 1)
  rw [add_self_mul] at b2
  have h4 : 4 * (k * (quarter d + 1)) + 6 ≤ 2 * nameCost a k + nameCost a (k + k) + 6 * a ^ (quarter d + 1) := by
    have := Nat.add_le_add b1 b2
    rw [two_add_two_add, add_four_add_two] at this
    exact this
  have h5 : d * k + k ≤ 4 * (k * (quarter d + 1)) := by
    have := Nat.mul_le_mul_left k hJ
    rw [Nat.mul_succ, FRC.Nat.mul_left_comm, Nat.mul_comm k d] at this
    exact this
  have h6 : d * k + (k + 6) < d * k + 6 * a ^ (quarter d + 1) := by
    rw [← Nat.add_assoc]
    exact Nat.lt_of_le_of_lt (Nat.le_trans (Nat.add_le_add_right h5 6) h4) (Nat.add_lt_add_right hdel _)
  exact Nat.lt_of_le_of_lt (Nat.le_add_right k 6) (Nat.lt_of_add_lt_add_left h6)

/-- 25:F6 (small `d`) — for `d ≤ 4` no instance is admitted: `c(j) ≥ j` gives `k₁ < k` from `λ`'s count and `k < k₁`
from `δ`'s. -/
theorem no_instance_small_d {a d k k₁ : Nat} (ha : 0 < a) (hd : d ≤ 4) : admits a d k k₁ = false := by
  match h : admits a d k k₁ with
  | false => rfl
  | true =>
    exfalso
    have hlam := admits_lambda h
    have hdel := admits_delta h
    have c1 := le_nameCost a ha k
    have c2 := le_nameCost a ha (k + k₁)
    have h1 : 3 * k + k₁ < 4 * k :=
      Nat.lt_of_le_of_lt (Nat.add_le_add_right (Nat.mul_le_mul_left 3 c1) k₁)
        (Nat.lt_of_lt_of_le hlam (Nat.mul_le_mul_right k hd))
    have h2 : 3 * k + k₁ < 4 * k₁ := by
      have : 3 * k + k₁ ≤ 2 * nameCost a k + nameCost a (k + k₁) := by
        have e : 3 * k + k₁ = 2 * k + (k + k₁) := by
          rw [Nat.succ_mul 2 k, Nat.add_assoc]
        rw [e]; exact Nat.add_le_add (Nat.mul_le_mul_left 2 c1) c2
      exact Nat.lt_of_le_of_lt this (Nat.lt_of_lt_of_le hdel (Nat.mul_le_mul_right k₁ hd))
    -- k₁ < k from h1 and k < k₁ from h2
    have hk₁ : k₁ < k := by
      rw [Nat.succ_mul 3 k] at h1
      exact Nat.lt_of_add_lt_add_left h1
    have hk : k < k₁ := by
      rw [Nat.succ_mul 3 k₁, Nat.add_comm (3 * k₁) k₁, Nat.add_comm (3 * k) k₁] at h2
      exact lt_of_mul_lt_mul_left' (Nat.lt_of_add_lt_add_left h2)
    exact Nat.lt_irrefl k (Nat.lt_trans hk hk₁)

/-- Whether some `k₁` admits `k`: by `λ`'s count `k₁ < dk − 3c(k)`, so the search runs below that bound. -/
def admitsSome (a d k : Nat) : Bool := anyBelow (fun k₁ => admits a d k k₁) (d * k - 3 * nameCost a k)

theorem admitsSome_of {a d k k₁ : Nat} (h : admits a d k k₁ = true) : admitsSome a d k = true := by
  have hlam := admits_lambda h
  have hlt : k₁ < d * k - 3 * nameCost a k := by
    have h3 : 3 * nameCost a k ≤ d * k := Nat.le_of_lt (Nat.lt_of_le_of_lt (Nat.le_add_right _ k₁) hlam)
    have e := FRC.Nat.sub_add_cancel h3
    rw [← e, Nat.add_comm] at hlam
    exact Nat.lt_of_add_lt_add_right hlam
  exact (anyBelow_true_iff _ _).2 ⟨k₁, hlt, h⟩

/-- The largest `i < n` with `P i`, or `0` if there is none. -/
def largestBelow (P : Nat → Bool) : Nat → Nat
  | 0 => 0
  | n + 1 => if P n then n else largestBelow P n

theorem le_largestBelow (P : Nat → Bool) {i : Nat} (hi : P i = true) : ∀ n, i < n → i ≤ largestBelow P n
  | 0, h => absurd h (Nat.not_lt_zero i)
  | n + 1, h => by
    show i ≤ (if P n then n else largestBelow P n)
    match hP : P n with
    | true => rw [ite_eq_left rfl]; exact Nat.le_of_lt_succ h
    | false =>
      rw [ite_eq_right (by decide : ¬ (false = true))]
      have hne : i ≠ n := fun e => Bool.noConfusion (hi.symm.trans (e ▸ hP))
      exact le_largestBelow P hi n (Nat.lt_of_le_of_ne (Nat.le_of_lt_succ h) hne)

theorem largestBelow_lt (P : Nat → Bool) : ∀ n, 0 < n → largestBelow P n < n
  | 0, h => absurd h (Nat.lt_irrefl 0)
  | n + 1, _ => by
    show (if P n then n else largestBelow P n) < n + 1
    match hP : P n with
    | true => rw [ite_eq_left rfl]; exact Nat.lt_succ_self n
    | false =>
      rw [ite_eq_right (by decide : ¬ (false = true))]
      match n with
      | 0 => exact Nat.zero_lt_one
      | n + 1 => exact Nat.lt_succ_of_lt (largestBelow_lt P (n + 1) (Nat.succ_pos n))

theorem largestBelow_eq_zero (P : Nat → Bool) : ∀ n, (∀ i, i < n → P i = false) → largestBelow P n = 0
  | 0, _ => rfl
  | n + 1, h => by
    show (if P n then n else largestBelow P n) = 0
    rw [h n (Nat.lt_succ_self n), ite_eq_right (by decide : ¬ (false = true))]
    exact largestBelow_eq_zero P n (fun i hi => h i (Nat.lt_succ_of_lt hi))

/-- `k*(M)`: the largest `k` some `k₁` admits, searched below the bound `6a^{⌊d/3⌋+1}` (25:F6). -/
def kstar (a d : Nat) : Nat := largestBelow (admitsSome a d) (6 * a ^ (third d + 1))

/-- `t(M) = d · k*(M)`, the threshold length (25:F6). -/
def threshold (a d : Nat) : Nat := d * kstar a d

/-- 25:F6, 00:Z9 — the search misses nothing: every admitted `k` is at most `k*`. -/
theorem kstar_max {a d k k₁ : Nat} (ha : 2 ≤ a) (h : admits a d k k₁ = true) : k ≤ kstar a d :=
  le_largestBelow (admitsSome a d) (admitsSome_of h) _ (admits_bound ha h)

/-- 25:F6 — `k*(M) < 6a^{⌊d/3⌋+1}`, as the row states it. -/
theorem kstar_lt {a d : Nat} (ha : 1 ≤ a) : kstar a d < 6 * a ^ (third d + 1) :=
  largestBelow_lt _ _ (Nat.mul_pos (by decide) (Nat.pow_pos ha))

/-- 25:F6, 00:Z9 (the digit form) — `k*(M)` has at most `⌊d/3⌋ + 4` base-`a` digits. -/
theorem kstar_digits {a d : Nat} (ha : 2 ≤ a) : kstar a d < a ^ (third d + 4) := by
  have h2 : 6 * a ^ (third d + 1) < 8 * a ^ (third d + 1) :=
    FRC.Nat.mul_lt_mul_of_lt_of_pos (by decide) (Nat.pow_pos (Nat.lt_of_lt_of_le Nat.zero_lt_two ha))
  have h3 : 8 * a ^ (third d + 1) ≤ a ^ 3 * a ^ (third d + 1) :=
    Nat.mul_le_mul_right _ (Nat.pow_le_pow_left ha 3)
  have e : a ^ 3 * a ^ (third d + 1) = a ^ (third d + 4) := by rw [← FRC.Nat.pow_add, Nat.add_comm 3]
  exact Nat.lt_of_lt_of_le (kstar_lt (Nat.le_of_lt ha)) (Nat.le_trans (Nat.le_of_lt h2) (e ▸ h3))

/-- 25:F6 (ii), 00:Z9 — no instance codes `λ` at length `n ≥ t(M)`: with `k + 1` coordinates in `v` admitted and the
coding injective (`a^n ≤ m^(k+1)`, 25:F4) over a structure of `d` digits, `n < d(k + 1) ≤ d·k* = t(M)`. -/
theorem no_instance_at_threshold {a d k k₁ m n : Nat} (ha : 2 ≤ a) (h : admits a d (k + 1) k₁ = true)
    (hm : m < a ^ d) (hc : a ^ n ≤ m ^ (k + 1)) : n < threshold a d :=
  Nat.lt_of_lt_of_le (digit_bound (Nat.lt_of_lt_of_le Nat.zero_lt_two ha) hm hc)
    (Nat.mul_le_mul_left d (kstar_max ha h))

/-- For `d ≤ 4` the threshold is `0`: nothing is admitted. -/
theorem threshold_small_d {a d : Nat} (ha : 0 < a) (hd : d ≤ 4) : threshold a d = 0 := by
  show d * largestBelow (admitsSome a d) _ = 0
  rw [largestBelow_eq_zero (admitsSome a d) _ (fun k _ => by
    show anyBelow (fun k₁ => admits a d k k₁) _ = false
    rw [anyBelow_congr (fun k₁ _ => no_instance_small_d ha hd)]; exact anyBelow_false _), Nat.mul_zero]

theorem coef_pow_le {a : Nat} (ha : 2 ≤ a) (c e J : Nat) (hc : c ≤ 2 ^ e) : c * a ^ J ≤ a ^ (e + J) := by
  rw [FRC.Nat.pow_add]; exact Nat.mul_le_mul_right _ (Nat.le_trans hc (Nat.pow_le_pow_left ha e))

theorem coef_pow_le6 {a : Nat} (ha : 6 ≤ a) (c e J : Nat) (hc : c ≤ 6 ^ e) : c * a ^ J ≤ a ^ (e + J) := by
  rw [FRC.Nat.pow_add]; exact Nat.mul_le_mul_right _ (Nat.le_trans hc (Nat.pow_le_pow_left ha e))

theorem rearr4 (x y z : Nat) : 4 * x * (y * z) = x * y * (4 * z) := by
  rw [FRC.Nat.mul_assoc, FRC.Nat.mul_left_comm, FRC.Nat.mul_left_comm 4 y, ← FRC.Nat.mul_assoc]

/-- The step `d → d + 3` of the bound `6d·a^{⌊d/3⌋+1} ≤ a^{d−1}`: the left side gains at most the factor `4a`, the right
side `a³`. -/
theorem six_d_pow_step {a : Nat} (ha : 2 ≤ a) (d : Nat) (hd : 1 ≤ d)
    (h : 6 * d * a ^ (third d + 1) ≤ a ^ (d - 1)) : 6 * (d + 3) * a ^ (third (d + 3) + 1) ≤ a ^ (d + 2) := by
  have e3 : third (d + 3) + 1 = third d + 1 + 1 := rfl
  rw [e3]
  have h1 : 6 * (d + 3) ≤ 4 * (6 * d) := by
    have e1 : 6 * (d + 3) = 6 * d + 18 := by rw [Nat.mul_add]
    have e2 : 4 * (6 * d) = 6 * d + 18 * d := by rw [← FRC.Nat.mul_assoc, ← FRC.Nat.add_mul]
    rw [e1, e2]
    exact Nat.add_le_add_left (Nat.le_mul_of_pos_right 18 hd) _
  have h4 : 4 ≤ a ^ 2 := Nat.pow_le_pow_left ha 2
  have hpow : a ^ (third d + 1 + 1) = a ^ (third d + 1) * a := rfl
  have hd2 : a ^ (d + 2) = a ^ (d - 1) * (a ^ 2 * a) := by
    have e : d - 1 + 3 = d + 2 := congrArg (· + 2) (FRC.Nat.sub_add_cancel hd)
    rw [← e, FRC.Nat.pow_add]; rfl
  rw [hpow, hd2]
  calc 6 * (d + 3) * (a ^ (third d + 1) * a)
      ≤ 4 * (6 * d) * (a ^ (third d + 1) * a) := Nat.mul_le_mul_right _ h1
    _ = 6 * d * a ^ (third d + 1) * (4 * a) := rearr4 _ _ _
    _ ≤ a ^ (d - 1) * (a ^ 2 * a) := Nat.mul_le_mul h (Nat.mul_le_mul_right a h4)

/-- `6d·a^{⌊d/3⌋+1} ≤ a^{d−1}` for every `d ≥ 13` and `a ≥ 2`: the cases `13`, `14`, `15` and the step. -/
theorem six_d_pow_le_large {a : Nat} (ha : 2 ≤ a) :
    ∀ n, 6 * (13 + n) * a ^ (third (13 + n) + 1) ≤ a ^ (12 + n) := by
  have base0 : 6 * (13 + 0) * a ^ (third (13 + 0) + 1) ≤ a ^ (12 + 0) := coef_pow_le ha 78 7 5 (by decide)
  have base1 : 6 * (13 + 1) * a ^ (third (13 + 1) + 1) ≤ a ^ (12 + 1) := coef_pow_le ha 84 8 5 (by decide)
  have base2 : 6 * (13 + 2) * a ^ (third (13 + 2) + 1) ≤ a ^ (12 + 2) := coef_pow_le ha 90 8 6 (by decide)
  have step : ∀ n, 6 * (13 + n) * a ^ (third (13 + n) + 1) ≤ a ^ (12 + n)
      → 6 * (13 + (n + 3)) * a ^ (third (13 + (n + 3)) + 1) ≤ a ^ (12 + (n + 3)) := fun n h => by
    have e1 : 13 + n - 1 = 12 + n := by
      rw [Nat.add_comm 13 n, Nat.add_comm 12 n]; exact FRC.Nat.add_sub_cancel (n + 12) 1
    have h' : 6 * (13 + n) * a ^ (third (13 + n) + 1) ≤ a ^ (13 + n - 1) := by rw [e1]; exact h
    have := six_d_pow_step ha (13 + n) (Nat.le_add_right_of_le (by decide)) h'
    have e2 : 13 + (n + 3) = 13 + n + 3 := (Nat.add_assoc 13 n 3).symm
    have e3 : 12 + (n + 3) = 13 + n + 2 := by
      rw [Nat.add_comm n 3, ← Nat.add_assoc, Nat.add_assoc 13 n 2, Nat.add_comm n 2, ← Nat.add_assoc]
    rw [e2, e3]; exact this
  have all : ∀ n, (6 * (13 + n) * a ^ (third (13 + n) + 1) ≤ a ^ (12 + n)) ∧
      (6 * (13 + (n + 1)) * a ^ (third (13 + (n + 1)) + 1) ≤ a ^ (12 + (n + 1))) ∧
      (6 * (13 + (n + 2)) * a ^ (third (13 + (n + 2)) + 1) ≤ a ^ (12 + (n + 2))) := fun n => by
    induction n with
    | zero => exact ⟨base0, base1, base2⟩
    | succ n ih => exact ⟨ih.2.1, ih.2.2, step n ih.1⟩
  exact fun n => (all n).1

/-- `6d·a^{⌊d/3⌋+1} ≤ a^{d−1}` for `5 ≤ d ≤ 12` and `a ≥ 6`, each `d` by one bound `6d ≤ 6^{d−1−J}`. -/
theorem six_d_pow_le_mid {a : Nat} (ha : 6 ≤ a) (d : Nat) (h5 : 5 ≤ d) (h12 : d ≤ 12) :
    6 * d * a ^ (third d + 1) ≤ a ^ (d - 1) :=
  match d, h5, h12 with
  | 5, _, _ => coef_pow_le6 ha 30 2 2 (by decide)
  | 6, _, _ => coef_pow_le6 ha 36 2 3 (by decide)
  | 7, _, _ => coef_pow_le6 ha 42 3 3 (by decide)
  | 8, _, _ => coef_pow_le6 ha 48 4 3 (by decide)
  | 9, _, _ => coef_pow_le6 ha 54 4 4 (by decide)
  | 10, _, _ => coef_pow_le6 ha 60 5 4 (by decide)
  | 11, _, _ => coef_pow_le6 ha 66 6 4 (by decide)
  | 12, _, _ => coef_pow_le6 ha 72 6 5 (by decide)
  | 0, h, _ => absurd h (by decide)
  | 1, h, _ => absurd h (by decide)
  | 2, h, _ => absurd h (by decide)
  | 3, h, _ => absurd h (by decide)
  | 4, h, _ => absurd h (by decide)
  | n + 13, _, h => absurd h (Nat.not_le_of_gt (Nat.lt_of_lt_of_le (by decide) (Nat.le_add_left 13 n)))

/-- The pairs `(a, d)` with `a ≤ 5` and `5 ≤ d ≤ 12`: either the bound `6d·a^{⌊d/3⌋+1} ≤ a^{d−1}` holds or the kernel
computes `k*` and finds `t < a^{d−1}` — the fifteen pairs of the row's check D5, decided here. -/
theorem threshold_small_pairs : ∀ a, a < 6 → ∀ d, d < 13 → 2 ≤ a → 5 ≤ d →
    (6 * d * a ^ (third d + 1) ≤ a ^ (d - 1) ∨ threshold a d < a ^ (d - 1)) := by
  decide +kernel

/-- 25:F6 (iii), 25:G7, 00:Z9 — `t(M) < m` in every structure: `m` has `d` base-`a` digits (`a^{d−1} ≤ m`), and the threshold
`d·k*` has fewer: `k* < 6a^{⌊d/3⌋+1}` and `6d·a^{⌊d/3⌋+1} ≤ a^{d−1}` from `d = 13` on and for `a ≥ 6`, the small pairs
computed, nothing admitted at `d ≤ 4`. -/
theorem threshold_lt {a d m : Nat} (ha : 2 ≤ a) (hm : a ^ (d - 1) ≤ m) : threshold a d < m := by
  have ha1 : 0 < a := Nat.lt_of_lt_of_le Nat.zero_lt_two ha
  have hpos : 0 < m := Nat.lt_of_lt_of_le (Nat.pow_pos ha1) hm
  have viaG : 0 < d → 6 * d * a ^ (third d + 1) ≤ a ^ (d - 1) → threshold a d < m := fun hd hG => by
    show d * kstar a d < m
    have h1 : d * kstar a d < d * (6 * a ^ (third d + 1)) := Nat.mul_lt_mul_of_pos_left (kstar_lt ha1) hd
    have e : d * (6 * a ^ (third d + 1)) = 6 * d * a ^ (third d + 1) := by
      rw [FRC.Nat.mul_left_comm, ← FRC.Nat.mul_assoc]
    exact Nat.lt_of_lt_of_le h1 (Nat.le_trans (e ▸ hG) hm)
  match Nat.lt_or_ge d 5 with
  | .inl hd4 => rw [threshold_small_d ha1 (Nat.le_of_lt_succ hd4)]; exact hpos
  | .inr hd5 =>
    have hd : 0 < d := Nat.lt_of_lt_of_le (by decide) hd5
    match Nat.lt_or_ge d 13 with
    | .inr hd13 =>
      have hG := six_d_pow_le_large ha (d - 13)
      have e1 : 13 + (d - 13) = d := FRC.Nat.add_sub_of_le hd13
      have e2 : 12 + (d - 13) = d - 1 := by
        have h := congrArg (· - 1) e1
        have e : 13 + (d - 13) - 1 = 12 + (d - 13) := by
          rw [show 13 + (d - 13) = 12 + (d - 13) + 1 from (Nat.add_right_comm 12 (d - 13) 1).symm]
          exact FRC.Nat.add_sub_cancel _ 1
        rw [← e]; exact h
      rw [e1, e2] at hG
      exact viaG hd hG
    | .inl hd13 =>
      match Nat.lt_or_ge a 6 with
      | .inr ha6 => exact viaG hd (six_d_pow_le_mid ha6 d hd5 (Nat.le_of_lt_succ hd13))
      | .inl ha6 =>
        match threshold_small_pairs a ha6 d hd13 ha hd5 with
        | .inl hG => exact viaG hd hG
        | .inr hlt => exact Nat.lt_of_lt_of_le hlt hm

/-- 25:F6 (iii), 00:Z9, the digit form — the threshold has fewer base-`a` digits than `m`: `t(M) < a^{d−1}`. -/
theorem threshold_digits {a d : Nat} (ha : 2 ≤ a) : threshold a d < a ^ (d - 1) :=
  threshold_lt ha (Nat.le_refl _)

end FRC.Diagonal

/-! inlined: FrcCore/Theme/Sets.lean -/

/-!
# The logic theme — finite sets: the antinomy as a theorem, counting measure, no doubling, principal ultrafilters

The finite witnesses of 5-reductio's normal forms (21 October 2026): the antinomy normal form as a theorem of
separation, abstractly for any membership relation and on hereditarily finite sets built as finite trees (5:D2,
5:D5); the iterated singletons `∅, {∅}, {{∅}}, …`, pairwise distinct and outrunning every set (5:D9); counting
measure on `[0, n)` — total, additive, invariant under every bijection (5:E8, 5:D9, 5:D5); no injection of `X ⊔ X`
into `X` (5:E8); every ultrafilter on a finite set is principal (5:E8). No Mathlib, no axioms, no classical logic:
the ultrafilter is Boolean-valued and its point is found by bounded search.
-/

namespace FRC.Sets

open FRC.Logic

/-! ### 5:D2 — Russell's argument as a theorem of separation -/

/-- 5:D2, 5:D5 (Proposition antinomy-NF, the theorem) — for any membership relation `M`, no class `r` satisfies
`x ∈ r ↔ x ∉ x` for every `x`: `r ∈ r ↔ r ∉ r` is contradictory. The antinomy is a theorem about the Russell class,
and a paradox only where comprehension forms it. -/
theorem no_russell_class {α : Type} (M : α → α → Prop) : ¬ ∃ r, ∀ x, M x r ↔ ¬ M x x :=
  fun ⟨r, h⟩ =>
    have hn : ¬ M r r := fun hr => (h r).mp hr hr
    hn ((h r).mpr hn)

/-- 5:D2, 5:D5 (Proposition antinomy-NF, the inconsistent bundle) — with separation (`sep u` is `{x ∈ u | x ∉ x}` for
every `u`) no set is universal: the Russell class of a universal set would be the class of all `x ∉ x`. This is
Cns + AT + comprehension inconsistent, read on separation. -/
theorem no_universal_of_separation {α : Type} (M : α → α → Prop) (sep : α → α)
    (hsep : ∀ u x, M x (sep u) ↔ (M x u ∧ ¬ M x x)) : ¬ ∃ v, ∀ x, M x v :=
  fun ⟨v, hv⟩ => no_russell_class M ⟨sep v, fun x =>
    ⟨fun h => ((hsep v x).mp h).2, fun h => (hsep v x).mpr ⟨hv x, h⟩⟩⟩

/-- 5:D2, 5:D5 (Proposition antinomy-NF, the witness) — bounded comprehension has no antinomy: for every set `u` the
class `r = {x ∈ u | x ∉ x}` is a set that is not a member of `u` (were `r ∈ u`, then `r ∈ r ↔ r ∉ r`). -/
theorem russell_not_mem {α : Type} (M : α → α → Prop) (u r : α) (hr : ∀ x, M x r ↔ (M x u ∧ ¬ M x x)) : ¬ M r u :=
  fun hru =>
    have hn : ¬ M r r := fun hrr => ((hr r).mp hrr).2 hrr
    hn ((hr r).mpr ⟨hru, hn⟩)

/-! ### Hereditarily finite sets as finite trees -/

/-- A hereditarily finite set: the finite list of its members. -/
inductive HF where
  | mk : List HF → HF

/-- Membership in a list of sets, as a proposition. -/
def memList (x : HF) : List HF → Prop
  | [] => False
  | y :: ys => x = y ∨ memList x ys

/-- The members of a set. -/
def HF.members : HF → List HF
  | .mk l => l

/-- `x ∈ u`. -/
def HF.Mem (x u : HF) : Prop := memList x u.members

mutual
/-- The rank: one more than the largest rank of a member, `0` for the empty set. -/
def HF.rank : HF → Nat
  | .mk l => rankList l
/-- The least bound above the ranks of the members of a list. -/
def rankList : List HF → Nat
  | [] => 0
  | x :: xs => mx (HF.rank x + 1) (rankList xs)
end

theorem rank_lt_of_memList {x : HF} : ∀ {l : List HF}, memList x l → HF.rank x < rankList l
  | [], h => absurd h id
  | y :: ys, h => match h with
    | Or.inl e => by
        show HF.rank x < mx (HF.rank y + 1) (rankList ys)
        rw [e]; exact Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (le_mx_left _ _)
    | Or.inr h' => by
        show HF.rank x < mx (HF.rank y + 1) (rankList ys)
        exact Nat.lt_of_lt_of_le (rank_lt_of_memList h') (le_mx_right _ _)

/-- A member has smaller rank. -/
theorem rank_lt_of_mem {x u : HF} (h : HF.Mem x u) : HF.rank x < HF.rank u := by
  match u with
  | .mk l => exact rank_lt_of_memList h

/-- 5:D2 (Proposition antinomy-NF, the witness on hereditarily finite sets) — no set is a member of itself. -/
theorem not_mem_self (x : HF) : ¬ HF.Mem x x :=
  fun h => Nat.lt_irrefl _ (rank_lt_of_mem h)

/-- The Russell class of `u`, `{x ∈ u | x ∉ x}`: on hereditarily finite sets it is `u` itself, since no set is a
member of itself (`mem_russell`). -/
def russell (u : HF) : HF := u

/-- 5:D2 — the Russell class of `u` is exactly the separation `{x ∈ u | x ∉ x}`. -/
theorem mem_russell (u x : HF) : HF.Mem x (russell u) ↔ (HF.Mem x u ∧ ¬ HF.Mem x x) :=
  ⟨fun h => ⟨h, not_mem_self x⟩, fun h => h.1⟩

/-- 5:D2, 5:D5 — every set `u` has a subset, its Russell class, that is not a member of `u`. -/
theorem russell_not_mem_hf (u : HF) : ¬ HF.Mem (russell u) u :=
  russell_not_mem HF.Mem u (russell u) (mem_russell u)

/-- 5:D2, 5:D5 — no hereditarily finite set is universal: `v` itself is not a member of `v`. -/
theorem no_universal (v : HF) : ∃ x, ¬ HF.Mem x v := ⟨v, not_mem_self v⟩

/-! ### 5:D9 — the iterated singletons -/

/-- The singleton `{x}`. -/
def single (x : HF) : HF := .mk [x]

/-- The chain `∅, {∅}, {{∅}}, …`. -/
def chain : Nat → HF
  | 0 => .mk []
  | n + 1 => single (chain n)

theorem rank_single (x : HF) : HF.rank (single x) = HF.rank x + 1 := by
  show mx (HF.rank x + 1) 0 = HF.rank x + 1
  unfold mx; exact ite_eq_right (Nat.not_lt_zero _)

/-- 5:D9 (Corollary AT-det) — the `n`-th iterated singleton has rank `n`. -/
theorem rank_chain : ∀ n, HF.rank (chain n) = n
  | 0 => rfl
  | n + 1 => by show HF.rank (single (chain n)) = n + 1; rw [rank_single, rank_chain n]

/-- 5:D9 (Corollary AT-det) — the iterated singletons are pairwise distinct. -/
theorem chain_injective {a b : Nat} (h : chain a = chain b) : a = b := by
  have := congrArg HF.rank h; rwa [rank_chain, rank_chain] at this

/-- 5:D9 (Corollary AT-det, the finite form of "a universal set is infinite") — no set holds every iterated
singleton: the one of its own rank is not among its members, since members have smaller rank. -/
theorem chain_not_mem (v : HF) : ¬ HF.Mem (chain (HF.rank v)) v :=
  fun h => Nat.lt_irrefl _ (rank_chain (HF.rank v) ▸ rank_lt_of_mem h)

/-! ### 5:E8, 5:D9, 5:D5 — counting measure on `[0, n)` -/

/-- The counting measure of a subset of `[0, n)`, the subset a Boolean predicate. -/
def measure (A : Nat → Bool) (n : Nat) : Nat := count A n

theorem measure_zero (A : Nat → Bool) : measure A 0 = 0 := rfl

theorem measure_succ (A : Nat → Bool) (n : Nat) : measure A (n + 1) = measure A n + cond (A n) 1 0 := rfl

/-- 5:E8, 5:D9 — counting measure is total: every subset has one, at most the size of the set. -/
theorem measure_le (A : Nat → Bool) : ∀ n, measure A n ≤ n
  | 0 => Nat.le_refl 0
  | n + 1 => by
    rw [measure_succ]
    exact match h : A n with
      | true => Nat.add_le_add_right (measure_le A n) 1
      | false => Nat.le_succ_of_le (measure_le A n)

/-- 5:E8 — the whole set has measure `n` and the empty set measure `0`. -/
theorem measure_univ (n : Nat) : measure (fun _ => true) n = n := count_full (fun _ _ => rfl)

theorem measure_empty (n : Nat) : measure (fun _ => false) n = 0 := count_false n

/-- 5:E8, 5:D5 (counting measure is finitely additive) — on disjoint subsets the measure of the union is the sum. -/
theorem measure_add (A B : Nat → Bool) : ∀ n, (∀ x, x < n → ¬ (A x = true ∧ B x = true)) →
    measure (fun x => A x || B x) n = measure A n + measure B n
  | 0, _ => rfl
  | n + 1, h => by
    rw [measure_succ, measure_succ, measure_succ, measure_add A B n (fun x hx => h x (Nat.lt_succ_of_lt hx))]
    cases ha : A n <;> cases hb : B n
    · rfl
    · show measure A n + measure B n + 1 = measure A n + (measure B n + 1)
      exact Nat.add_assoc _ _ _
    · show measure A n + measure B n + 1 = measure A n + 1 + measure B n
      exact Nat.add_right_comm _ _ _
    · exact absurd ⟨ha, hb⟩ (h n (Nat.lt_succ_self n))

/-- 5:E8 — a subset and its complement share the set: `|A| + |Aᶜ| = n`. -/
theorem measure_compl (A : Nat → Bool) : ∀ n, measure A n + measure (fun x => !A x) n = n
  | 0 => rfl
  | n + 1 => by
    rw [measure_succ, measure_succ]
    cases h : A n
    · show measure A n + (measure (fun x => !A x) n + 1) = n + 1
      rw [← Nat.add_assoc, measure_compl A n]
    · show measure A n + 1 + measure (fun x => !A x) n = n + 1
      rw [Nat.add_right_comm, measure_compl A n]

/-- The count of `A` over a list of positions. -/
def countList (A : Nat → Bool) : List Nat → Nat
  | [] => 0
  | a :: l => cond (A a) 1 0 + countList A l

theorem countList_imageList (A : Nat → Bool) (σ : Nat → Nat) : ∀ n,
    countList A (FRC.Shell.imageList σ n) = count (fun j => A (σ j)) n
  | 0 => rfl
  | n + 1 => by
    show cond (A (σ n)) 1 0 + countList A (FRC.Shell.imageList σ n) = count (fun j => A (σ j)) n + cond (A (σ n)) 1 0
    rw [countList_imageList A σ n, Nat.add_comm]

theorem countList_erase (A : Nat → Bool) {v : Nat} : ∀ {l : List Nat}, Pigeonhole.mem v l →
    countList A l = cond (A v) 1 0 + countList A (Pigeonhole.erase v l)
  | [], h => absurd h id
  | a :: l, h =>
    match Nat.decEq a v with
    | isTrue e => by rw [show Pigeonhole.erase v (a :: l) = l from ite_eq_left e, e]; rfl
    | isFalse e => by
        rw [show Pigeonhole.erase v (a :: l) = a :: Pigeonhole.erase v l from ite_eq_right e]
        have hm : Pigeonhole.mem v l := match h with
          | Or.inl h' => absurd h'.symm e
          | Or.inr h' => h'
        show cond (A a) 1 0 + countList A l = cond (A v) 1 0 + (cond (A a) 1 0 + countList A (Pigeonhole.erase v l))
        rw [countList_erase A hm, Nat.add_left_comm]

/-- A count over any list of `n` distinct positions below `n` is the count over `[0, n)`. -/
theorem countList_eq_count (A : Nat → Bool) : ∀ (n : Nat) (l : List Nat), Pigeonhole.NoDup l →
    (∀ e, Pigeonhole.mem e l → e < n) → l.length = n → countList A l = count A n
  | 0, [], _, _, _ => rfl
  | 0, a :: _, _, hb, _ => absurd (hb a (Or.inl rfl)) (Nat.not_lt_zero a)
  | n + 1, l, hnd, hb, hlen => by
    have hm : Pigeonhole.mem n l := Pigeonhole.mem_of_nodup_of_length_lt (n + 1) l hnd hb hlen n (Nat.lt_succ_self n)
    rw [countList_erase A hm]
    have hb' : ∀ e, Pigeonhole.mem e (Pigeonhole.erase n l) → e < n := fun e he =>
      match Nat.lt_or_ge e n with
      | Or.inl hlt => hlt
      | Or.inr hge =>
        have : e = n := Nat.le_antisymm (Nat.le_of_lt_succ (hb e (Pigeonhole.mem_of_mem_erase he))) hge
        absurd (this ▸ he) (Pigeonhole.not_mem_erase_self n hnd)
    have hlen' : (Pigeonhole.erase n l).length = n := by
      have := Pigeonhole.length_erase_of_mem hm; rw [hlen] at this; exact Nat.succ.inj this
    rw [countList_eq_count A n (Pigeonhole.erase n l) (Pigeonhole.nodup_erase n hnd) hb' hlen']
    show cond (A n) 1 0 + count A n = count A n + cond (A n) 1 0
    exact Nat.add_comm _ _

/-- 5:E8, 5:D9, 5:D5 (counting measure is invariant) — a bijection `σ` of `[0, n)` (injective, with values below `n`) carries
every subset to one of the same measure: `|σ⁻¹ A| = |A|`. -/
theorem measure_perm (A : Nat → Bool) (σ : Nat → Nat) (n : Nat) (hlt : ∀ j, j < n → σ j < n)
    (hinj : ∀ i j, i < n → j < n → σ i = σ j → i = j) :
    measure (fun j => A (σ j)) n = measure A n := by
  show count (fun j => A (σ j)) n = count A n
  rw [← countList_imageList]
  exact countList_eq_count A n (FRC.Shell.imageList σ n) (FRC.Shell.imageList_nodup hinj (Nat.le_refl n))
    (fun e he => match FRC.Shell.mem_imageList he with | ⟨j, hj, e'⟩ => e' ▸ hlt j hj) (FRC.Shell.imageList_length σ n)

/-! ### 5:E8 — no decomposition doubles a finite set -/

/-- 5:E8, 5:D5 (no paradoxical decomposition) — `X ⊔ X` does not inject into `X`: no map from `[0, 2n)` into `[0, n)`, `n ≥ 1`,
is injective. The restriction to `[0, n)` is onto (`inj_onto`), so `f n` already has a preimage below `n`. -/
theorem no_doubling (n : Nat) (hn : 0 < n) (f : Nat → Nat) (hf : ∀ x, x < 2 * n → f x < n) :
    ¬ ∀ x y, x < 2 * n → y < 2 * n → f x = f y → x = y :=
  fun hinj =>
    have hn2 : n < 2 * n := by rw [Nat.two_mul]; exact Nat.lt_add_of_pos_left hn
    have hlt : ∀ x, x < n → f x < n := fun x hx => hf x (Nat.lt_trans hx hn2)
    have hinj' : ∀ x y, x < n → y < n → f x = f y → x = y :=
      fun x y hx hy e => hinj x y (Nat.lt_trans hx hn2) (Nat.lt_trans hy hn2) e
    match inj_onto n f hlt hinj' (f n) (hf n hn2) with
    | ⟨x, hx, e⟩ => Nat.lt_irrefl n (hinj x n (Nat.lt_trans hx hn2) hn2 e ▸ hx)

/-! ### 5:E8 — every ultrafilter on a finite set is principal -/

/-- An ultrafilter on `[0, n)`, Boolean-valued on the subsets of `[0, n)` (Boolean predicates read below `n`): it
respects equality below `n`, excludes the empty set, is closed upward and under intersection, and holds a set or
its complement. -/
structure Ultra (n : Nat) where
  U : (Nat → Bool) → Bool
  congr : ∀ A B, (∀ x, x < n → A x = B x) → U A = true → U B = true
  proper : U (fun _ => false) = false
  up : ∀ A B, (∀ x, x < n → A x = true → B x = true) → U A = true → U B = true
  inter : ∀ A B, U A = true → U B = true → U (fun x => A x && B x) = true
  ultra : ∀ A, U A = true ∨ U (fun x => !A x) = true

/-- The positions from `k` on, `[k, n)` within `[0, n)`. -/
def above (k : Nat) : Nat → Bool := fun y => decide (k ≤ y)

/-- The singleton `{x}` as a predicate. -/
def pt (x : Nat) : Nat → Bool := fun y => decide (x = y)

theorem Ultra.univ {n : Nat} (F : Ultra n) : F.U (fun _ => true) = true :=
  match F.ultra (fun _ => false) with
  | Or.inl h => absurd h (by rw [F.proper]; exact Bool.false_ne_true)
  | Or.inr h => h

/-- `[k, n) ∖ {k} = [k + 1, n)`, pointwise. -/
theorem above_succ (k y : Nat) : (above k y && !pt k y) = above (k + 1) y :=
  match Nat.lt_or_ge y k with
  | Or.inl hlt => by
      show (decide (k ≤ y) && !decide (k = y)) = decide (k + 1 ≤ y)
      rw [decide_eq_false (Nat.not_le_of_lt hlt), decide_eq_false (Nat.not_le_of_lt (Nat.lt_succ_of_lt hlt))]; rfl
  | Or.inr hge => match Nat.eq_or_lt_of_le hge with
    | Or.inl e => by
        subst e
        show (decide (k ≤ k) && !decide (k = k)) = decide (k + 1 ≤ k)
        rw [decide_eq_true (Nat.le_refl k), decide_eq_true rfl, decide_eq_false (Nat.not_le_of_lt (Nat.lt_succ_self k))]; rfl
    | Or.inr hlt => by
        show (decide (k ≤ y) && !decide (k = y)) = decide (k + 1 ≤ y)
        have h1 : decide (k + 1 ≤ y) = true := decide_eq_true hlt
        rw [decide_eq_true (Nat.le_of_lt hlt), h1, decide_eq_false (fun e : k = y => Nat.lt_irrefl k (e ▸ hlt))]; rfl

/-- The search: below `k` some point is in the ultrafilter, or the tail `[k, n)` is. -/
theorem Ultra.search {n : Nat} (F : Ultra n) : ∀ k, (∃ x, x < k ∧ F.U (pt x) = true) ∨ F.U (above k) = true
  | 0 => Or.inr (F.congr (fun _ => true) (above 0) (fun _ _ => rfl) F.univ)
  | k + 1 =>
    match F.search k with
    | Or.inl ⟨x, hx, h⟩ => Or.inl ⟨x, Nat.lt_succ_of_lt hx, h⟩
    | Or.inr hk =>
      match F.ultra (pt k) with
      | Or.inl h => Or.inl ⟨k, Nat.lt_succ_self k, h⟩
      | Or.inr hc =>
        Or.inr (F.congr (fun y => above k y && !pt k y) (above (k + 1)) (fun y _ => above_succ k y)
          (F.inter (above k) (fun y => !pt k y) hk hc))

theorem and_not_self' (b : Bool) : (b && !b) = false := by cases b <;> rfl

/-- 5:E8 (every ultrafilter on a finite set is principal) — an ultrafilter on `[0, n)` holds a point `x`, and holds a
subset exactly when the subset holds `x`. -/
theorem ultra_principal {n : Nat} (F : Ultra n) : ∃ x, x < n ∧ ∀ A, F.U A = true ↔ A x = true :=
  match F.search n with
  | Or.inr h =>
    absurd (F.congr (above n) (fun _ => false) (fun y hy => decide_eq_false (Nat.not_le_of_lt hy)) h)
      (by rw [F.proper]; exact Bool.false_ne_true)
  | Or.inl ⟨x, hx, hpt⟩ => ⟨x, hx, fun A =>
    ⟨fun hA => match h : A x with
      | true => rfl
      | false =>
        have hc : F.U (fun y => !A y) = true :=
          F.up (pt x) (fun y => !A y) (fun y _ e => by
            have e' : x = y := of_decide_eq_true e
            rw [← e', h]; rfl) hpt
        have h0 : F.U (fun y => A y && !A y) = true := F.inter A (fun y => !A y) hA hc
        absurd (F.congr (fun y => A y && !A y) (fun _ => false) (fun y _ => and_not_self' (A y)) h0)
          (by rw [F.proper]; exact Bool.false_ne_true),
     fun hAx => F.up (pt x) A (fun y _ e => by have e' : x = y := of_decide_eq_true e; rw [← e']; exact hAx) hpt⟩⟩

end FRC.Sets

/-! inlined: FrcCore/Theme/Equivariant.lean -/

/-!
# The logic theme — equivariant choice: a section exists iff every stabiliser has a fixed point

5-reductio's Theorem equivariant-choice (5:E3), the Fraenkel–Mostowski mechanism in positive form, on the kernel alone
(21 October 2026): a group as a structure with its four laws, actions on an index type and on a fibre type, an
equivariant family `π : A → I`. On one orbit (a transitivity datum `tr i • i₀ = i`) an equivariant section exists
exactly when the stabiliser of the base point fixes a point of its fibre; over finitely many orbits, exactly when
every orbit's representative does. The hard direction defines the section by transport, `s i = tr i • a`, and shows
it well defined through the stabiliser. The paper's obstruction (5:E4): on the line over `𝔽₅` the map `v ↦ −v`
fixes no basis vector, over `𝔽₂` it fixes `1`. No Mathlib, no axioms.
-/

namespace FRC.Equivariant

/-- A group: carrier `G`, the operation, the unit, the inverse, the laws. -/
structure Group (G : Type) where
  mul : G → G → G
  one : G
  inv : G → G
  mul_assoc : ∀ a b c, mul (mul a b) c = mul a (mul b c)
  one_mul : ∀ a, mul one a = a
  mul_one : ∀ a, mul a one = a
  inv_mul : ∀ a, mul (inv a) a = one
  mul_inv : ∀ a, mul a (inv a) = one

/-- An action of the group on `X`. -/
structure Action {G : Type} (Γ : Group G) (X : Type) where
  act : G → X → X
  one_act : ∀ x, act Γ.one x = x
  mul_act : ∀ g h x, act (Γ.mul g h) x = act g (act h x)

variable {G I A : Type} {Γ : Group G}

/-- The family `π : A → I` is equivariant: `π (g • a) = g • π a`. -/
def Equivariant (ρI : Action Γ I) (ρA : Action Γ A) (π : A → I) : Prop :=
  ∀ g a, π (ρA.act g a) = ρI.act g (π a)

/-- `s` is a section of `π`. -/
def IsSection (π : A → I) (s : I → A) : Prop := ∀ i, π (s i) = i

/-- `s : I → A` is an equivariant map: `s (g • i) = g • s i`. -/
def EquivariantMap (ρI : Action Γ I) (ρA : Action Γ A) (s : I → A) : Prop :=
  ∀ g i, s (ρI.act g i) = ρA.act g (s i)

/-- `g` lies in the stabiliser of `i₀`. -/
def Stab (ρI : Action Γ I) (i₀ : I) (g : G) : Prop := ρI.act g i₀ = i₀

/-- 5:E3 (Theorem equivariant-choice, ⇒) — an equivariant section picks, at every point `i₀`, a point of the fibre
fixed by the stabiliser of `i₀`: `g • i₀ = i₀` gives `g • s i₀ = s (g • i₀) = s i₀`. -/
theorem fixed_point_of_section (ρI : Action Γ I) (ρA : Action Γ A) (π : A → I) (s : I → A)
    (hs : IsSection π s) (he : EquivariantMap ρI ρA s) (i₀ : I) :
    π (s i₀) = i₀ ∧ ∀ g, Stab ρI i₀ g → ρA.act g (s i₀) = s i₀ :=
  ⟨hs i₀, fun g hg => by rw [← he g i₀]; exact congrArg s hg⟩

theorem Group.inv_mul_cancel_left (Γ : Group G) (a b : G) : Γ.mul a (Γ.mul (Γ.inv a) b) = b := by
  rw [← Γ.mul_assoc, Γ.mul_inv, Γ.one_mul]

/-- The transport datum undone: `tr j⁻¹ • j = i₀`. -/
theorem act_inv_tr (ρI : Action Γ I) (i₀ : I) (tr : I → G) (htr : ∀ i, ρI.act (tr i) i₀ = i) (j : I) :
    ρI.act (Γ.inv (tr j)) j = i₀ :=
  calc ρI.act (Γ.inv (tr j)) j = ρI.act (Γ.inv (tr j)) (ρI.act (tr j) i₀) := by rw [htr j]
    _ = i₀ := by rw [← ρI.mul_act, Γ.inv_mul, ρI.one_act]

/-- 5:E3 (Theorem equivariant-choice, ⇐, one orbit) — on a transitive index set, given the transport datum
`tr i • i₀ = i`, a point `a` of the fibre over `i₀` fixed by the stabiliser of `i₀` yields the equivariant section
`s i = tr i • a`: it is a section since `π (tr i • a) = tr i • i₀ = i`, and equivariant since
`tr (g • i)⁻¹ · g · tr i` stabilises `i₀` and so fixes `a`. -/
theorem section_of_fixed_point (ρI : Action Γ I) (ρA : Action Γ A) (π : A → I)
    (hπ : Equivariant ρI ρA π) (i₀ : I) (tr : I → G) (htr : ∀ i, ρI.act (tr i) i₀ = i)
    (a : A) (ha : π a = i₀) (hfix : ∀ g, Stab ρI i₀ g → ρA.act g a = a) :
    ∃ s, IsSection π s ∧ EquivariantMap ρI ρA s :=
  ⟨fun i => ρA.act (tr i) a,
   fun i => by rw [hπ, ha, htr],
   fun g i => by
     -- h = tr (g • i)⁻¹ · (g · tr i) stabilises i₀
     have hstab : Stab ρI i₀ (Γ.mul (Γ.inv (tr (ρI.act g i))) (Γ.mul g (tr i))) := by
       show ρI.act (Γ.mul (Γ.inv (tr (ρI.act g i))) (Γ.mul g (tr i))) i₀ = i₀
       rw [ρI.mul_act, ρI.mul_act, htr i]; exact act_inv_tr ρI i₀ tr htr (ρI.act g i)
     have e := hfix _ hstab
     show ρA.act (tr (ρI.act g i)) a = ρA.act g (ρA.act (tr i) a)
     rw [← ρA.mul_act]
     -- g · tr i = tr (g • i) · h
     have e2 : Γ.mul g (tr i) = Γ.mul (tr (ρI.act g i)) (Γ.mul (Γ.inv (tr (ρI.act g i))) (Γ.mul g (tr i))) :=
       (Γ.inv_mul_cancel_left _ _).symm
     rw [e2, ρA.mul_act, e]⟩

/-- 5:E3 (Theorem equivariant-choice, one orbit) — on a transitive index set an equivariant section exists exactly
when the stabiliser of the base point fixes a point of its fibre. -/
theorem equivariant_section_iff (ρI : Action Γ I) (ρA : Action Γ A) (π : A → I)
    (hπ : Equivariant ρI ρA π) (i₀ : I) (tr : I → G) (htr : ∀ i, ρI.act (tr i) i₀ = i) :
    (∃ s, IsSection π s ∧ EquivariantMap ρI ρA s) ↔ ∃ a, π a = i₀ ∧ ∀ g, Stab ρI i₀ g → ρA.act g a = a :=
  ⟨fun ⟨s, hs, he⟩ => ⟨s i₀, fixed_point_of_section ρI ρA π s hs he i₀⟩,
   fun ⟨a, ha, hfix⟩ => section_of_fixed_point ρI ρA π hπ i₀ tr htr a ha hfix⟩

/-- 5:E3 (Theorem equivariant-choice, finitely many orbits) — with a representative `rep i` of every orbit, constant
on orbits, and the transport `tr i • rep i = i`, an equivariant section exists exactly when every representative's
stabiliser fixes a point of its fibre, the choice `a` of fixed points being itself constant on orbits. -/
theorem equivariant_section_orbits (ρI : Action Γ I) (ρA : Action Γ A) (π : A → I)
    (hπ : Equivariant ρI ρA π) (rep : I → I) (hrep : ∀ g i, rep (ρI.act g i) = rep i)
    (tr : I → G) (htr : ∀ i, ρI.act (tr i) (rep i) = i) :
    (∃ s, IsSection π s ∧ EquivariantMap ρI ρA s) ↔
      ∃ a : I → A, (∀ g i, a (ρI.act g i) = a i) ∧ ∀ i, π (a i) = rep i ∧ ∀ g, Stab ρI (rep i) g → ρA.act g (a i) = a i :=
  ⟨fun ⟨s, hs, he⟩ => ⟨fun i => s (rep i), fun g i => by show s (rep (ρI.act g i)) = s (rep i); rw [hrep],
     fun i => fixed_point_of_section ρI ρA π s hs he (rep i)⟩,
   fun ⟨a, hconst, hfix⟩ =>
    ⟨fun i => ρA.act (tr i) (a i),
     fun i => by rw [hπ, (hfix i).1, htr],
     fun g i => by
       have hstab : Stab ρI (rep i) (Γ.mul (Γ.inv (tr (ρI.act g i))) (Γ.mul g (tr i))) := by
         show ρI.act (Γ.mul (Γ.inv (tr (ρI.act g i))) (Γ.mul g (tr i))) (rep i) = rep i
         have h1 : ρI.act (tr (ρI.act g i)) (rep i) = ρI.act g i := by
           have := htr (ρI.act g i); rwa [hrep] at this
         rw [ρI.mul_act, ρI.mul_act, htr i]
         calc ρI.act (Γ.inv (tr (ρI.act g i))) (ρI.act g i)
             = ρI.act (Γ.inv (tr (ρI.act g i))) (ρI.act (tr (ρI.act g i)) (rep i)) := by rw [h1]
           _ = rep i := by rw [← ρI.mul_act, Γ.inv_mul, ρI.one_act]
       have e := (hfix i).2 _ hstab
       show ρA.act (tr (ρI.act g i)) (a (ρI.act g i)) = ρA.act g (ρA.act (tr i) (a i))
       rw [hconst, ← ρA.mul_act]
       have e2 : Γ.mul g (tr i) = Γ.mul (tr (ρI.act g i)) (Γ.mul (Γ.inv (tr (ρI.act g i))) (Γ.mul g (tr i))) :=
         (Γ.inv_mul_cancel_left _ _).symm
       rw [e2, ρA.mul_act, e]⟩⟩

/-! ### 5:E4 — the equivariant obstruction on `𝔽₅` (moved from the paper module, 21 October 2026) -/

/-- 5:E4 (Example basis-obstruction) — on the line over `𝔽₅` the map `v ↦ −v` fixes no basis: `−v ≠ v` for every
`v ≠ 0`; over `𝔽₂` it fixes `1`, so the obstruction is arithmetic. -/
theorem obstruction_five :
    (-(1 : FRC.Shell 5) ≠ 1) ∧ (-(2 : FRC.Shell 5) ≠ 2) ∧ (-(3 : FRC.Shell 5) ≠ 3) ∧ (-(4 : FRC.Shell 5) ≠ 4) ∧
      (-(1 : FRC.Shell 2) = 1) := by
  decide

end FRC.Equivariant



/-! inlined: FrcCore/Theme/Transfer.lean -/

/-!
# The logic theme — the transfer digraph: walks of every length give a periodic walk

5-reductio's Theorem periodic-dbe (5:E6), the one-dimensional periodic de Bruijn–Erdős theorem, at the level of its
transfer digraph (21 October 2026): a finite digraph on `[0, n)` in which walks of every finite length exist has a
vertex that begins walks of every length, every such vertex has a successor of the same kind, and the greedy walk
inside that sub-digraph (the least good successor at each step) is eventually periodic with period at most `n`
(5:E5's pigeonhole, `repeat_below`). A proper colouring of `k` consecutive blocks of a periodic graph is a walk of
length `k − 1` in its transfer digraph, so the periodic walk is a periodic proper colouring; that passage is the
body's modelling and rests there. No Mathlib, no axioms: the stabilisation of the decreasing sets of good vertices
is proved by counting, and the periodic walk is built by bounded search.
-/

namespace FRC.Transfer

open FRC.Logic FRC.Reach

/-- `walks edge n v k`: in the digraph on `[0, n)` with edge relation `edge`, the vertex `v` begins a walk of `k`
edges. -/
def walks (edge : Nat → Nat → Bool) (n : Nat) (v : Nat) : Nat → Bool
  | 0 => true
  | k + 1 => anyBelow (fun w => edge v w && walks edge n w k) n

variable {edge : Nat → Nat → Bool} {n : Nat}

theorem walks_succ_iff (v k : Nat) :
    walks edge n v (k + 1) = true ↔ ∃ w, w < n ∧ edge v w = true ∧ walks edge n w k = true :=
  Iff.trans (anyBelow_true_iff _ n)
    ⟨fun ⟨w, hw, h⟩ => ⟨w, hw, band_l h, band_r h⟩, fun ⟨w, hw, h1, h2⟩ => ⟨w, hw, by rw [h1, h2]; rfl⟩⟩

/-- A walk of `k + 1` edges contains one of `k`. -/
theorem walks_of_succ (v : Nat) : ∀ k, walks edge n v (k + 1) = true → walks edge n v k = true
  | 0, _ => rfl
  | k + 1, h => by
    match (walks_succ_iff v (k + 1)).mp h with
    | ⟨w, hw, he, hk⟩ => exact (walks_succ_iff v k).mpr ⟨w, hw, he, walks_of_succ w k hk⟩

theorem walks_mono (v : Nat) : ∀ j k, j ≤ k → walks edge n v k = true → walks edge n v j = true
  | j, k, hjk, h => by
    match Nat.eq_or_lt_of_le hjk with
    | Or.inl e => exact e ▸ h
    | Or.inr hlt =>
      match k, hlt with
      | k' + 1, hlt' => exact walks_mono v j k' (Nat.le_of_lt_succ hlt') (walks_of_succ v k' h)

/-! ### The sets of good vertices decrease and stabilise -/

/-- The number of vertices below `n` that begin a walk of `k` edges. -/
def goodCount (edge : Nat → Nat → Bool) (n k : Nat) : Nat := count (fun v => walks edge n v k) n

theorem count_le_of_imp (f g : Nat → Bool) : ∀ m, (∀ x, x < m → f x = true → g x = true) → count f m ≤ count g m
  | 0, _ => Nat.le_refl 0
  | m + 1, h => by
    show count f m + cond (f m) 1 0 ≤ count g m + cond (g m) 1 0
    have ih := count_le_of_imp f g m (fun x hx => h x (Nat.lt_succ_of_lt hx))
    exact match hf : f m with
      | false => Nat.le_trans (Nat.add_le_add_right ih 0) (Nat.add_le_add_left (Nat.zero_le _) _)
      | true => by rw [h m (Nat.lt_succ_self m) hf]; exact Nat.add_le_add_right ih 1

theorem count_le (f : Nat → Bool) : ∀ m, count f m ≤ m
  | 0 => Nat.le_refl 0
  | m + 1 => by
    show count f m + cond (f m) 1 0 ≤ m + 1
    exact match f m with
      | true => Nat.add_le_add_right (count_le f m) 1
      | false => Nat.le_succ_of_le (count_le f m)

/-- Equal counts of nested predicates: the smaller one holds wherever the larger does. -/
theorem eq_of_count_eq (f g : Nat → Bool) : ∀ m, (∀ x, x < m → f x = true → g x = true) → count f m = count g m →
    ∀ x, x < m → g x = true → f x = true
  | 0, _, _, x, hx, _ => absurd hx (Nat.not_lt_zero x)
  | m + 1, h, e, x, hx, hg => by
    have h' : ∀ x, x < m → f x = true → g x = true := fun x hx => h x (Nat.lt_succ_of_lt hx)
    have ih := count_le_of_imp f g m h'
    have e' : count f m + cond (f m) 1 0 = count g m + cond (g m) 1 0 := e
    match Nat.lt_or_ge x m with
    | Or.inl hxm =>
      -- the last position agrees or f m = false ≤ g m; either way the counts below m are equal
      have em : count f m = count g m := by
        match hf : f m with
        | true =>
          rw [hf, h m (Nat.lt_succ_self m) hf] at e'
          exact Nat.add_right_cancel e'
        | false =>
          rw [hf] at e'
          exact match hgm : g m with
            | false => by rw [hgm] at e'; exact Nat.add_right_cancel e'
            | true => by
                rw [hgm] at e'
                exact absurd e' (Nat.ne_of_lt (Nat.lt_of_le_of_lt (Nat.add_le_add_right ih 0) (Nat.lt_succ_self _)))
      exact eq_of_count_eq f g m h' em x hxm hg
    | Or.inr hxm =>
      have ex : x = m := Nat.le_antisymm (Nat.le_of_lt_succ hx) hxm
      subst ex
      exact match hf : f x with
        | true => rfl
        | false => by
            rw [hf, hg] at e'
            exact absurd e' (Nat.ne_of_lt (Nat.lt_of_le_of_lt (Nat.add_le_add_right ih 0) (Nat.lt_succ_self _)))

/-- The good sets decrease: `goodCount (k+1) ≤ goodCount k`. -/
theorem goodCount_succ_le (k : Nat) : goodCount edge n (k + 1) ≤ goodCount edge n k :=
  count_le_of_imp _ _ n (fun v _ h => walks_of_succ v k h)

theorem goodCount_le_of_le : ∀ j k, j ≤ k → goodCount edge n k ≤ goodCount edge n j
  | j, k, hjk => count_le_of_imp _ _ n (fun v _ h => walks_mono v j k hjk h)

/-- When the good set stops shrinking it is stationary: `goodCount k₀ = goodCount (k₀+1)` gives
`walks v k₀ → walks v k` for every `k`. -/
theorem stationary (k₀ : Nat) (e : goodCount edge n k₀ = goodCount edge n (k₀ + 1)) :
    ∀ k, ∀ v, v < n → walks edge n v k₀ = true → walks edge n v k = true := by
  -- step: the (k₀+1)-good are exactly the k₀-good; then (k₀+2)-good = successors into k₀-good ∩ … by induction
  have back : ∀ v, v < n → walks edge n v k₀ = true → walks edge n v (k₀ + 1) = true :=
    eq_of_count_eq (fun v => walks edge n v (k₀ + 1)) (fun v => walks edge n v k₀) n
      (fun v _ h => walks_of_succ v k₀ h) e.symm
  have up : ∀ m, ∀ v, v < n → walks edge n v k₀ = true → walks edge n v (k₀ + m) = true := by
    intro m
    induction m with
    | zero => exact fun v _ h => h
    | succ m ih =>
      intro v hv h
      match (walks_succ_iff v k₀).mp (back v hv h) with
      | ⟨w, hw, he, hk⟩ => exact (walks_succ_iff v (k₀ + m)).mpr ⟨w, hw, he, ih w hw hk⟩
  intro k v hv h
  match Nat.lt_or_ge k k₀ with
  | Or.inl hlt => exact walks_mono v k k₀ (Nat.le_of_lt hlt) h
  | Or.inr hge =>
    have : k = k₀ + (k - k₀) := (FRC.Nat.add_sub_of_le hge).symm
    rw [this]; exact up (k - k₀) v hv h

/-- Among `k = 0, …, n` the decreasing counts, all at most `n`, repeat: some `k₀ ≤ n` is stationary. -/
theorem exists_stationary : ∃ k₀, k₀ ≤ n ∧ goodCount edge n k₀ = goodCount edge n (k₀ + 1) := by
  -- otherwise the counts drop strictly at every step below n + 1, so goodCount (n+1) + (n+1) ≤ goodCount 0 ≤ n
  have drop : ∀ m, (∀ k, k < m → goodCount edge n k ≠ goodCount edge n (k + 1)) →
      goodCount edge n m + m ≤ goodCount edge n 0 := by
    intro m
    induction m with
    | zero => exact fun _ => Nat.le_refl _
    | succ m ih =>
      intro h
      have ih' := ih (fun k hk => h k (Nat.lt_succ_of_lt hk))
      have hlt : goodCount edge n (m + 1) < goodCount edge n m :=
        Nat.lt_of_le_of_ne (goodCount_succ_le m) (fun e => h m (Nat.lt_succ_self m) e.symm)
      show goodCount edge n (m + 1) + (m + 1) ≤ goodCount edge n 0
      have h3 : goodCount edge n (m + 1) + (m + 1) ≤ goodCount edge n m + m := by
        rw [← Nat.add_assoc, Nat.add_right_comm]
        exact Nat.add_le_add_right (Nat.succ_le_of_lt hlt) m
      exact Nat.le_trans h3 ih'
  have dec : Decidable (∃ k, k < n + 1 ∧ goodCount edge n k = goodCount edge n (k + 1)) :=
    FRC.Shell.decExistsLT (fun k => goodCount edge n k = goodCount edge n (k + 1)) (n + 1)
  match dec with
  | isTrue ⟨k, hk, e⟩ => exact ⟨k, Nat.le_of_lt_succ hk, e⟩
  | isFalse hne =>
    exfalso
    have hall : ∀ k, k < n + 1 → goodCount edge n k ≠ goodCount edge n (k + 1) :=
      fun k hk e => hne ⟨k, hk, e⟩
    have h1 := drop (n + 1) hall
    have h2 : goodCount edge n 0 ≤ n := count_le _ n
    exact Nat.lt_irrefl (n + 1) (Nat.lt_of_le_of_lt (Nat.le_trans (Nat.le_add_left (n + 1) _) h1) (Nat.lt_succ_of_le h2))

/-! ### A vertex good for every length, and a good successor -/

/-- `allGood v`: `v` begins walks of every length. -/
def AllGood (edge : Nat → Nat → Bool) (n v : Nat) : Prop := ∀ k, walks edge n v k = true

/-- 5:E6 (Theorem periodic-dbe, the sub-digraph is nonempty) — if walks of every length exist, some vertex begins
walks of every length: the good sets decrease and stabilise, and a vertex of the stationary set is good for ever. -/
theorem exists_allGood (h : ∀ k, ∃ v, v < n ∧ walks edge n v k = true) : ∃ v, v < n ∧ AllGood edge n v :=
  match exists_stationary (edge := edge) (n := n) with
  | ⟨k₀, _, e⟩ => match h k₀ with
    | ⟨v, hv, hk⟩ => ⟨v, hv, fun k => stationary k₀ e k v hv hk⟩

/-- 5:E6 (Theorem periodic-dbe, out-degree one in the sub-digraph) — a vertex good for every length has a successor
good for every length. -/
theorem allGood_successor {v : Nat} (_hv : v < n) (hg : AllGood edge n v) :
    ∃ w, w < n ∧ edge v w = true ∧ AllGood edge n w :=
  match exists_stationary (edge := edge) (n := n) with
  | ⟨k₀, _, e⟩ => match (walks_succ_iff v k₀).mp (hg (k₀ + 1)) with
    | ⟨w, hw, he, hk⟩ => ⟨w, hw, he, fun k => stationary k₀ e k w hw hk⟩

/-! ### The greedy walk in the sub-digraph and its period -/

/-- The stationary length, by bounded search (`exists_stationary` gives it below `n + 1`). -/
def stationaryIndex (edge : Nat → Nat → Bool) (n : Nat) : Nat :=
  match leastBelow (fun k => decide (goodCount edge n k = goodCount edge n (k + 1))) (n + 1) with
  | some k => k
  | none => 0

theorem stationaryIndex_spec : goodCount edge n (stationaryIndex edge n) = goodCount edge n (stationaryIndex edge n + 1) :=
  match exists_stationary (edge := edge) (n := n) with
  | ⟨k₀, hk₀, e⟩ => by
    unfold stationaryIndex
    match hl : leastBelow (fun k => decide (goodCount edge n k = goodCount edge n (k + 1))) (n + 1) with
    | some k => exact of_decide_eq_true (leastBelow_spec _ (n + 1) k hl).2.1
    | none =>
      exfalso
      match leastBelow_some (fun k => decide (goodCount edge n k = goodCount edge n (k + 1))) (n + 1) k₀
          (Nat.lt_succ_of_le hk₀) (decide_eq_true e) with
      | ⟨y, hy⟩ => rw [hl] at hy; exact nomatch hy

/-- `good v`: `v` is good at the stationary length, hence for every length. -/
def good (edge : Nat → Nat → Bool) (n : Nat) (v : Nat) : Bool := walks edge n v (stationaryIndex edge n)

theorem allGood_of_good {v : Nat} (hv : v < n) (h : good edge n v = true) : AllGood edge n v :=
  fun k => stationary (stationaryIndex edge n) stationaryIndex_spec k v hv h

/-- The greedy step: the least good successor of `v`, or `v` itself when there is none (never, on good vertices). -/
def next (edge : Nat → Nat → Bool) (n : Nat) (v : Nat) : Nat :=
  match leastBelow (fun w => edge v w && good edge n w) n with
  | some w => w
  | none => v

theorem next_spec {v : Nat} (hv : v < n) (hg : good edge n v = true) :
    next edge n v < n ∧ edge v (next edge n v) = true ∧ good edge n (next edge n v) = true := by
  match allGood_successor hv (allGood_of_good hv hg) with
  | ⟨w, hw, he, hwg⟩ =>
    have hP : (edge v w && good edge n w) = true := by
      have hgw : good edge n w = true := hwg (stationaryIndex edge n)
      rw [he, hgw]; rfl
    unfold next
    match hl : leastBelow (fun w => edge v w && good edge n w) n with
    | some u =>
      have s := leastBelow_spec _ n u hl
      exact ⟨s.1, band_l s.2.1, band_r s.2.1⟩
    | none =>
      exfalso
      match leastBelow_some (fun w => edge v w && good edge n w) n w hw hP with
      | ⟨y, hy⟩ => rw [hl] at hy; exact nomatch hy

theorem next_lt {v : Nat} (hv : v < n) (hg : good edge n v = true) : next edge n v < n := (next_spec hv hg).1

/-- The greedy walk from a good vertex stays good. -/
theorem iter_good {v : Nat} (hv : v < n) (hg : good edge n v = true) :
    ∀ k, iter (next edge n) v k < n ∧ good edge n (iter (next edge n) v k) = true
  | 0 => ⟨hv, hg⟩
  | k + 1 =>
    have ih := iter_good hv hg k
    have s := next_spec ih.1 ih.2
    ⟨s.1, s.2.2⟩

/-- The greedy step on good vertices and the identity elsewhere, so that it maps `[0, n)` into itself. -/
def nextGood (edge : Nat → Nat → Bool) (n : Nat) (y : Nat) : Nat := cond (good edge n y) (next edge n y) y

theorem nextGood_lt {y : Nat} (hy : y < n) : nextGood edge n y < n := by
  unfold nextGood
  cases hgy : good edge n y
  · exact hy
  · exact next_lt hy hgy

theorem iterGood {v : Nat} (hv : v < n) (hg : good edge n v = true) :
    ∀ j, good edge n (iter (nextGood edge n) v j) = true ∧ iter (nextGood edge n) v j < n
  | 0 => ⟨hg, hv⟩
  | j + 1 => by
    have ih := iterGood hv hg j
    show good edge n (nextGood edge n (iter (nextGood edge n) v j)) = true ∧ nextGood edge n (iter (nextGood edge n) v j) < n
    have e : nextGood edge n (iter (nextGood edge n) v j) = next edge n (iter (nextGood edge n) v j) := by
      show cond (good edge n (iter (nextGood edge n) v j)) (next edge n (iter (nextGood edge n) v j))
          (iter (nextGood edge n) v j) = next edge n (iter (nextGood edge n) v j)
      rw [ih.1]; rfl
    rw [e]
    exact ⟨(next_spec ih.2 ih.1).2.2, (next_spec ih.2 ih.1).1⟩

theorem iterGood_edge {v : Nat} (hv : v < n) (hg : good edge n v = true) (k : Nat) :
    edge (iter (nextGood edge n) v k) (iter (nextGood edge n) v (k + 1)) = true := by
  have gk := iterGood hv hg k
  show edge (iter (nextGood edge n) v k) (nextGood edge n (iter (nextGood edge n) v k)) = true
  have e : nextGood edge n (iter (nextGood edge n) v k) = next edge n (iter (nextGood edge n) v k) := by
    show cond (good edge n (iter (nextGood edge n) v k)) (next edge n (iter (nextGood edge n) v k))
        (iter (nextGood edge n) v k) = next edge n (iter (nextGood edge n) v k)
    rw [gk.1]; rfl
  rw [e]
  exact (next_spec gk.2 gk.1).2.1

/-- 5:E6 (Theorem periodic-dbe, the periodic walk) — if the digraph on `[0, n)` has walks of every length, it has an
infinite walk `w` that is periodic with period `m`, `1 ≤ m ≤ n`: every step is an edge and `w (i + m) = w i`. The
walk is the greedy walk in the sub-digraph of vertices good for every length, read from its first return. -/
theorem periodic_walk (h : ∀ k, ∃ v, v < n ∧ walks edge n v k = true) :
    ∃ w : Nat → Nat, ∃ m, 0 < m ∧ m ≤ n ∧ (∀ i, w i < n) ∧ (∀ i, edge (w i) (w (i + 1)) = true) ∧ ∀ i, w (i + m) = w i :=
  match exists_allGood h with
  | ⟨v, hv, hg⟩ =>
    have hgood : good edge n v = true := hg _
    have hstep : ∀ y, y < n → nextGood edge n y < n := fun y hy => nextGood_lt hy
    match eventually_periodic (nextGood edge n) n hstep v hv with
    | ⟨i₀, p, hp, hpn, hper⟩ =>
      ⟨fun i => iter (nextGood edge n) v (i₀ + i), p, hp, hpn,
       fun i => iter_lt _ hstep hv _,
       fun i => by
         show edge (iter (nextGood edge n) v (i₀ + i)) (iter (nextGood edge n) v (i₀ + (i + 1))) = true
         rw [← Nat.add_assoc]
         exact iterGood_edge hv hgood (i₀ + i),
       fun i => by
         show iter (nextGood edge n) v (i₀ + (i + p)) = iter (nextGood edge n) v (i₀ + i)
         rw [← Nat.add_assoc]; exact hper i⟩

end FRC.Transfer


/-! inlined: FrcCore/Theme/Field.lean -/

/-!
# FrcCore.Theme.Field — the prime shell is a field, without a generator (the foundation theme, tasks LM22 and LM24)

The shell `𝔽_p` of a prime `p` (`FRC.Nat.isPrime`, trial division), with no drive assumed, on `Series.lean` and
`Poly.lean` alone: Euclid's lemma; no zero divisors, cancellation and the square roots of one; Fermat's
little theorem by the permutation `x ↦ a x` of the nonzero residues (`prod_perm`); the roots of `x^m − 1`, bounded by
the degree, so some residue escapes `x^m = 1` for `m < p − 1`; hence a residue `a` with `a^{(p−1)/2} = −1`, and the
quarter-turn criterion: `x² = −1` is solvable iff `p ≡ 1 (mod 4)`, with `ħ = a^S` on `p = 4S + 1`; a shell without
zero divisors is prime; and the chart `p = 4S + 1`: the octant sector, the half-square and the parity flip. Task LM24
split this file from `Theme/Foundation.lean` under the size budget (G10), so that the programme themes take the field
without the foundation's rows; every name is unchanged. No axioms.
-/

namespace FRC

namespace Nat

theorem mod_eq_zero_of_add {a r p : Nat} (hp : 0 < p) (h : (a + r) % p = 0) (ha : a % p = 0) : r % p = 0 := by
  rw [FRC.Nat.add_mod _ _ _ hp, ha, Nat.zero_add, FRC.Nat.mod_mod _ _ hp] at h
  exact h

theorem mul_mod_eq_zero_left {a b p : Nat} (hp : 0 < p) (ha : a % p = 0) : (a * b) % p = 0 := by
  rw [FRC.Nat.mul_mod_left' _ _ _ hp, ha, Nat.zero_mul]; rfl

/-- Euclid's lemma, the step: for a prime `p` and `p ∤ b`, no `k` with `0 < k < p` has `p ∣ k b`. If `p ∣ k b` with
`2 ≤ k`, write `p = q k + r`: `p ∤ k` gives `0 < r < k`, and `r b = p b − q (k b)` is again divisible by `p`. -/
theorem prime_not_dvd_mul_aux {p b : Nat} (hp : isPrime p) (hb : b % p ≠ 0) :
    ∀ n k, k < n → 0 < k → k < p → (k * b) % p ≠ 0 := by
  have hp0 : 0 < p := Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) hp.1
  intro n
  induction n with
  | zero => intro k hk; exact absurd hk (Nat.not_lt_zero k)
  | succ n ih =>
    intro k hk hk0 hkp hkb
    match k, hk, hk0, hkp, hkb with
    | 0, _, hk0, _, _ => exact absurd hk0 (Nat.lt_irrefl 0)
    | 1, _, _, _, hkb => rw [Nat.one_mul] at hkb; exact hb hkb
    | k + 2, hk, _, hkp, hkb =>
      have hk2 : 0 < k + 2 := Nat.zero_lt_succ _
      have hpk : p % (k + 2) ≠ 0 := hp.2 (k + 2) hkp (Nat.le_add_left 2 k)
      obtain ⟨q, hq⟩ := FRC.Nat.mod_spec (k + 2) hk2 p
      have hr : p % (k + 2) < k + 2 := Nat.mod_lt _ hk2
      have e : p * b = (k + 2) * b * q + p % (k + 2) * b := by
        calc p * b = ((k + 2) * q + p % (k + 2)) * b := by rw [← hq]
          _ = (k + 2) * q * b + p % (k + 2) * b := FRC.Nat.add_mul _ _ _
          _ = (k + 2) * b * q + p % (k + 2) * b := by
              rw [FRC.Nat.mul_assoc, Nat.mul_comm q b, ← FRC.Nat.mul_assoc]
      have hpb : (p * b) % p = 0 := mul_mod_eq_zero_left hp0 (FRC.Nat.mod_self p hp0)
      have hA : ((k + 2) * b * q) % p = 0 := mul_mod_eq_zero_left hp0 hkb
      have hR : (p % (k + 2) * b) % p = 0 := mod_eq_zero_of_add hp0 (e ▸ hpb) hA
      exact ih (p % (k + 2)) (Nat.lt_of_lt_of_le hr (Nat.le_of_lt_succ hk)) (Nat.pos_of_ne_zero hpk)
        (Nat.lt_trans hr hkp) hR

/-- Euclid's lemma: a prime dividing a product divides a factor. -/
theorem prime_mul_mod {p a b : Nat} (hp : isPrime p) (h : (a * b) % p = 0) : a % p = 0 ∨ b % p = 0 := by
  have hp0 : 0 < p := Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) hp.1
  match Nat.decEq (b % p) 0 with
  | .isTrue hb => exact .inr hb
  | .isFalse hb =>
    match Nat.decEq (a % p) 0 with
    | .isTrue ha => exact .inl ha
    | .isFalse ha =>
      have h' : (a % p * b) % p = 0 := by rw [FRC.Nat.mod_mul_mod _ _ _ hp0]; exact h
      exact absurd h' (prime_not_dvd_mul_aux hp hb (a % p + 1) (a % p) (Nat.lt_succ_self _)
        (Nat.pos_of_ne_zero ha) (Nat.mod_lt _ hp0))

/-- `d ∣ n` iff `n % d = 0`. -/
theorem dvd_iff_mod {d n : Nat} (hd : 0 < d) : d ∣ n ↔ n % d = 0 :=
  ⟨fun ⟨c, hc⟩ => FRC.Nat.mod_unique hd (by rw [Nat.add_zero]; exact hc),
   fun h => match FRC.Nat.mod_spec d hd n with
     | ⟨q, hq⟩ => ⟨q, by rw [h, Nat.add_zero] at hq; exact hq⟩⟩

/-- Parity: `n % 2` is `0` or `1`. -/
theorem mod_two_cases (n : Nat) : n % 2 = 0 ∨ n % 2 = 1 := by
  have h := Nat.mod_lt n (Nat.zero_lt_succ 1)
  match n % 2, h with
  | 0, _ => exact .inl rfl
  | 1, _ => exact .inr rfl
  | k + 2, h => exact absurd h (Nat.not_lt_of_le (Nat.le_add_left 2 k))

theorem succ_lt_of_lt_pred {j n : Nat} (h : j < n - 1) : j + 1 < n := by
  match n, h with
  | 0, h => exact absurd h (Nat.not_lt_zero j)
  | n + 1, h => rw [FRC.Nat.add_sub_cancel] at h; exact Nat.succ_lt_succ h

theorem pred_lt_pred {v n : Nat} (hv : 0 < v) (h : v < n) : v - 1 < n - 1 := by
  match v, n, hv, h with
  | 0, _, hv, _ => exact absurd hv (Nat.lt_irrefl 0)
  | v + 1, 0, _, h => exact absurd h (Nat.not_lt_zero _)
  | v + 1, n + 1, _, h => rw [FRC.Nat.add_sub_cancel, FRC.Nat.add_sub_cancel]; exact Nat.lt_of_succ_lt_succ h

theorem eq_of_pred_eq {u v : Nat} (hu : 0 < u) (hv : 0 < v) (h : u - 1 = v - 1) : u = v := by
  rw [← FRC.Nat.sub_add_cancel hu, ← FRC.Nat.sub_add_cancel hv, h]

/-- An odd number is no sum of two numbers of equal parity. -/
theorem parity_split {a b n : Nat} (h : a + b = 2 * n + 1) : a % 2 = 0 ↔ ¬ b % 2 = 0 := by
  have h2 : (0 : Nat) < 2 := Nat.zero_lt_succ 1
  have hodd : (a + b) % 2 = 1 := by rw [h, FRC.Nat.add_mul_mod_self_left 1 n 2 h2]
  rw [FRC.Nat.add_mod _ _ _ h2] at hodd
  constructor
  · intro ha hb; rw [ha, hb] at hodd; exact absurd hodd (by decide)
  · intro hb
    match mod_two_cases a, mod_two_cases b with
    | .inl ha, _ => exact ha
    | .inr _, .inl hb' => exact absurd hb' hb
    | .inr ha, .inr hb' => rw [ha, hb'] at hodd; exact absurd hodd (by decide)

end Nat

namespace Shell

variable {p : Nat} [Pos p]

/-! ## The polynomial `X^n − 1` -/

namespace Poly

/-- `X^n − 1`, for `n ≥ 1`. -/
def xn1 (n : Nat) : Poly p := fun i => if i = n then 1 else if i = 0 then -1 else 0

theorem xn1_bound (n : Nat) : Bound (xn1 n : Poly p) n := fun i hi => by
  show (if i = n then 1 else if i = 0 then -1 else 0 : Shell p) = 0
  rw [ite_eq_right (Nat.ne_of_gt hi), ite_eq_right (Nat.ne_of_gt (Nat.lt_of_le_of_lt (Nat.zero_le n) hi))]

theorem xn1_top (n : Nat) : (xn1 n : Poly p) n = 1 := by
  show (if n = n then 1 else if n = 0 then -1 else 0 : Shell p) = 1
  rw [ite_eq_left rfl]

theorem eval_xn1 {n : Nat} (hn : 0 < n) (a : Shell p) : eval (xn1 n : Poly p) n a = a ^ n + -1 := by
  unfold eval
  rw [sumRange_succ, sum_eq_single hn (fun l hl hne => by
    show (if l = n then 1 else if l = 0 then -1 else 0 : Shell p) * a ^ l = 0
    rw [ite_eq_right (Nat.ne_of_lt hl), ite_eq_right hne, zero_mul])]
  show (if 0 = n then 1 else if 0 = 0 then -1 else 0 : Shell p) * a ^ 0 + xn1 n n * a ^ n = a ^ n + -1
  rw [ite_eq_right (Nat.ne_of_lt hn), ite_eq_left rfl, xn1_top, pow_zero, mul_one, one_mul, add_comm]

end Poly

namespace Prime

/-! ## The prime shell is a field: no zero divisors, cancellation, the square roots of one -/

omit [Pos p] in
theorem one_lt (hp : FRC.Nat.isPrime p) : 1 < p := hp.1

theorem one_ne_zero (hp : FRC.Nat.isPrime p) : (1 : Shell p) ≠ 0 := fun h => by
  have := val_injective h
  rw [val_one, val_zero, FRC.Nat.mod_eq_of_lt (one_lt hp)] at this
  exact Nat.noConfusion this

theorem eq_zero_of_val_mod {a : Shell p} (h : a.val % p = 0) : a = 0 :=
  ext (by rw [← FRC.Nat.mod_eq_of_lt a.lt]; exact h)

/-- No zero divisors on a prime shell (Euclid's lemma on the representatives). -/
theorem mul_eq_zero (hp : FRC.Nat.isPrime p) {a b : Shell p} (h : a * b = 0) : a = 0 ∨ b = 0 :=
  match FRC.Nat.prime_mul_mod hp (val_injective h) with
  | .inl ha => .inl (eq_zero_of_val_mod ha)
  | .inr hb => .inr (eq_zero_of_val_mod hb)

theorem mul_ne_zero (hp : FRC.Nat.isPrime p) {a b : Shell p} (ha : a ≠ 0) (hb : b ≠ 0) : a * b ≠ 0 :=
  fun h => match mul_eq_zero hp h with
    | .inl e => ha e
    | .inr e => hb e

theorem eq_of_sub_eq_zero {b c : Shell p} (e : b + -c = 0) : b = c :=
  calc b = b + 0 := (add_zero b).symm
    _ = b + (-c + c) := by rw [neg_add]
    _ = (b + -c) + c := (add_assoc _ _ _).symm
    _ = c := by rw [e, zero_add]

/-- Cancellation: `a b = a c` with `a ≠ 0` gives `b = c`. -/
theorem mul_left_cancel (hp : FRC.Nat.isPrime p) {a b c : Shell p} (ha : a ≠ 0) (h : a * b = a * c) : b = c := by
  have : a * (b + -c) = 0 := by rw [left_distrib, ← mul_neg, h, add_neg]
  match mul_eq_zero hp this with
  | .inl e => exact absurd e ha
  | .inr e => exact eq_of_sub_eq_zero e

/-- The square roots of a square are `±` its root: `x² = y²` gives `x = y` or `x = −y`. -/
theorem sq_eq_sq (hp : FRC.Nat.isPrime p) {x y : Shell p} (h : x * x = y * y) : x = y ∨ x = -y := by
  have e : (x + -y) * (x + y) = 0 := by
    rw [right_distrib, left_distrib, left_distrib, ← neg_mul, ← neg_mul, mul_comm y x, ← h,
      add_comm (-(x * y)) (-(x * x)), add_add_add_comm, add_neg, add_neg, add_zero]
  match mul_eq_zero hp e with
  | .inl e1 => exact .inl (eq_of_sub_eq_zero e1)
  | .inr e2 => exact .inr (eq_neg_of_add_eq_zero e2)

/-- The square roots of one are `±1`. -/
theorem sq_eq_one (hp : FRC.Nat.isPrime p) {x : Shell p} (h : x * x = 1) : x = 1 ∨ x = -1 :=
  sq_eq_sq hp (h.trans (mul_one 1).symm)

/-! ## Fermat's little theorem without a generator -/

theorem val_pos {a : Shell p} (h : a ≠ 0) : 0 < a.val := Nat.pos_of_ne_zero (fun e => h (ext e))

theorem ofNat_ne_zero {k : Nat} (hk0 : 0 < k) (hk : k < p) : (ofNat k : Shell p) ≠ 0 := fun h => by
  have := val_injective h
  rw [val_ofNat, val_zero, FRC.Nat.mod_eq_of_lt hk] at this
  exact Nat.ne_of_gt hk0 this

theorem prodRange_ne_zero (hp : FRC.Nat.isPrime p) {f : Nat → Shell p} :
    ∀ n, (∀ j, j < n → f j ≠ 0) → prodRange f n ≠ 0
  | 0, _ => one_ne_zero hp
  | n + 1, h => mul_ne_zero hp (prodRange_ne_zero hp n (fun j hj => h j (Nat.lt_succ_of_lt hj))) (h n (Nat.lt_succ_self n))

/-- The nonzero residues `1, …, p − 1`, indexed from `0`. -/
def nonzero (j : Nat) : Shell p := ofNat (j + 1)

/-- Where multiplication by `a` sends the `j`-th nonzero residue. -/
def nonzeroIndex (a : Shell p) (j : Nat) : Nat := (a * nonzero j).val - 1

theorem nonzero_ne_zero {j : Nat} (hj : j < p - 1) : (nonzero j : Shell p) ≠ 0 :=
  ofNat_ne_zero (Nat.zero_lt_succ j) (FRC.Nat.succ_lt_of_lt_pred hj)

/-- Fermat's little theorem, generator-free: `a^{p−1} = 1` for `a ≠ 0`. Multiplication by `a` permutes the nonzero
residues, so `a^{p−1} · Π u = Π u`, and the product, nonzero, cancels. -/
theorem fermat (hp : FRC.Nat.isPrime p) {a : Shell p} (ha : a ≠ 0) : a ^ (p - 1) = 1 := by
  have hv : ∀ j, j < p - 1 → 0 < (a * nonzero j).val := fun j hj =>
    val_pos (mul_ne_zero hp ha (nonzero_ne_zero hj))
  have hlt : ∀ j, j < p - 1 → nonzeroIndex a j < p - 1 := fun j hj =>
    FRC.Nat.pred_lt_pred (hv j hj) (a * nonzero j).lt
  have hinj : ∀ i j, i < p - 1 → j < p - 1 → nonzeroIndex a i = nonzeroIndex a j → i = j := fun i j hi hj e => by
    have e2 : (nonzero i : Shell p) = nonzero j :=
      mul_left_cancel hp ha (ext (FRC.Nat.eq_of_pred_eq (hv i hi) (hv j hj) e))
    exact Nat.succ.inj (Poly.Frame.ofNat_inj_lt (FRC.Nat.succ_lt_of_lt_pred hi) (FRC.Nat.succ_lt_of_lt_pred hj) e2)
  have hF : ∀ j, j < p - 1 → nonzero (nonzeroIndex a j) = a * nonzero j := fun j hj => by
    show ofNat ((a * nonzero j).val - 1 + 1) = a * nonzero j
    rw [FRC.Nat.sub_add_cancel (hv j hj), ofNat_val]
  have hperm := prod_perm (nonzero : Nat → Shell p) (nonzeroIndex a) (p - 1) hlt hinj
  rw [prodRange_congr (p - 1) hF, prodRange_mul_left] at hperm
  have hP := prodRange_ne_zero hp (f := (nonzero : Nat → Shell p)) (p - 1) (fun j hj => nonzero_ne_zero hj)
  exact mul_left_cancel hp hP (by rw [mul_comm, hperm, mul_one])

omit [Pos p] in
theorem two_le (hp : FRC.Nat.isPrime p) : 2 ≤ p := hp.1

/-- On a shell of more than two residues, `−1 ≠ 1`. -/
theorem neg_one_ne_one (h2 : 2 < p) : (-1 : Shell p) ≠ 1 := fun e => by
  have h : (1 : Shell p) + 1 = 0 :=
    calc (1 : Shell p) + 1 = -1 + 1 := by rw [e]
      _ = 0 := neg_add 1
  have v := val_injective h
  change (1 % p + 1 % p) % p = 0 at v
  rw [FRC.Nat.mod_eq_of_lt (Nat.lt_trans (Nat.lt_succ_self 1) h2)] at v
  change 2 % p = 0 at v
  rw [FRC.Nat.mod_eq_of_lt h2] at v
  exact absurd v (by decide)

theorem ne_zero_of_mul_self {h c : Shell p} (hc : c ≠ 0) (hh : h * h = c) : h ≠ 0 := fun e => by
  rw [e, zero_mul] at hh; exact hc hh.symm

theorem neg_one_ne_zero (hp : FRC.Nat.isPrime p) : (-1 : Shell p) ≠ 0 := fun e => by
  have : (1 : Shell p) = 0 := by rw [← neg_neg (1 : Shell p), e, neg_zero]
  exact one_ne_zero hp this

/-! ## The roots of `X^m − 1`, and the residues they miss -/

/-- Some nonzero residue escapes `x^m = 1` when `0 < m < p − 1`: else `X^m − 1` had `m + 1` roots. -/
theorem exists_pow_ne_one (hp : FRC.Nat.isPrime p) {m : Nat} (hm : 0 < m) (hlt : m < p - 1) :
    ∃ a : Shell p, a ≠ 0 ∧ a ^ m ≠ 1 :=
  match decExistsLT (fun j => (nonzero j : Shell p) ^ m ≠ 1) (p - 1) with
  | .isTrue ⟨j, hj, h⟩ => ⟨nonzero j, nonzero_ne_zero hj, h⟩
  | .isFalse hno => by
    have hm1 : m + 1 < p := FRC.Nat.succ_lt_of_lt_pred hlt
    have hone : ∀ i, i ≤ m → (nonzero i : Shell p) ^ m = 1 := fun i hi =>
      match decEq ((nonzero i : Shell p) ^ m) 1 with
      | .isTrue e => e
      | .isFalse ne => absurd ⟨i, Nat.lt_of_le_of_lt hi hlt, ne⟩ hno
    have hz := Poly.root_bound_of (fun h => mul_eq_zero hp h) m (Poly.xn1 m) (Poly.xn1_bound m) (nonzero : Nat → Shell p)
      (fun i j hi hj e => Nat.succ.inj (Poly.Frame.ofNat_inj_lt (Nat.lt_of_le_of_lt (Nat.succ_le_succ hi) hm1)
        (Nat.lt_of_le_of_lt (Nat.succ_le_succ hj) hm1) e))
      (fun i hi => by rw [Poly.eval_xn1 hm, hone i hi, add_neg]) m
    rw [Poly.xn1_top] at hz
    exact absurd hz (one_ne_zero hp)

/-- On an odd prime `p = 2n + 1`, some residue has `aⁿ = −1`: a non-square, by Fermat and `x² = 1 ⇒ x = ±1`. -/
theorem exists_pow_half (hp : FRC.Nat.isPrime p) {n : Nat} (hn : p = 2 * n + 1) : ∃ a : Shell p, a ^ n = -1 := by
  have hn0 : 0 < n := by
    match n, hn with
    | 0, hn => have h := hp.1; rw [hn] at h; exact absurd h (by decide)
    | k + 1, _ => exact Nat.zero_lt_succ k
  have hp1 : p - 1 = n + n := by rw [hn, FRC.Nat.add_sub_cancel, Nat.two_mul]
  have hlt : n < p - 1 := by rw [hp1]; exact Nat.lt_add_of_pos_right hn0
  obtain ⟨a, ha, han⟩ := exists_pow_ne_one hp hn0 hlt
  have hsq : a ^ n * a ^ n = 1 := by rw [← pow_add, ← hp1, fermat hp ha]
  exact ⟨a, match sq_eq_one hp hsq with
    | .inl e => absurd e han
    | .inr e => e⟩

/-! ## The quarter-turn on the chart `p = 4S + 1` (the criterion: `Theme/Foundation.lean`) -/

/-- The quarter-turn on the chart `p = 4S + 1`, generator-free: `ħ = a^S` with `a^{2S} = −1`. -/
theorem exists_quarter_turn (hp : FRC.Nat.isPrime p) {S : Nat} (hS : p = 4 * S + 1) :
    ∃ h : Shell p, h * h = -1 := by
  obtain ⟨a, ha⟩ := exists_pow_half hp (n := 2 * S) (by rw [hS, ← FRC.Nat.mul_assoc])
  exact ⟨a ^ S, by rw [← pow_add, ← Nat.two_mul, ha]⟩

/-! ## A shell without zero divisors is prime -/

theorem ofNat_mul (a b : Nat) : (ofNat a * ofNat b : Shell p) = ofNat (a * b) :=
  ext (by show (a % p * (b % p)) % p = (a * b) % p; rw [← FRC.Nat.mul_mod _ _ _ Pos.pos])

theorem ofNat_self : (ofNat p : Shell p) = 0 := ext (FRC.Nat.mod_self p Pos.pos)

/-- A shell of at least two residues without zero divisors is prime: a factorisation `p = d q` with `2 ≤ d < p`
makes `d · q = 0` with both factors nonzero. -/
theorem isPrime_of_no_zero_divisors (h2 : 2 ≤ p) (hz : ∀ {a b : Shell p}, a * b = 0 → a = 0 ∨ b = 0) :
    FRC.Nat.isPrime p := by
  refine ⟨h2, fun d hdp hd2 hmod => ?_⟩
  have hd0 : 0 < d := Nat.lt_of_lt_of_le (Nat.zero_lt_succ 1) hd2
  obtain ⟨q, hq⟩ := FRC.Nat.mod_spec d hd0 p
  rw [hmod, Nat.add_zero] at hq
  have hq0 : 0 < q := by
    match q, hq with
    | 0, hq => rw [Nat.mul_zero] at hq; rw [hq] at h2; exact absurd h2 (by decide)
    | k + 1, _ => exact Nat.zero_lt_succ k
  have hqp : q < p := by
    have h1 : 1 * q < d * q := FRC.Nat.mul_lt_mul_of_lt_of_pos (Nat.lt_of_lt_of_le (Nat.lt_succ_self 1) hd2) hq0
    rw [Nat.one_mul, ← hq] at h1; exact h1
  have e : (ofNat d * ofNat q : Shell p) = 0 := by rw [ofNat_mul, ← hq, ofNat_self]
  match hz e with
  | .inl e1 => exact ofNat_ne_zero hd0 hdp e1
  | .inr e2 => exact ofNat_ne_zero hq0 hqp e2

/-! ## The chart `p = 4S + 1`: the half-square and the parity flip (moved from the Carrier's theme by task LM24, so that
every programme theme stands on them without the Carrier; `FRC.Carrier` keeps the old names) -/

omit [Pos p] in
theorem chart_gt_two (hp : FRC.Nat.isPrime p) {S : Nat} (hS : p = 4 * S + 1) : 2 < p := by
  match S, hS with
  | 0, hS => have h := hp.1; rw [hS] at h; exact absurd h (by decide)
  | k + 1, hS =>
    rw [hS, Nat.left_distrib]
    exact Nat.lt_of_lt_of_le (by decide : 2 < 5) (Nat.le_add_left 5 (4 * k))

/-- `2 = 1 + 1` on every shell. -/
theorem two_eq : (2 : Shell p) = 1 + 1 :=
  ext (by show 2 % p = (1 % p + 1 % p) % p; rw [← FRC.Nat.add_mod _ _ _ Pos.pos])

/-- `a + 1 + (1 − a) = 1 + 1`. -/
theorem add_one_add_one_neg (a : Shell p) : a + 1 + (1 + -a) = 1 + 1 := by
  rw [add_assoc, ← add_assoc 1 1 (-a), add_comm (1 + 1) (-a), ← add_assoc a (-a) (1 + 1), add_neg, zero_add]

/-- The octant sector: on the chart `p = 4S + 1`, an element of order eight (`ζ⁸ = 1`,
`ζ⁴ ≠ 1`) exists iff `S` is even: `C₈ ⊂ C_{4S}` exactly when `8 ∣ 4S`. Forward, `ζ⁴ = −1` and Fermat give
`ζ^{4S} = 1`, which an odd `S = 2m + 1` turns into `ζ⁴ = 1`; backward, `ζ = a^{S/2}` with `a^{2S} = −1`. -/
theorem octant_sector (hp : FRC.Nat.isPrime p) {S : Nat} (hS : p = 4 * S + 1) :
    (∃ ζ : Shell p, ζ ^ 8 = 1 ∧ ζ ^ 4 ≠ 1) ↔ S % 2 = 0 := by
  have h2 := chart_gt_two hp hS
  constructor
  · intro ⟨ζ, h8, h4⟩
    have hz0 : ζ ≠ 0 := fun e => by
      rw [e, show (8 : Nat) = 7 + 1 from rfl, pow_succ, mul_zero] at h8; exact one_ne_zero hp h8.symm
    have h4' : ζ ^ 4 = -1 :=
      match sq_eq_one hp (by rw [← pow_add]; exact h8 : ζ ^ 4 * ζ ^ 4 = 1) with
      | .inl e => absurd e h4
      | .inr e => e
    match FRC.Nat.mod_two_cases S with
    | .inl e => exact e
    | .inr e =>
      obtain ⟨m, hm⟩ := FRC.Nat.mod_spec 2 (by decide) S
      rw [e] at hm
      have hf := fermat hp hz0
      have hp1 : p - 1 = 8 * m + 4 := by
        rw [hS, FRC.Nat.add_sub_cancel, hm, Nat.left_distrib, ← FRC.Nat.mul_assoc]
      rw [hp1, pow_add, pow_mul, h8, one_pow, one_mul, h4'] at hf
      exact absurd hf (neg_one_ne_one h2)
  · intro he
    obtain ⟨m, hm⟩ := FRC.Nat.mod_spec 2 (by decide) S
    rw [he, Nat.add_zero] at hm
    obtain ⟨a, ha⟩ := exists_pow_half hp (n := 2 * S) (by rw [hS, ← FRC.Nat.mul_assoc])
    have h4 : (a ^ m) ^ 4 = -1 := by
      rw [← pow_mul, show m * 4 = 2 * S by rw [hm, ← FRC.Nat.mul_assoc, Nat.mul_comm m 4]]; exact ha
    exact ⟨a ^ m, by rw [show (8 : Nat) = 4 * 2 from rfl, pow_mul, h4, pow_two, neg_mul_neg, mul_one],
      by rw [h4]; exact neg_one_ne_one h2⟩

/-- 00:C8, 22:C17, 22:C25, 22:X7, 22:P3 — the Tsirelson square without a generator: `ζ⁴ = −1` gives `(ζ + ζ⁷)² = 2`. -/
theorem tsirelson {ζ : Shell p} (h4 : ζ ^ 4 = -1) : (ζ + ζ ^ 7) * (ζ + ζ ^ 7) = 2 := by
  have h8 : ζ ^ 8 = 1 := by rw [show (8 : Nat) = 4 + 4 from rfl, pow_add, h4, neg_mul_neg, mul_one]
  have hz : ζ * ζ ^ 7 = 1 := by rw [mul_comm, ← pow_succ]; exact h8
  have h14 : ζ ^ 7 * ζ ^ 7 = -(ζ * ζ) := by
    rw [← pow_add, show 7 + 7 = 8 + (4 + 2) from rfl, pow_add, pow_add, h8, h4, one_mul, neg_one_mul, pow_two]
  rw [left_distrib, right_distrib, right_distrib, hz, mul_comm (ζ ^ 7) ζ, hz, h14, two_eq]
  exact add_one_add_one_neg _

/-- 38:A6 — `2S + 1` is `2⁻¹` on the chart `p = 4S + 1`. -/
theorem two_mul_chart_half {S : Nat} (hS : p = 4 * S + 1) : (2 : Shell p) * ofNat (2 * S + 1) = 1 := ext (by
  show (2 % p * ((2 * S + 1) % p)) % p = 1 % p
  rw [← FRC.Nat.mul_mod _ _ _ Pos.pos,
    show 2 * (2 * S + 1) = p * 1 + 1 by rw [hS, Nat.mul_one, Nat.left_distrib, ← FRC.Nat.mul_assoc],
    FRC.Nat.add_mul_mod_self_left 1 1 p Pos.pos])

/-- The half-square: on the chart `p = 4S + 1`, `2⁻¹ = 2S + 1` is a square iff `S` is even (Carrier B7, `c² = 2⁻¹`).
A root `c` of `c² = 2⁻¹` gives `ζ = c (1 + i)` with `ζ² = i`, an element of order eight; conversely the octant's `ζ`
gives `(ζ + ζ⁷)² = 2` and `c = (ζ + ζ⁷)/2`. -/
theorem half_square_iff (hp : FRC.Nat.isPrime p) {S : Nat} (hS : p = 4 * S + 1) :
    (∃ c : Shell p, c * c = ofNat (2 * S + 1)) ↔ S % 2 = 0 := by
  have h2 := chart_gt_two hp hS
  have hh := two_mul_chart_half hS
  constructor
  · intro ⟨c, hc⟩
    -- with `i² = −1`, `ζ = c (1 + i)` has `ζ² = c² · 2i = i`: an element of order eight
    obtain ⟨i, hi⟩ := exists_quarter_turn hp hS
    have hh' : (ofNat (2 * S + 1) : Shell p) * (1 + 1) = 1 := by rw [mul_comm, ← two_eq]; exact hh
    have e : (1 + i) * (1 + i) = (1 + 1) * i := by
      rw [left_distrib, right_distrib, right_distrib, one_mul, one_mul, mul_one, hi, right_distrib, one_mul,
        add_comm i (-1), add_add_add_comm, add_neg, zero_add]
    have hz : (c * (1 + i)) * (c * (1 + i)) = i := by
      rw [mul_mul_mul_comm, hc, e, ← mul_assoc, hh', one_mul]
    have hz4 : (c * (1 + i)) ^ 4 = -1 := by
      rw [show (4 : Nat) = 2 * 2 from rfl, pow_mul, pow_two (c * (1 + i)), hz, pow_two, hi]
    exact (octant_sector hp hS).1 ⟨c * (1 + i), by
      rw [show (8 : Nat) = 4 * 2 from rfl, pow_mul, hz4, pow_two, neg_mul_neg, mul_one],
      by rw [hz4]; exact neg_one_ne_one h2⟩
  · intro he
    obtain ⟨ζ, h8, h4⟩ := (octant_sector hp hS).2 he
    have h4' : ζ ^ 4 = -1 :=
      match sq_eq_one hp (by rw [← pow_add]; exact h8 : ζ ^ 4 * ζ ^ 4 = 1) with
      | .inl e => absurd e h4
      | .inr e => e
    refine ⟨(ζ + ζ ^ 7) * ofNat (2 * S + 1), ?_⟩
    rw [mul_mul_mul_comm, tsirelson h4', ← mul_assoc, hh, one_mul]

/-- Integer parity is frame data: on an odd shell the pair `x ↔ −x` flips the parity of the representative. -/
theorem parity_flips {S : Nat} (hS : p = 4 * S + 1) {x : Shell p} (hx : x ≠ 0) :
    x.val % 2 = 0 ↔ ¬ (-x).val % 2 = 0 := by
  have hneg : (-x).val = p - x.val := by
    show (p - x.val) % p = p - x.val
    exact FRC.Nat.mod_eq_of_lt (Nat.sub_lt Pos.pos (val_pos hx))
  rw [hneg]
  exact FRC.Nat.parity_split (n := 2 * S)
    (by rw [FRC.Nat.add_sub_of_le (Nat.le_of_lt x.lt), hS, ← FRC.Nat.mul_assoc])

end Prime
end Shell
end FRC

