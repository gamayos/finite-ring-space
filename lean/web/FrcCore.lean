    12 % 2 = 0 ∧ 14 % 2 = 0 ∧ (∀ d, d < 15 → 2 < d → ¬ (12 % d = 0 ∧ 14 % d = 0)) ∧
    12 % 4 = 0 ∧ 28 % 4 = 0 ∧ (∀ d, d < 29 → 4 < d → ¬ (12 % d = 0 ∧ 28 % d = 0)) ∧
