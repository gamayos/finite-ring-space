    (5 : Shell 157) ^ 78 ≠ 1 ∧ (5 : Shell 157) ^ 52 ≠ 1 ∧ (5 : Shell 157) ^ 12 ≠ 1 ∧ (5 : Shell 157) ^ 156 = 1 ∧
