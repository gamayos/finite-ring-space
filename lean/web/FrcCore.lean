  have h : z ^ (m + 2) + Ext.ofShell (Ext.norm z) * z ^ m = Ext.ofShell (Ext.trace z) * z ^ (m + 1) := by
    calc z ^ (m + 2) + Ext.ofShell (Ext.norm z) * z ^ m
