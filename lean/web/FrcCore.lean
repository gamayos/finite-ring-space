/-- p25022 — 25:E4. A single hard sentence, system-relatively: the bare evaluation calculus infers $\forall x\,\varphi(x)$ from the $m$ premises $\varphi(c)$. Every derivation of a global clause there has length at least $m$ and defeats every budget $H<m$. A richer $\D$ may derive some global clauses briefly. -/
theorem p25022 : (∀ (m : Nat) (l : List FRC.Reach.Line), FRC.Reach.RuleApplies m l → m ≤ l.length) ∧ (∀ (m : Nat) (l : List FRC.Reach.Line), FRC.Reach.RuleApplies m l → ∀ (H : Nat), H < m → ¬l.length + (1 : Nat) ≤ H) ∧ ∀ (M : FRC.Logic.FinStr) (env : Nat → Nat) (φ : FRC.Logic.FForm), (∀ (c : Nat), c < M.m → FRC.Logic.fval M (FRC.Logic.cons c env) φ = true) → FRC.Logic.Sat M env φ.all :=
  And.intro @FRC.Reach.global_clause_length (And.intro @FRC.Reach.global_clause_defeats_budget (@FRC.Reach.bare_rule_sound))
/-- p25023 — 25:F1. Mention cost: if the truth of a formula in $\M$ depends on coordinate $i$ of a tuple of variables, then $v_{i}$ occurs in it. A formula whose truth depends on all $N$ coordinates has length at least $N$. A quantifier block binding an $N$-tuple contributes at least $N$ symbols. -/
theorem p25023 : (∀ (p : Nat) (φ : FRC.Diagonal.Fm) {env env' : Nat → Nat}, (∀ (i : Nat), FRC.Diagonal.occ i φ = true → env i = env' i) → FRC.Diagonal.holds p env φ = FRC.Diagonal.holds p env' φ) ∧ (∀ (p : Nat) (φ : FRC.Diagonal.Fm) (env : Nat → Nat) (i v : Nat), FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) φ ≠ FRC.Diagonal.holds p env φ → FRC.Diagonal.occ i φ = true) ∧ (∀ (φ : FRC.Diagonal.Fm) (N : Nat), (∀ (i : Nat), i < N → FRC.Diagonal.occ i φ = true) → N ≤ FRC.Diagonal.size φ) ∧ (∀ (p : Nat) (φ : FRC.Diagonal.Fm) (N : Nat), (∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) φ ≠ FRC.Diagonal.holds p env φ) → N ≤ FRC.Diagonal.size φ) ∧ ∀ (n : Nat) (φ : FRC.Diagonal.Fm), FRC.Diagonal.size (FRC.Diagonal.exBlock n φ) = FRC.Diagonal.size φ + (3 : Nat) * n :=
  And.intro @FRC.Diagonal.holds_congr (And.intro @FRC.Diagonal.mention (And.intro @FRC.Diagonal.arity_le_size (And.intro @FRC.Diagonal.mention_cost (@FRC.Diagonal.size_exBlock))))
/-- p25024 — 25:F2. No compression: code strings of length at most $N$ as tuples in $\M^{N}$, one coordinate per symbol, signature and alphabet fixed independently of $N$, $\theta$ non-degenerate. The G\"odel template has no instance at any scale. The diagonal formula needs $\lvert \delta\rvert\ge3N+\lvert \theta\rvert>N$ symbols, so its code is not in $\M^{N}$. Splitting the scales fails: $\delta$ outgrows the scale $\theta$ reads. -/
theorem p25024 : (∀ (p N : Nat) (diag θ : FRC.Diagonal.Fm), (∀ (i : Nat), i < (2 : Nat) * N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) diag ≠ FRC.Diagonal.holds p env diag) → (2 : Nat) * N + FRC.Diagonal.size θ + (3 : Nat) * N ≤ FRC.Diagonal.size (FRC.Diagonal.exBlock N (diag.conj θ))) ∧ (∀ (N : Nat), (1 : Nat) ≤ N → ∀ (φ : FRC.Diagonal.Fm), ¬FRC.Diagonal.size (FRC.Diagonal.exBlock N φ) ≤ N) ∧ (∀ (p N N₂ : Nat) (diag θ : FRC.Diagonal.Fm), (∀ (i : Nat), i < N₂ → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) θ ≠ FRC.Diagonal.holds p env θ) → N₂ < FRC.Diagonal.size (FRC.Diagonal.exBlock N (diag.conj θ))) ∧ ∀ (p : Nat) (φ : FRC.Diagonal.Fm) (N : Nat), (∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env i v) φ ≠ FRC.Diagonal.holds p env φ) → N ≤ FRC.Diagonal.size φ :=
  And.intro @FRC.Diagonal.template_size (And.intro @FRC.Diagonal.no_template (And.intro @FRC.Diagonal.split_scale (@FRC.Diagonal.mention_cost)))
/-- p25025 — 25:F3. Quotation exceeds mention: a formula's arity is below its length. No sentence $\lambda$ contains a subformula whose truth depends on all coordinates of a tuple of arity at least $\lvert \lambda\rvert$. Under any coding that spends at least $\lvert \lambda\rvert$ coordinates on $\lambda$, per-symbol coding included, no sentence's truth is sensitive to every coordinate of its own code. -/
theorem p25025 : (∀ (φ : FRC.Diagonal.Fm) (j N : Nat), (∀ (i : Nat), i < N → FRC.Diagonal.occ (i + j) φ = true) → N < FRC.Diagonal.size φ) ∧ (∀ (p : Nat) (φ : FRC.Diagonal.Fm) (j N : Nat), (∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env (i + j) v) φ ≠ FRC.Diagonal.holds p env φ) → N < FRC.Diagonal.size φ) ∧ ∀ (p : Nat) {ψ lam : FRC.Diagonal.Fm}, FRC.Diagonal.Subformula ψ lam → ∀ (j N : Nat), FRC.Diagonal.size lam ≤ N → ¬∀ (i : Nat), i < N → ∃ env v, FRC.Diagonal.holds p (FRC.Diagonal.upd env (i + j) v) ψ ≠ FRC.Diagonal.holds p env ψ :=
  And.intro @FRC.Diagonal.arity_lt_size (And.intro @FRC.Diagonal.mention_cost_lt (@FRC.Diagonal.no_self_reading))
/-- p25028 — 25:G1. Length horizon: a certificate contains its designated end sentence, so no sentence longer than $B=\min(K,H)$ is certifiable. None longer than $H$ has a derivation of length at most $H$ in any system. Beyond every budget there are truths, by counting alone (E1, E2). -/
theorem p25028 : (∀ (l : List FRC.Logic.FForm) (φ : FRC.Logic.FForm), φ ∈ l → ∀ (B : Nat), FRC.Reach.csize l ≤ B → FRC.Reach.fsize φ ≤ B) ∧ (∀ (l : List FRC.Logic.FForm) (φ : FRC.Logic.FForm), φ ∈ l → ∀ (H : Nat), H < FRC.Reach.fsize φ → ¬FRC.Reach.csize l ≤ H) ∧ ∀ (p : Nat), (0 : Nat) < p → ∀ (B : Nat), ∃ s t, FRC.Reach.leaves s = FRC.Reach.leaves t ∧ B < FRC.Reach.leaves s ∧ FRC.Reach.val ((1 : Nat) % p) (fun x y => (x + y) % p) s = FRC.Reach.val ((1 : Nat) % p) (fun x y => (x + y) % p) t :=
