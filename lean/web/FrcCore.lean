theorem scaled_id (c a b : Shell p) :
    (c * a) * (c * b) = (c * c) * (a * b) :=
  RE.sound (look [c, a, b])
    (.mul (.mul (.var 0) (.var 1)) (.mul (.var 0) (.var 2)))
    (.mul (.mul (.var 0) (.var 0)) (.mul (.var 1) (.var 2))) (by decide +kernel)

