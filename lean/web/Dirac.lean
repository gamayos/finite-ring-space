    have := congrArg im h
    simp at this
    have h' : (2 : F) * z.im = 0 := by linear_combination -this
    rcases mul_eq_zero.1 h' with h0 | h0
    · exact absurd h0 h2
    · exact h0
  · intro h; ext <;> simp [h]
