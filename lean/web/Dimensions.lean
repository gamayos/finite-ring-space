set_option linter.defProp false in
/-- 6:B5 (p06012) — $\Wt^{2}=-J$, $\Ft^{2}=J$, $\Ft^{4}=I$: the normalized operator generates the four-cycle, on the six shells of Table~\ref{tab:checks}. -/
def p06012 := @FRC.Fourier.shell_relations
set_option linter.defProp false in
/-- 6:B7 (p06014) — $\Wt J=J\Wt$, hence $\Ft J=J\Ft$; $\Vt=V^{+}\oplus V^{-}$ with $\dim V^{+}=2\kap+1$, $\dim V^{-}=2\kap-1$. -/
def p06014 := @FRC.Fourier.shell_relations
/-- 6:C2 (p06016) — $\Pi_\ell^{2}=\Pi_\ell$, $\Pi_\ell\Pi_m=0$ for $\ell\neq m$, $\sum_\ell\Pi_\ell=I$, $\Ft\Pi_\ell=\im^{\ell}\Pi_\ell$. -/
theorem p06016 : (∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → ∀ (ℓ m : ZMod (4 : ℕ)), FRC.Fourier.Fmat κ g * FRC.Fourier.shellProj κ g ℓ = FRC.Fourier.chi (-g ^ κ) ℓ • FRC.Fourier.shellProj κ g ℓ ∧ (FRC.Fourier.shellProj κ g ℓ * FRC.Fourier.shellProj κ g m = if ℓ = m then FRC.Fourier.shellProj κ g ℓ else (0 : Matrix (Fin ((4 : ℕ) * κ)) (Fin ((4 : ℕ) * κ)) F)) ∧ ∑ ℓ, FRC.Fourier.shellProj κ g ℓ = (1 : Matrix (Fin ((4 : ℕ) * κ)) (Fin ((4 : ℕ) * κ)) F)) ∧ (∀ {K : Type u_2} [Field K] {A : Type u_3} [Ring A] [Algebra K A] (i : K) (f : A), i ^ (4 : ℕ) = (1 : K) → (∀ (d : ZMod (4 : ℕ)), d ≠ (0 : ZMod (4 : ℕ)) → FRC.Fourier.chi i d ≠ (1 : K)) → (4 : K) ≠ (0 : K) → f ^ (4 : ℕ) = (1 : A) → ∀ (ℓ m : ZMod (4 : ℕ)), FRC.Fourier.proj i f ℓ * FRC.Fourier.proj i f m = if ℓ = m then FRC.Fourier.proj i f ℓ else (0 : A)) ∧ ∀ {K : Type u_4} [Field K] {A : Type u_5} [Ring A] [Algebra K A] (i : K) (f : A), i ^ (4 : ℕ) = (1 : K) → (∀ (d : ZMod (4 : ℕ)), d ≠ (0 : ZMod (4 : ℕ)) → FRC.Fourier.chi i d ≠ (1 : K)) → (4 : K) ≠ (0 : K) → ∑ ℓ, FRC.Fourier.proj i f ℓ = (1 : A) :=
  And.intro @FRC.Fourier.shell_proj (And.intro @FRC.Fourier.proj_mul_proj (@FRC.Fourier.sum_proj))
/-- 6:C3 (p06017) — The exact finite-field FrFT: $s\mapsto\Ft^{[s]}$ is a representation of $\Phit$, $\Ft^{[s+r]}=\Ft^{[s]}\Ft^{[r]}$ on every pair of the six shells, with the cardinal values $\Ft^{[0]}=I$, $\Ft^{[\kap]}=\Ft$, $\Ft^{[2\kap]}=J$, $\Ft^{[3\kap]}=\Ft^{-1}$, and $(\Ft^{[1]})^{\kap}=\Ft$. -/
theorem p06017 : (∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → ∀ (s r : ZMod ((4 : ℕ) * κ)), FRC.Fourier.shellFrft κ g (s + r) = FRC.Fourier.shellFrft κ g s * FRC.Fourier.shellFrft κ g r) ∧ (∀ {F : Type u_2} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → ∀ (m : ℕ), FRC.Fourier.shellFrft κ g (m • ↑κ) = FRC.Fourier.Fmat κ g ^ m) ∧ ∀ {F : Type u_3} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → FRC.Fourier.shellFrft κ g ↑κ = FRC.Fourier.Fmat κ g ∧ FRC.Fourier.shellFrft κ g ((2 : ℕ) • ↑κ) = FRC.Fourier.J ∧ FRC.Fourier.shellFrft κ g (1 : ZMod ((4 : ℕ) * κ)) ^ κ = FRC.Fourier.Fmat κ g :=
  And.intro @FRC.Fourier.shell_frft_add (And.intro @FRC.Fourier.shell_frft_cardinal (@FRC.Fourier.shell_frft_values))
/-- 6:C4 (p06018) — Faithfulness: $s\mapsto\Ft^{[s]}$ is injective on $\Z_{4\kap}$ for every $\kap\ge1$; at $\p=5$ the surviving odd projector carries the faithful character. -/
theorem p06018 : ∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → Function.Injective (FRC.Fourier.shellFrft κ g) :=
  @FRC.Fourier.shell_frft_injective
/-- 6:C5 (p06019) — The multiplicities $m_\ell=\operatorname{rank}\Pi_\ell=\dim\ker(\Ft-\im^{\ell}I)$: $m_0+m_2=2\kap+1$, $m_1+m_3=2\kap-1$; $m_0,m_2\ge1$; $m_1,m_3\ge1$ for $\kap\ge2$; at $\p=5$ exactly one of $\Pi_1,\Pi_3$ vanishes. -/
theorem p06019 : (∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → (2 : ℕ) ≤ κ → FRC.Fourier.shellProj κ g (1 : ZMod (4 : ℕ)) ≠ (0 : Matrix (Fin ((4 : ℕ) * κ)) (Fin ((4 : ℕ) * κ)) F) ∧ FRC.Fourier.shellProj κ g (3 : ZMod (4 : ℕ)) ≠ (0 : Matrix (Fin ((4 : ℕ) * κ)) (Fin ((4 : ℕ) * κ)) F)) ∧ (∀ {F : Type u_2} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → FRC.Fourier.shellProj κ g (0 : ZMod (4 : ℕ)) ≠ (0 : Matrix (Fin ((4 : ℕ) * κ)) (Fin ((4 : ℕ) * κ)) F) ∧ FRC.Fourier.shellProj κ g (2 : ZMod (4 : ℕ)) ≠ (0 : Matrix (Fin ((4 : ℕ) * κ)) (Fin ((4 : ℕ) * κ)) F)) ∧ ∀ (p κ : ℕ) [hp : Fact (Nat.Prime p)] [NeZero κ], p = (4 : ℕ) * κ + (1 : ℕ) → ∀ (g : ZMod p), IsPrimitiveRoot g ((4 : ℕ) * κ) → (FRC.Fourier.shellProj κ g (0 : ZMod (4 : ℕ))).rank + (FRC.Fourier.shellProj κ g (2 : ZMod (4 : ℕ))).rank = (2 : ℕ) * κ + (1 : ℕ) ∧ (FRC.Fourier.shellProj κ g (1 : ZMod (4 : ℕ))).rank + (FRC.Fourier.shellProj κ g (3 : ZMod (4 : ℕ))).rank = (2 : ℕ) * κ - (1 : ℕ) :=
  And.intro @FRC.Fourier.shell_odd_proj_ne_zero (And.intro @FRC.Fourier.shell_even_proj_ne_zero (@FRC.Fourier.shell_multiplicity_sums))
/-- 6:C7 (p06021) — The multiplicity dichotomy: $G=\sum_{k}\gen^{k^{2}}=\varepsilon(1+\im)$; the tuple is $(\kap,\kap,\kap+1,\kap-1)$ for $\varepsilon=+1$ and $(\kap+1,\kap-1,\kap,\kap)$ for $\varepsilon=-1$; $\varepsilon(\gen^{-1})=-\varepsilon(\gen)$, $\varepsilon(\gen^{u})=\bigl(\tfrac{\kap}{u}\bigr)\varepsilon(\gen)$ for $u\equiv1\pmod4$, the two classes equally populated; the proof's identities $GG^{*}=-2$, $G^{2}=2\im$, $\operatorname{Tr}\Ft=\im G$, $\operatorname{Tr}\Ft^{2}=2$, $\operatorname{Tr}\Ft^{3}=\im G^{*}$. Exact on the $38$ primitive frames of $\p\in\{5,13,17,29,37\}$ and the $16$ of $\p=41$. -/
theorem p06021 : (∀ {K : Type u_1} [Field K] (κ : ℕ) [NeZero κ] (g : K), IsPrimitiveRoot g ((4 : ℕ) * κ) → ↑((4 : ℕ) * κ) = (-1 : K) → FRC.Fourier.gauss ((4 : ℕ) * κ) g * FRC.Fourier.gauss ((4 : ℕ) * κ) g⁻¹ = (-2 : K)) ∧ (∀ {K : Type u_2} [Field K] {n : ℕ} {g i : K}, FRC.Fourier.gauss n g * FRC.Fourier.gauss n g⁻¹ = (-2 : K) → i ^ (2 : ℕ) = (-1 : K) → (2 : K) ≠ (0 : K) → ∀ (ε : K), ε = (1 : K) ∨ ε = (-1 : K) → FRC.Fourier.gauss n g = ε * ((1 : K) + i) → FRC.Fourier.gauss n g⁻¹ = -ε * ((1 : K) + -i)) ∧ ∀ (p κ : ℕ) [hp : Fact (Nat.Prime p)] [NeZero κ], p = (4 : ℕ) * κ + (1 : ℕ) → ∀ (g : ZMod p), IsPrimitiveRoot g ((4 : ℕ) * κ) → ∀ (ε : ZMod p), ε = (1 : ZMod p) ∨ ε = (-1 : ZMod p) → FRC.Fourier.gauss ((4 : ℕ) * κ) g = ε * ((1 : ZMod p) + -g ^ κ) → (ε = (1 : ZMod p) → (FRC.Fourier.shellProj κ g (0 : ZMod (4 : ℕ))).rank = κ ∧ (FRC.Fourier.shellProj κ g (1 : ZMod (4 : ℕ))).rank = κ ∧ (FRC.Fourier.shellProj κ g (2 : ZMod (4 : ℕ))).rank = κ + (1 : ℕ) ∧ (FRC.Fourier.shellProj κ g (3 : ZMod (4 : ℕ))).rank = κ - (1 : ℕ)) ∧ (ε = (-1 : ZMod p) → (FRC.Fourier.shellProj κ g (0 : ZMod (4 : ℕ))).rank = κ + (1 : ℕ) ∧ (FRC.Fourier.shellProj κ g (1 : ZMod (4 : ℕ))).rank = κ - (1 : ℕ) ∧ (FRC.Fourier.shellProj κ g (2 : ZMod (4 : ℕ))).rank = κ ∧ (FRC.Fourier.shellProj κ g (3 : ZMod (4 : ℕ))).rank = κ) :=
  And.intro @FRC.Fourier.gauss_mul_gauss_inv (And.intro @FRC.Fourier.gauss_inv_of_sign (@FRC.Fourier.shell_multiplicity_tuple))
set_option linter.defProp false in
/-- 6:C8 (p06022) — Classification: every exponent lift $a_\ell\equiv\ell\pmod4$ is additive with the same cardinal skeleton; a family canonical in the chart $\gen^{u}$ with $u^{2}\not\equiv1\pmod{4\kap}$ does not commute with $\Ft$ ($\p=29$, $u=5$, and every such chart of the six shells); the principal lift is the unique power-tower member. -/
def p06022 := @FRC.Fourier.shell_frftLift
/-- 6:C9 (p06023) — The conjugate reframing $(\gen,\im)\mapsto(\gen^{-1},-\im)$: exactly $\Ft'=-\Ft^{-1}$ and $\Pi'_\ell=\Pi_{\ell+2}$; the operator relations, cardinal values, additivity and faithfulness hold on the conjugate frame, and its multiplicity tuple is the other pattern of C7. -/
theorem p06023 : ∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → ∀ (ℓ : ZMod (4 : ℕ)), - -g ^ κ • FRC.Fourier.W g⁻¹ = -FRC.Fourier.Fmat κ g ^ (3 : ℕ) ∧ FRC.Fourier.proj (- -g ^ κ) (-FRC.Fourier.Fmat κ g ^ (3 : ℕ)) ℓ = FRC.Fourier.shellProj κ g (ℓ + (2 : ZMod (4 : ℕ))) :=
  @FRC.Fourier.shell_conj
set_option linter.defProp false in
/-- 6:D2 (p06025) — The $4\kap$ framed domains are pairwise distinct; read as unordered measurement bases $B_{s+2\kap}=B_s$, since $\Ft^{[s+2\kap]}=\Ft^{[s]}J$ and $J$ permutes the standard basis, and the cycle carries exactly $2\kap$ of them. -/
def p06025 := And.intro @FRC.Fourier.shell_frft_injective (And.intro @FRC.Fourier.shell_frft_add_two_kappa (@FRC.Fourier.mul_J_apply))
/-- 6:E2 (p06031) — $R_s\in SO(2,\Fp)$, and $s\mapsto R_s$ is an isomorphism $\Phit\simeq SO(2,\Fp)$ with $|SO(2,\Fp)|=\p-1=4\kap$: the full rotation group of the $\p^{2}$-point plane is the meridian cycle. Cited definitions (not proofs): FRC.Fourier.unitsEquivCircle. -/
theorem p06031 : (∀ {K : Type u_1} [Field K] (i : K), i ^ (2 : ℕ) = (-1 : K) → (2 : K) ≠ (0 : K) → ∀ (z : K), z ≠ (0 : K) → FRC.Fourier.cc z ^ (2 : ℕ) + FRC.Fourier.dd i z ^ (2 : ℕ) = (1 : K)) ∧ (∀ {K : Type u_2} [Field K] (i : K), i ^ (2 : ℕ) = (-1 : K) → (2 : K) ≠ (0 : K) → ∀ (z w : K), z ≠ (0 : K) → w ≠ (0 : K) → FRC.Fourier.rot i (z * w) = FRC.Fourier.rot i z * FRC.Fourier.rot i w) ∧ ∀ {K : Type u_3} [Field K] (i : K) [Fintype K] [DecidableEq K], i ^ (2 : ℕ) = (-1 : K) → (2 : K) ≠ (0 : K) → Fintype.card (FRC.Fourier.Circle K) = Fintype.card K - (1 : ℕ) :=
  And.intro @FRC.Fourier.circle (And.intro @FRC.Fourier.rot_mul (@FRC.Fourier.card_circle))
/-- 6:E3 (p06032) — The cardinal-skeleton dictionary $M_s\leftrightarrow s\leftrightarrow z_s\leftrightarrow R_s$ with $R_0=I$, $R_\kap=w$, $R_{2\kap}=-I$, $R_{3\kap}=w^{-1}$ (the $R_\kap$ column of Table~\ref{tab:checks}), $z_\kap=\im$; the FRC-native and Weil families stand in cardinal Weil correspondence, the Weil side by the normalization of A2. -/
theorem p06032 : ∀ {K : Type u_1} [Field K] (i : K), i ^ (2 : ℕ) = (-1 : K) → (2 : K) ≠ (0 : K) → FRC.Fourier.rot i (1 : K) = (1 : Matrix (Fin (2 : ℕ)) (Fin (2 : ℕ)) K) ∧ FRC.Fourier.rot i i = !![(0 : K), (-1 : K); (1 : K), (0 : K)] ∧ FRC.Fourier.rot i (-1 : K) = (-1 : Matrix (Fin (2 : ℕ)) (Fin (2 : ℕ)) K) ∧ FRC.Fourier.rot i (-i) = !![(0 : K), (1 : K); (-1 : K), (0 : K)] :=
  @FRC.Fourier.rot_cardinal
set_option linter.defProp false in
/-- 6:E5 (p06034) — Spectral obstruction: the exponent shift $\sigma$ has the $4\kap$ simple eigenvalues $\Fpx$, every $\Ft^{[s]}$ at most four; for $\kap\ge2$ the cyclic groups $\langle\sigma\rangle$ and $\langle\Ft^{[1]}\rangle$ are not conjugate. -/
def p06034 := @FRC.Fourier.shell_spectral_obstruction
/-- 6:E6 (p06035) — Common character sector: on $E_1=\operatorname{im}\Pi_1\neq0$ ($\kap\ge2$) $\Ft^{[s]}=\gen^{-s}I$, the intertwiner $\Ft^{[s]}T_v=T_vS_{-s}$ on every $x\in\Fp$ and $s$, and $R_s(1,-\im)^{\mathsf T}=\gen^{-s}(1,-\im)^{\mathsf T}$. -/
theorem p06035 : (∀ {K : Type u_1} [Field K] {A : Type u_2} [Ring A] [Algebra K A] {n : ℕ} (i z : K) (f : A), i ^ (4 : ℕ) = (1 : K) → (∀ (d : ZMod (4 : ℕ)), d ≠ (0 : ZMod (4 : ℕ)) → FRC.Fourier.chi i d ≠ (1 : K)) → (4 : K) ≠ (0 : K) → f ^ (4 : ℕ) = (1 : A) → ∀ (s : ZMod n), FRC.Fourier.frft i z f s * FRC.Fourier.proj i f (1 : ZMod (4 : ℕ)) = FRC.Fourier.psi z s • FRC.Fourier.proj i f (1 : ZMod (4 : ℕ))) ∧ ∀ {K : Type u_3} [Field K] (i : K), i ^ (2 : ℕ) = (-1 : K) → (2 : K) ≠ (0 : K) → ∀ (z : K), z ≠ (0 : K) → (FRC.Fourier.rot i z).mulVec ![(1 : K), -i] = z • ![(1 : K), -i] :=
  And.intro @FRC.Fourier.frft_mul_proj_one (@FRC.Fourier.rot_eigenline)
/-- 6:E7 (p06036) — Cardinal Heisenberg covariance: $\Ft\sigma\Ft^{-1}=D_1$, $\Ft D_1\Ft^{-1}=\sigma^{-1}$; $\Ft^{r}\sigma=\sigma_r\Ft^{r}$ with $(\sigma,D_1,\sigma^{-1},D_1^{-1})$; the expansion \eqref{eq:conj-expansion}; $\Ft^{[s]}\sigma\Ft^{[s]-1}$ monomial exactly at the four cardinal indices and non-monomial at every one of the $112$ intermediate indices of $\p\in\{13,17,29,37,41\}$. -/
theorem p06036 : ∀ {F : Type u_1} [Field F] [Fintype F] (κ : ℕ) [NeZero κ] (g : F), Fintype.card F = (4 : ℕ) * κ + (1 : ℕ) → IsPrimitiveRoot g ((4 : ℕ) * κ) → FRC.Fourier.Fmat κ g * FRC.Fourier.shift = FRC.Fourier.modul g * FRC.Fourier.Fmat κ g ∧ FRC.Fourier.Fmat κ g * FRC.Fourier.modul g = FRC.Fourier.shift' * FRC.Fourier.Fmat κ g ∧ FRC.Fourier.shift * FRC.Fourier.shift' = (1 : Matrix (Fin ((4 : ℕ) * κ)) (Fin ((4 : ℕ) * κ)) F) :=
