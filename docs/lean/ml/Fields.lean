/-- 27:C1 — the phase cycle inside `U(1)` (`FieldsML.roots_inclusion`). -/
theorem roots_inclusion (M : ℕ) (hM : M ≠ 0) :
    IsPrimitiveRoot (Complex.exp (2 * Real.pi * Complex.I / M)) M ∧
    (∀ j k : ℕ, Complex.exp (2 * Real.pi * Complex.I / M) ^ (j + k) =
      Complex.exp (2 * Real.pi * Complex.I / M) ^ j * Complex.exp (2 * Real.pi * Complex.I / M) ^ k) ∧
    (∀ j k : ℕ, j < M → k < M →
      Complex.exp (2 * Real.pi * Complex.I / M) ^ j = Complex.exp (2 * Real.pi * Complex.I / M) ^ k → j = k) ∧
    (∀ k : ℕ, (Complex.exp (2 * Real.pi * Complex.I / M) ^ k) ^ M = 1) :=
  FRC.FieldsML.roots_inclusion M hM

