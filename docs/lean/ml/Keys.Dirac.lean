/-- p08040 — 8:F3. The free evolution is the drive: the drive pullback is unitary, the characters are its eigenvectors with the phase $g^{-k}$ per chronon, and every character line is isotropic except the two with eigenvalues $\pm1$, the meeting of the norm-one cycle and the drive cycle. Decided on $\F_{13}$ and $\F_{173}$. -/
def p08040 := And.intro @FRC.DiracML.drive_chi (And.intro @FRC.DiracML.drive_sum (And.intro @FRC.DiracML.chi_isotropy (@FRC.DiracML.exceptional_eigen)))
/-- p08041 — 8:F4. Two evolution sectors, one space: the drive's split-phase sector and the Cayley propagators' norm-one sector meet in $\{\pm1\}$ alone; the cycle Laplacian is self-adjoint, its Cayley steps commute with the drive, and the composite is unitary. -/
theorem p08041 : (∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {K : Type u_1} [Field K] [Finite K], Nat.card K = p ^ (2 : ℕ) → ∀ (g : (ZMod p)ˣ), orderOf g = p - (1 : ℕ) → orderOf g⁻¹ = p - (1 : ℕ) ∧ ∀ (x : Kˣ), orderOf x ≠ p) ∧ ∀ (κ : ℕ) [Fact (Nat.Prime ((4 : ℕ) * κ + (1 : ℕ)))] (g : (ZMod ((4 : ℕ) * κ + (1 : ℕ)))ˣ), orderOf g = (4 : ℕ) * κ → ↑g⁻¹ ^ ((2 : ℕ) * κ) = (-1 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) ∧ ∀ (u : ZMod ((4 : ℕ) * κ + (1 : ℕ))), u * u = (1 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) → u = (1 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) ∨ u = (-1 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) :=
  And.intro @FRC.DiracML.sector_separation (@FRC.DiracML.exceptional_eigen)
set_option linter.defProp false in
/-- p08048 — 8:F6. The two spectra: the drive is semisimple with spectrum the drive cycle; the Dirac Cayley step at mass $m$ has the single eigenvalue $\varphi(-m)$ on the third cycle and the mass phases fill it once; the spectra meet in $\{\pm1\}$; the Hamiltonian form has the two eigenvalues $\varphi(\pm\im\nu m)$, a conjugate pair. Decided at $\p=13$ and $173$. -/
def p08048 := And.intro @FRC.DiracML.drive_chi (And.intro @FRC.DiracML.cayley_nilpotent_shift (And.intro @FRC.DiracML.Ext.cayley_injective (And.intro @FRC.DiracML.Ext.card_normOneGroup (@FRC.DiracML.sector_separation))))
/-- p08049 — 8:B4. The factorisation of the temporal coefficient: $\nu=g=2^{-1}\cdot(2g)$ on every shell, the class of $2^{-1}$ even iff $\kap$ is even, the class of $2g$ odd iff $\kap$ is even, the product odd always; the reframing flip preserves the parity class and reverses the one-way direction. -/
theorem p08049 : (∀ {K : Type u_1} [Field K] (g : K), (2 : K) ≠ (0 : K) → (2 : K)⁻¹ * ((2 : K) * g) = g) ∧ (∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {g : ZMod p}, g ≠ (0 : ZMod p) → ¬IsSquare g → (2 : ZMod p) ≠ (0 : ZMod p) → (IsSquare ((2 : ZMod p) * g) ↔ ¬IsSquare (2 : ZMod p))) ∧ (∀ (κ : ℕ) [hp' : Fact (Nat.Prime ((4 : ℕ) * κ + (1 : ℕ)))] {g : ZMod ((4 : ℕ) * κ + (1 : ℕ))}, orderOf g = (4 : ℕ) * κ → (IsSquare (2 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) ↔ Even κ) ∧ (IsSquare (2 : ZMod ((4 : ℕ) * κ + (1 : ℕ)))⁻¹ ↔ Even κ) ∧ (IsSquare (-2 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) ↔ Even κ) ∧ (IsSquare (g ^ ((3 : ℕ) * κ)) ↔ Even κ) ∧ g ^ ((3 : ℕ) * κ) = -g ^ κ ∧ IsSquare (-1 : ZMod ((4 : ℕ) * κ + (1 : ℕ)))) ∧ (FRC.DiracML.Aent (2 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) = (10 : ZMod (13 : ℕ)) ∧ FRC.DiracML.Bent (2 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) = (2 : ZMod (13 : ℕ)) ∧ (10 : ZMod (13 : ℕ)) ^ (2 : ℕ) - (2 : ZMod (13 : ℕ)) * (2 : ZMod (13 : ℕ)) ^ (2 : ℕ) = (1 : ZMod (13 : ℕ)) ∧ (2 : ZMod (13 : ℕ)) * (7 : ZMod (13 : ℕ)) = (1 : ZMod (13 : ℕ)) ∧ ¬IsSquare (7 : ZMod (13 : ℕ)) ∧ (2 : ZMod (13 : ℕ)) ^ (5 : ℕ) = (6 : ZMod (13 : ℕ)) ∧ ¬IsSquare (6 : ZMod (13 : ℕ)) ∧ orderOf (2 : ZMod (13 : ℕ)) = (12 : ℕ)) ∧ (171106 : ℕ) * (171106 : ℕ) * (2 : ℕ) % (2408561 : ℕ) = (1 : ℕ) ∧ (2 : ℕ) * (1204281 : ℕ) % (2408561 : ℕ) = (1 : ℕ) ∧ (1204281 : ℕ) * (12 : ℕ) % (2408561 : ℕ) = (6 : ℕ) ∧ Nat.Prime (2408561 : ℕ) :=
  And.intro @FRC.DiracML.nu_factorisation (And.intro @FRC.DiracML.two_g_class (And.intro @FRC.DiracML.named_residues (And.intro @FRC.DiracML.shell13 (@FRC.DiracML.carrier_constants))))
/-- p08051 — 8:D12. The worked shell $\F_{13}$ with the drive $2$: the boost at $x=y=1$ with $A=10$, $B=2$, the transported gamma matrices, the order $14$ of the boost cycle and no triality element; the named residues $2$, $2^{-1}$, $\im$, $e$, $\pi$ are nonsquares. -/
theorem p08051 : FRC.DiracML.Aent (2 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) = (10 : ZMod (13 : ℕ)) ∧ FRC.DiracML.Bent (2 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) = (2 : ZMod (13 : ℕ)) ∧ (10 : ZMod (13 : ℕ)) ^ (2 : ℕ) - (2 : ZMod (13 : ℕ)) * (2 : ZMod (13 : ℕ)) ^ (2 : ℕ) = (1 : ZMod (13 : ℕ)) ∧ (2 : ZMod (13 : ℕ)) * (7 : ZMod (13 : ℕ)) = (1 : ZMod (13 : ℕ)) ∧ ¬IsSquare (7 : ZMod (13 : ℕ)) ∧ (2 : ZMod (13 : ℕ)) ^ (5 : ℕ) = (6 : ZMod (13 : ℕ)) ∧ ¬IsSquare (6 : ZMod (13 : ℕ)) ∧ orderOf (2 : ZMod (13 : ℕ)) = (12 : ℕ) :=
  @FRC.DiracML.shell13
/-- p08052 — 8:F2. The latitude identities: the energy index $\kap+1$ is the first rung past the midpoint of the ladder; the shift by $\kap$ is multiplication by $g^{\kap}$ on the meridians and carries the first latitude to the energy latitude; $\kap=-4^{-1}$, so the energy radius is $3\cdot4^{-1}$ and $\pi=2\kap=-2^{-1}$; the unit-norm circle has $\p-1$ points. On $\F_{13}$ and $\F_{173}$. -/
theorem p08052 : ∀ (κ : ℕ) [hp : Fact (Nat.Prime ((4 : ℕ) * κ + (1 : ℕ)))] {g : ZMod ((4 : ℕ) * κ + (1 : ℕ))}, orderOf g = (4 : ℕ) * κ → (4 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) * ↑κ = (-1 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) ∧ ↑κ = -(4 : ZMod ((4 : ℕ) * κ + (1 : ℕ)))⁻¹ ∧ (1 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) + ↑κ = (3 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) * (4 : ZMod ((4 : ℕ) * κ + (1 : ℕ)))⁻¹ ∧ (2 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) * ↑κ = -(2 : ZMod ((4 : ℕ) * κ + (1 : ℕ)))⁻¹ ∧ g ^ κ = -g ^ ((3 : ℕ) * κ) ∧ κ + (1 : ℕ) ≤ (2 : ℕ) * κ :=
  @FRC.DiracML.latitude_identities
/-- p08053 — 8:X1. Two cycles for one unit circle: the continuum's single phase group appears on the shell as the drive cycle, carrying the free evolution, and the norm-one cycle, carrying the Cayley phases and the boosts, and the two meet in $\{\pm1\}$. -/
theorem p08053 : ∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {K : Type u_1} [Field K] [Finite K], Nat.card K = p ^ (2 : ℕ) → ∀ (g : (ZMod p)ˣ), orderOf g = p - (1 : ℕ) → orderOf g⁻¹ = p - (1 : ℕ) ∧ ∀ (x : Kˣ), orderOf x ≠ p :=
  @FRC.DiracML.sector_separation
/-- p08054 — 8:X2. The one-way speed is gauge: the temporal coefficient is an odd drive step, registered transport is even, and the reframing flip reverses the one-way direction while preserving the parity class. -/
theorem p08054 : (∀ {K : Type u_1} [Field K] (g : K), (2 : K) ≠ (0 : K) → (2 : K)⁻¹ * ((2 : K) * g) = g) ∧ ∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {g : ZMod p}, orderOf g = p - (1 : ℕ) → p % (2 : ℕ) = (1 : ℕ) → ∀ (k : ℕ), IsSquare (g ^ k) ↔ Even k :=
  And.intro @FRC.DiracML.nu_factorisation (@FRC.DiracML.parity_iff)
/-- p08055 — 8:X3. Mass is an evolution phase, not a kernel condition: the symmetric Dirac operator is nilpotent, the static massive equation has only the zero solution, and the mass enters as the norm-one factor of the Cayley step. -/
theorem p08055 : (∀ {R : Type u_1} [Ring R] {p : ℕ} [hp : Fact (Nat.Prime p)] [CharP R p] {t : R}, t ^ p = (1 : R) → (t - (1 : R)) ^ p = (0 : R)) ∧ (∀ {R : Type u_2} [Ring R] {α m N : R}, (∀ (x : R), Commute α x) → (∀ (x : R), Commute m x) → IsNilpotent N → ∀ (ha : IsUnit ((1 : R) + α * m)) (hb : IsUnit ((1 : R) - α * m)), ∃ (hu : IsUnit ((1 : R) - α * (N - m))), IsNilpotent (↑hu.unit⁻¹ * ((1 : R) + α * (N - m)) - ↑(hb.unit * ha.unit⁻¹))) ∧ ∀ {R : Type u_3} [Ring R] (σ : R → R), (∀ (x y : R), σ (x * y) = σ y * σ x) → (∀ (x y : R), σ (x + y) = σ x + σ y) → σ (1 : R) = (1 : R) → (∀ (x : R), σ (-x) = -σ x) → ∀ {h a : R}, σ h = h → σ a = -a → (∀ (x : R), Commute a x) → ∀ (hu : IsUnit ((1 : R) - a * h)), have u := ↑hu.unit⁻¹ * ((1 : R) + a * h); σ u * u = (1 : R) :=
  And.intro @FRC.DiracML.translation_nilpotent (And.intro @FRC.DiracML.cayley_nilpotent_shift (@FRC.DiracML.cayley_unitary))
/-- p08056 — 8:X4. The spinor form is forced: the continuum's $\gamma^0$-twist fails because Frobenius fixes the internal quarter-turn, and the arithmetic forces the twist onto the odd product omitting $\gamma^2$. -/
theorem p08056 : (∀ {K : Type u_1} [CommRing K] {i w ν : K}, i * i = (-1 : K) → w * w = ν → FRC.DiracML.Xγ i w * FRC.DiracML.Xγ i w = ν • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.Xγ i w * FRC.DiracML.γ0 i w = FRC.DiracML.γ0 i w * FRC.DiracML.Xγ i w ∧ FRC.DiracML.Xγ i w * FRC.DiracML.γ1 i = FRC.DiracML.γ1 i * FRC.DiracML.Xγ i w ∧ FRC.DiracML.Xγ i w * FRC.DiracML.γ3 i = FRC.DiracML.γ3 i * FRC.DiracML.Xγ i w ∧ FRC.DiracML.Xγ i w * FRC.DiracML.γ2 i = -(FRC.DiracML.γ2 i * FRC.DiracML.Xγ i w)) ∧ ∀ {K : Type u_2} [CommRing K] [StarRing K] {i w ν : K}, i * i = (-1 : K) → w * w = ν → star i = i → star w = -w → (FRC.DiracML.γ0 i w).conjTranspose = -FRC.DiracML.γ0 i w ∧ (FRC.DiracML.γ1 i).conjTranspose = -FRC.DiracML.γ1 i ∧ (FRC.DiracML.γ2 i).conjTranspose = FRC.DiracML.γ2 i ∧ (FRC.DiracML.γ3 i).conjTranspose = -FRC.DiracML.γ3 i ∧ (FRC.DiracML.Xγ i w).conjTranspose = FRC.DiracML.Xγ i w :=
  And.intro @FRC.DiracML.spinor_twist (@FRC.DiracML.gamma_dagger)
/-- p08058 — 8:C8. Translations are unitary: every translation operator preserves the Hermitian form, and its adjoint is the opposite translation. -/
theorem p08058 : (∀ {K : Type u_1} [CommRing K] [StarRing K] {G : Type u_2} [AddGroup G] [Fintype G] (u : G) (ψ φ : G → K), FRC.DiracML.herm (FRC.DiracML.translate u ψ) (FRC.DiracML.translate u φ) = FRC.DiracML.herm ψ φ) ∧ ∀ {K : Type u_3} [CommRing K] [StarRing K] {G : Type u_4} [AddGroup G] [Fintype G] (u : G) (ψ φ : G → K), FRC.DiracML.herm (FRC.DiracML.translate u ψ) φ = FRC.DiracML.herm ψ (FRC.DiracML.translate (-u) φ) :=
  And.intro @FRC.DiracML.herm_translate (@FRC.DiracML.herm_translate_adjoint)
/-- p08059 — 8:C9. The finite Laplacian of an ordered basis is self-adjoint, each of its summands being self-adjoint. -/
theorem p08059 : ∀ {K : Type u_1} [CommRing K] [StarRing K] {G : Type u_2} [AddGroup G] [Fintype G] (e : G) (ψ φ : G → K), FRC.DiracML.herm (FRC.DiracML.laplacian e ψ) φ = FRC.DiracML.herm ψ (FRC.DiracML.laplacian e φ) :=
  @FRC.DiracML.herm_laplacian
/-- p08061 — 8:C11. Every finite Hamiltonian is self-adjoint: the Laplacian and the potential are, and the stiffness is Frobenius-fixed. -/
theorem p08061 : ∀ {K : Type u_1} [CommRing K] [StarRing K] {G : Type u_2} [AddGroup G] [Fintype G] (e : G) (ϰ : K), star ϰ = ϰ → ∀ (V : G → K), (∀ (x : G), star (V x) = V x) → ∀ (ψ φ : G → K), FRC.DiracML.herm (FRC.DiracML.hamiltonian e ϰ V ψ) φ = FRC.DiracML.herm ψ (FRC.DiracML.hamiltonian e ϰ V φ) :=
  @FRC.DiracML.herm_hamiltonian
/-- p08063 — 8:C13. Frame covariance: a change of basis by an invertible matrix intertwines, through the pullback of functions, the translations, the differences and the Laplacians of the two frames. -/
theorem p08063 : ∀ {K : Type u_1} [CommRing K] {G : Type u_2} [AddGroup G] (A : G ≃+ G) (e : G) (ψ : G → K), FRC.DiracML.translate (A e) (FRC.DiracML.pullback A ψ) = FRC.DiracML.pullback A (FRC.DiracML.translate e ψ) ∧ FRC.DiracML.laplacian (A e) (FRC.DiracML.pullback A ψ) = FRC.DiracML.pullback A (FRC.DiracML.laplacian e ψ) :=
  @FRC.DiracML.translate_covariance
/-- p08065 — 8:C15. Finite periodicity: every Cayley orbit is periodic, the unitary group of the finite space being finite. -/
theorem p08065 : ∀ {R : Type u_1} [Ring R] [Finite R] (u : Rˣ), IsOfFinOrder u :=
  @FRC.DiracML.cayley_periodic
/-- p08066 — 8:C16. The forward step: the orientation gauge $\alpha\mapsto-\alpha$ inverts every value of the Cayley map, the same $\Z_2$ as the derived orientation; the forward parameter composes the two quarter-turns and gives the finite Crank--Nicolson form at unit stiffness. -/
theorem p08066 : ∀ {F : Type u_1} [Field F] {ν : F}, ¬IsSquare ν → ∀ (k t : F), FRC.DiracML.Ext.cayley (-k) t * FRC.DiracML.Ext.cayley k t = (1 : FRC.Extension.Ext F ν) :=
