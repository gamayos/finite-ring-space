/-- p08075 — 8:E7. Kinetic Hamiltonians are fully admissible: a nilpotent Hamiltonian, the kinetic Hamiltonian and the symmetric Dirac operator among them, has every trace-zero parameter admissible, on every shell. -/
theorem p08075 : (∀ {R : Type u_1} [Ring R] {p : ℕ} [hp : Fact (Nat.Prime p)] [CharP R p] {t c a : R}, t ^ p = (1 : R) → Commute c t → Commute a t → Commute a c → have h := c * (t + t ^ (p - (1 : ℕ)) - (2 : R)); (a * h) ^ p = (0 : R) ∧ IsNilpotent (a * h) ∧ IsUnit ((1 : R) - a * h)) ∧ ∀ {R : Type u_2} [Ring R] {p : ℕ} [hp : Fact (Nat.Prime p)] [CharP R p] {t : R}, t ^ p = (1 : R) → (t - (1 : R)) ^ p = (0 : R) :=
  And.intro @FRC.DiracML.kinetic_nilpotent (@FRC.DiracML.translation_nilpotent)
