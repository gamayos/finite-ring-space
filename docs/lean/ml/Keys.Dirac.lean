theorem p08022 : (∀ {K : Type u_1} [CommRing K] {i w ν : K}, i * i = (-1 : K) → w * w = ν → FRC.DiracML.γ0 i w * FRC.DiracML.γ0 i w = -ν • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ1 i * FRC.DiracML.γ1 i = (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ2 i * FRC.DiracML.γ2 i = (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ3 i * FRC.DiracML.γ3 i = (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ0 i w * FRC.DiracML.γ1 i + FRC.DiracML.γ1 i * FRC.DiracML.γ0 i w = (0 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ0 i w * FRC.DiracML.γ2 i + FRC.DiracML.γ2 i * FRC.DiracML.γ0 i w = (0 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ0 i w * FRC.DiracML.γ3 i + FRC.DiracML.γ3 i * FRC.DiracML.γ0 i w = (0 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ1 i * FRC.DiracML.γ2 i + FRC.DiracML.γ2 i * FRC.DiracML.γ1 i = (0 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ1 i * FRC.DiracML.γ3 i + FRC.DiracML.γ3 i * FRC.DiracML.γ1 i = (0 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.γ2 i * FRC.DiracML.γ3 i + FRC.DiracML.γ3 i * FRC.DiracML.γ2 i = (0 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K)) ∧ ∀ {K : Type u_2} [CommRing K] {i : K}, i * i = (-1 : K) → FRC.DiracML.σ1 * FRC.DiracML.σ1 = (1 : Matrix (Fin (2 : ℕ)) (Fin (2 : ℕ)) K) ∧ FRC.DiracML.σ2 i * FRC.DiracML.σ2 i = (1 : Matrix (Fin (2 : ℕ)) (Fin (2 : ℕ)) K) ∧ FRC.DiracML.σ3 * FRC.DiracML.σ3 = (1 : Matrix (Fin (2 : ℕ)) (Fin (2 : ℕ)) K) ∧ FRC.DiracML.σ1 * FRC.DiracML.σ2 i + FRC.DiracML.σ2 i * FRC.DiracML.σ1 = (0 : Matrix (Fin (2 : ℕ)) (Fin (2 : ℕ)) K) ∧ FRC.DiracML.σ1 * FRC.DiracML.σ3 + FRC.DiracML.σ3 * FRC.DiracML.σ1 = (0 : Matrix (Fin (2 : ℕ)) (Fin (2 : ℕ)) K) ∧ FRC.DiracML.σ2 i * FRC.DiracML.σ3 + FRC.DiracML.σ3 * FRC.DiracML.σ2 i = (0 : Matrix (Fin (2 : ℕ)) (Fin (2 : ℕ)) K) :=
