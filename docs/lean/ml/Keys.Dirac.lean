/-- p08067 — 8:D14. The boost is orthogonal: $\Lambda(x,y)$ preserves the coordinate form, by $A^2-\nu B^2=1$. -/
theorem p08067 : (∀ {F : Type u_1} [Field F] (ν x y u v : F), x ^ (2 : ℕ) - ν * y ^ (2 : ℕ) ≠ (0 : F) → u ^ (2 : ℕ) - ν * v ^ (2 : ℕ) ≠ (0 : F) → FRC.DiracML.Aent ν x y ^ (2 : ℕ) - ν * FRC.DiracML.Bent ν x y ^ (2 : ℕ) = (1 : F) ∧ FRC.DiracML.Aent ν x y * FRC.DiracML.Aent ν u v + ν * (FRC.DiracML.Bent ν x y * FRC.DiracML.Bent ν u v) = FRC.DiracML.Aent ν (x * u + ν * y * v) (x * v + y * u) ∧ FRC.DiracML.Aent ν x y * FRC.DiracML.Bent ν u v + FRC.DiracML.Bent ν x y * FRC.DiracML.Aent ν u v = FRC.DiracML.Bent ν (x * u + ν * y * v) (x * v + y * u) ∧ FRC.DiracML.Aent ν (1 : F) (0 : F) = (1 : F) ∧ FRC.DiracML.Bent ν (1 : F) (0 : F) = (0 : F) ∧ FRC.DiracML.Aent ν x (-y) = FRC.DiracML.Aent ν x y ∧ FRC.DiracML.Bent ν x (-y) = -FRC.DiracML.Bent ν x y) ∧ ∀ {F : Type u_2} [Field F] {ν : F} (z : (FRC.Extension.Ext F ν)ˣ), FRC.DiracML.Ext.boost z ∈ FRC.DiracML.Ext.normOneGroup F ν :=
  And.intro @FRC.DiracML.boost_entries (@FRC.DiracML.Ext.boost_mem)
/-- p08068 — 8:D15. The boosts form a subgroup of the orthogonal group: the product of two boosts is the boost of the product in the extension, the identity and the inverse are boosts. -/
theorem p08068 : ∀ {F : Type u_1} [Field F] (ν x y u v : F), x ^ (2 : ℕ) - ν * y ^ (2 : ℕ) ≠ (0 : F) → u ^ (2 : ℕ) - ν * v ^ (2 : ℕ) ≠ (0 : F) → FRC.DiracML.Aent ν x y ^ (2 : ℕ) - ν * FRC.DiracML.Bent ν x y ^ (2 : ℕ) = (1 : F) ∧ FRC.DiracML.Aent ν x y * FRC.DiracML.Aent ν u v + ν * (FRC.DiracML.Bent ν x y * FRC.DiracML.Bent ν u v) = FRC.DiracML.Aent ν (x * u + ν * y * v) (x * v + y * u) ∧ FRC.DiracML.Aent ν x y * FRC.DiracML.Bent ν u v + FRC.DiracML.Bent ν x y * FRC.DiracML.Aent ν u v = FRC.DiracML.Bent ν (x * u + ν * y * v) (x * v + y * u) ∧ FRC.DiracML.Aent ν (1 : F) (0 : F) = (1 : F) ∧ FRC.DiracML.Bent ν (1 : F) (0 : F) = (0 : F) ∧ FRC.DiracML.Aent ν x (-y) = FRC.DiracML.Aent ν x y ∧ FRC.DiracML.Bent ν x (-y) = -FRC.DiracML.Bent ν x y :=
  @FRC.DiracML.boost_entries
/-- p08069 — 8:D16. The explicit transported form: the transported Dirac operator is the Dirac operator of the transported frame with the transported gamma matrices, the spin conjugates of the standard ones. -/
theorem p08069 : ∀ {K : Type u_1} [CommRing K] {i w ν : K}, i * i = (-1 : K) → w * w = ν → ∀ (x y : K), FRC.DiracML.Mγ i w * FRC.DiracML.Mγ i w = ν • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + -y • FRC.DiracML.Mγ i w) * FRC.DiracML.γ0 i w * (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + y • FRC.DiracML.Mγ i w) = (x ^ (2 : ℕ) + ν * y ^ (2 : ℕ)) • FRC.DiracML.γ0 i w + -((2 : K) * x * y * ν) • FRC.DiracML.γ1 i ∧ (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + -y • FRC.DiracML.Mγ i w) * FRC.DiracML.γ1 i * (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + y • FRC.DiracML.Mγ i w) = -((2 : K) * x * y) • FRC.DiracML.γ0 i w + (x ^ (2 : ℕ) + ν * y ^ (2 : ℕ)) • FRC.DiracML.γ1 i ∧ FRC.DiracML.Mγ i w * FRC.DiracML.γ2 i = FRC.DiracML.γ2 i * FRC.DiracML.Mγ i w ∧ FRC.DiracML.Mγ i w * FRC.DiracML.γ3 i = FRC.DiracML.γ3 i * FRC.DiracML.Mγ i w :=
