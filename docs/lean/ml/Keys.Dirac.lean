/-- p08008 — 8:B2. The class is the datum: the nonsquares form one square class, and the Lorentzian form depends on its coefficient through that class alone. -/
theorem p08008 : (∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {a b : ZMod p}, a ≠ (0 : ZMod p) → b ≠ (0 : ZMod p) → ¬IsSquare a → ¬IsSquare b → IsSquare (a * b)) ∧ ∀ {K : Type u_1} [CommRing K] (ν m x₀ x₁ x₂ x₃ : K), -(m ^ (2 : ℕ) * ν) * x₀ ^ (2 : ℕ) + x₁ ^ (2 : ℕ) + x₂ ^ (2 : ℕ) + x₃ ^ (2 : ℕ) = -ν * (m * x₀) ^ (2 : ℕ) + x₁ ^ (2 : ℕ) + x₂ ^ (2 : ℕ) + x₃ ^ (2 : ℕ) :=
  And.intro @FRC.DiracML.class_datum (@FRC.DiracML.form_class)
/-- p08009 — 8:B3. The drive is canonical: the drive multiplier is a nonsquare on every shell and the only named residue that is one on every symmetry-complete shell; the classes of $2$, $2^{-1}$, $-2$, $\pi=-2^{-1}$ and $\im$ are fixed by the parity of $\kap$, that of $e$ by no rule; the reframing flip keeps the class. Decided on $\p<2000$. -/
theorem p08009 : (∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {g : ZMod p}, orderOf g = p - (1 : ℕ) → p % (2 : ℕ) = (1 : ℕ) → ¬IsSquare g ∧ ¬IsSquare g⁻¹) ∧ (∀ (κ : ℕ) [hp' : Fact (Nat.Prime ((4 : ℕ) * κ + (1 : ℕ)))] {g : ZMod ((4 : ℕ) * κ + (1 : ℕ))}, orderOf g = (4 : ℕ) * κ → (IsSquare (2 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) ↔ Even κ) ∧ (IsSquare (2 : ZMod ((4 : ℕ) * κ + (1 : ℕ)))⁻¹ ↔ Even κ) ∧ (IsSquare (-2 : ZMod ((4 : ℕ) * κ + (1 : ℕ))) ↔ Even κ) ∧ (IsSquare (g ^ ((3 : ℕ) * κ)) ↔ Even κ) ∧ g ^ ((3 : ℕ) * κ) = -g ^ κ ∧ IsSquare (-1 : ZMod ((4 : ℕ) * κ + (1 : ℕ)))) ∧ FRC.DiracML.Aent (2 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) = (10 : ZMod (13 : ℕ)) ∧ FRC.DiracML.Bent (2 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) (1 : ZMod (13 : ℕ)) = (2 : ZMod (13 : ℕ)) ∧ (10 : ZMod (13 : ℕ)) ^ (2 : ℕ) - (2 : ZMod (13 : ℕ)) * (2 : ZMod (13 : ℕ)) ^ (2 : ℕ) = (1 : ZMod (13 : ℕ)) ∧ (2 : ZMod (13 : ℕ)) * (7 : ZMod (13 : ℕ)) = (1 : ZMod (13 : ℕ)) ∧ ¬IsSquare (7 : ZMod (13 : ℕ)) ∧ (2 : ZMod (13 : ℕ)) ^ (5 : ℕ) = (6 : ZMod (13 : ℕ)) ∧ ¬IsSquare (6 : ZMod (13 : ℕ)) ∧ orderOf (2 : ZMod (13 : ℕ)) = (12 : ℕ) :=
  And.intro @FRC.DiracML.drive_nonsquare (And.intro @FRC.DiracML.named_residues (@FRC.DiracML.shell13))
/-- p08011 — 8:B5. The square class is chronon parity: the squares are the even drive steps, a residue's class the parity of its drive-step count; on $\kap$-even shells the whole quarter-turn group is square, so the order-four chart grading carries no signature. Decided on every primitive root of $\F_{13}$ and $\F_{173}$ and on $\p<2000$. -/
theorem p08011 : ∀ {p : ℕ} [hp : Fact (Nat.Prime p)] {g : ZMod p}, orderOf g = p - (1 : ℕ) → p % (2 : ℕ) = (1 : ℕ) → ∀ (k : ℕ), IsSquare (g ^ k) ↔ Even k :=
  @FRC.DiracML.parity_iff
/-- p08012 — 8:B6. Norm growth and parity: one chronon of drive scales every Frobenius norm by the square $g^2$; the single-chronon multiplier is odd and has no square root in $\Fp$; the flip $g\mapsto g^{-1}$ preserves the parity class. -/
theorem p08012 : (∀ {K : Type u_1} [Field K] {ν : K} (g : K) (z : FRC.Extension.Ext K ν), (FRC.Extension.Ext.ofBase g * z).norm = g ^ (2 : ℕ) * z.norm) ∧ ∀ {F : Type u_2} [CommRing F] {ν : F} (z z' : FRC.DiracML.Ext F ν), (z * z').norm = z.norm * z'.norm :=
  And.intro @FRC.DiracML.norm_growth (@FRC.DiracML.Ext.norm_mul)
/-- p08013 — 8:B7. Signature lives on $\Fp$: the Euclidean form is hyperbolic and $Q_\nu$ elliptic, with the zero counts of the two classes on every symmetry-complete shell below $60$; over $K$ every element of $\Fp$ is a square and the dichotomy collapses. -/
theorem p08013 : ∀ {p : Nat} [hp : Fact (Nat.Prime p)] {ν : ZMod p}, Not (@IsSquare (ZMod p) (@Distrib.toMul (ZMod p) (@instDistribOfSemiring (ZMod p) (@CommSemiring.toSemiring (ZMod p) (@Semifield.toCommSemiring (ZMod p) (@Field.toSemifield (ZMod p) (@ZMod.instField p hp)))))) ν) → ∀ (a : ZMod p), @IsSquare (FRC.Extension.Ext (ZMod p) ν) (@FRC.Extension.Ext.instMul (ZMod p) (ZMod.commRing p) ν) (@FRC.Extension.Ext.ofBase (ZMod p) (ZMod.commRing p) ν a) :=
  @FRC.DiracML.ext_square
