/-- p08026 — 8:D6. Spin conjugation: the lift carries the two temporal gamma matrices to the stated combinations and fixes the other two. -/
theorem p08026 : (∀ {K : Type u_1} [CommRing K] {i w ν : K}, i * i = (-1 : K) → w * w = ν → ∀ (x y : K), FRC.DiracML.Mγ i w * FRC.DiracML.Mγ i w = ν • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + -y • FRC.DiracML.Mγ i w) * FRC.DiracML.γ0 i w * (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + y • FRC.DiracML.Mγ i w) = (x ^ (2 : ℕ) + ν * y ^ (2 : ℕ)) • FRC.DiracML.γ0 i w + -((2 : K) * x * y * ν) • FRC.DiracML.γ1 i ∧ (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + -y • FRC.DiracML.Mγ i w) * FRC.DiracML.γ1 i * (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + y • FRC.DiracML.Mγ i w) = -((2 : K) * x * y) • FRC.DiracML.γ0 i w + (x ^ (2 : ℕ) + ν * y ^ (2 : ℕ)) • FRC.DiracML.γ1 i ∧ FRC.DiracML.Mγ i w * FRC.DiracML.γ2 i = FRC.DiracML.γ2 i * FRC.DiracML.Mγ i w ∧ FRC.DiracML.Mγ i w * FRC.DiracML.γ3 i = FRC.DiracML.γ3 i * FRC.DiracML.Mγ i w) ∧ ∀ {F : Type u_2} [Field F] {i w ν x y : F}, i * i = (-1 : F) → w * w = ν → x ^ (2 : ℕ) - ν * y ^ (2 : ℕ) ≠ (0 : F) → (x ^ (2 : ℕ) - ν * y ^ (2 : ℕ))⁻¹ • (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) F) + -y • FRC.DiracML.Mγ i w) * FRC.DiracML.γ0 i w * (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) F) + y • FRC.DiracML.Mγ i w) = FRC.DiracML.Aent ν x y • FRC.DiracML.γ0 i w + (ν * FRC.DiracML.Bent ν x y) • FRC.DiracML.γ1 i ∧ (x ^ (2 : ℕ) - ν * y ^ (2 : ℕ))⁻¹ • (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) F) + -y • FRC.DiracML.Mγ i w) * FRC.DiracML.γ1 i * (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) F) + y • FRC.DiracML.Mγ i w) = FRC.DiracML.Bent ν x y • FRC.DiracML.γ0 i w + FRC.DiracML.Aent ν x y • FRC.DiracML.γ1 i :=
  And.intro @FRC.DiracML.spin_conjugation (@FRC.DiracML.spin_conjugation_AB)
/-- p08027 — 8:D7. The pullback intertwines the differences of the two frames: the difference along a transported basis vector of the pulled-back field is the pulled-back difference. -/
theorem p08027 : ∀ {K : Type u_1} [CommRing K] {G : Type u_2} [AddGroup G] (A : G ≃+ G) (e : G) (ψ : G → K), FRC.DiracML.translate (A e) (FRC.DiracML.pullback A ψ) = FRC.DiracML.pullback A (FRC.DiracML.translate e ψ) ∧ FRC.DiracML.laplacian (A e) (FRC.DiracML.pullback A ψ) = FRC.DiracML.pullback A (FRC.DiracML.laplacian e ψ) :=
  @FRC.DiracML.translate_covariance
/-- p08029 — 8:D9. The spinor form: under the plain conjugate transpose the gamma matrices carry mixed signs and the $\gamma^0$-twist fails; the odd product $X=\gamma^0\gamma^1\gamma^3$ is Hermitian with square $\nu$ and makes every gamma matrix anti-self-adjoint; the symmetric Dirac operator is self-adjoint and nilpotent for the $X$-form. Decided at $\p=13$, $173$ and $1549$. -/
theorem p08029 : (∀ {K : Type u_1} [CommRing K] {i w ν : K}, i * i = (-1 : K) → w * w = ν → FRC.DiracML.Xγ i w * FRC.DiracML.Xγ i w = ν • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) ∧ FRC.DiracML.Xγ i w * FRC.DiracML.γ0 i w = FRC.DiracML.γ0 i w * FRC.DiracML.Xγ i w ∧ FRC.DiracML.Xγ i w * FRC.DiracML.γ1 i = FRC.DiracML.γ1 i * FRC.DiracML.Xγ i w ∧ FRC.DiracML.Xγ i w * FRC.DiracML.γ3 i = FRC.DiracML.γ3 i * FRC.DiracML.Xγ i w ∧ FRC.DiracML.Xγ i w * FRC.DiracML.γ2 i = -(FRC.DiracML.γ2 i * FRC.DiracML.Xγ i w)) ∧ (∀ {K : Type u_2} [CommRing K] [StarRing K] {i w ν : K}, i * i = (-1 : K) → w * w = ν → star i = i → star w = -w → (FRC.DiracML.γ0 i w).conjTranspose = -FRC.DiracML.γ0 i w ∧ (FRC.DiracML.γ1 i).conjTranspose = -FRC.DiracML.γ1 i ∧ (FRC.DiracML.γ2 i).conjTranspose = FRC.DiracML.γ2 i ∧ (FRC.DiracML.γ3 i).conjTranspose = -FRC.DiracML.γ3 i ∧ (FRC.DiracML.Xγ i w).conjTranspose = FRC.DiracML.Xγ i w) ∧ ∀ {K : Type u_3} [CommRing K] [StarRing K] {i w ν : K}, i * i = (-1 : K) → w * w = ν → star i = i → star w = -w → (FRC.DiracML.γ0 i w).conjTranspose * FRC.DiracML.Xγ i w = -(FRC.DiracML.Xγ i w * FRC.DiracML.γ0 i w) ∧ (FRC.DiracML.γ1 i).conjTranspose * FRC.DiracML.Xγ i w = -(FRC.DiracML.Xγ i w * FRC.DiracML.γ1 i) ∧ (FRC.DiracML.γ2 i).conjTranspose * FRC.DiracML.Xγ i w = -(FRC.DiracML.Xγ i w * FRC.DiracML.γ2 i) ∧ (FRC.DiracML.γ3 i).conjTranspose * FRC.DiracML.Xγ i w = -(FRC.DiracML.Xγ i w * FRC.DiracML.γ3 i) ∧ (FRC.DiracML.γ0 i w).conjTranspose * FRC.DiracML.γ0 i w = -(FRC.DiracML.γ0 i w * FRC.DiracML.γ0 i w) ∧ (FRC.DiracML.γ1 i).conjTranspose * FRC.DiracML.γ0 i w = FRC.DiracML.γ0 i w * FRC.DiracML.γ1 i :=
  And.intro @FRC.DiracML.spinor_twist (And.intro @FRC.DiracML.gamma_dagger (@FRC.DiracML.twist_adjoint))
/-- p08030 — 8:D10. Exact Dirac evolution: the Cayley step of the symmetric Dirac operator shifted by the mass preserves the $X$-form; massless it is unipotent with order a power of $\p$; massive it is the norm-one phase of the mass times a unipotent, and its order is their least common multiple ($169=\p^{2}$, $1183$, $2366$ for $m=0,1,2$ in $1{+}1$ at $\p=13$). -/
theorem p08030 : (∀ {R : Type u_1} [Ring R] (σ : R → R), (∀ (x y : R), σ (x * y) = σ y * σ x) → (∀ (x y : R), σ (x + y) = σ x + σ y) → σ (1 : R) = (1 : R) → (∀ (x : R), σ (-x) = -σ x) → ∀ {h a : R}, σ h = h → σ a = -a → (∀ (x : R), Commute a x) → ∀ (hu : IsUnit ((1 : R) - a * h)), have u := ↑hu.unit⁻¹ * ((1 : R) + a * h); σ u * u = (1 : R)) ∧ ∀ {R : Type u_2} [Ring R] {p : ℕ} [hp : Fact (Nat.Prime p)] [CharP R p] {t : R}, t ^ p = (1 : R) → (t - (1 : R)) ^ p = (0 : R) :=
  And.intro @FRC.DiracML.cayley_unitary (@FRC.DiracML.translation_nilpotent)
/-- p08031 — 8:D11. The two Dirac operators are one covariant family: the pullback identity holds for the symmetric differences, the transport carries the symmetric operator to its transported form, and the spinor form transports by the norm of the lift: norm-one lifts preserve it, the odd coset scales it by the nonsquare class. -/
theorem p08031 : (∀ {K : Type u_1} [CommRing K] [StarRing K] {i w ν x y : K}, i * i = (-1 : K) → w * w = ν → star w = -w → star x = x → star y = y → (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + y • FRC.DiracML.Mγ i w).conjTranspose = x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + -y • FRC.DiracML.Mγ i w ∧ (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + -y • FRC.DiracML.Mγ i w) * (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + y • FRC.DiracML.Mγ i w) = (x ^ (2 : ℕ) - ν * y ^ (2 : ℕ)) • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K)) ∧ ∀ {K : Type u_2} [CommRing K] [StarRing K] {i w ν x y : K}, i * i = (-1 : K) → w * w = ν → star i = i → star w = -w → star x = x → star y = y → (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + y • FRC.DiracML.Mγ i w).conjTranspose * FRC.DiracML.Xγ i w * (x • (1 : Matrix (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) (Fin (2 : ℕ) ⊕ Fin (2 : ℕ)) K) + y • FRC.DiracML.Mγ i w) = (x ^ (2 : ℕ) - ν * y ^ (2 : ℕ)) • FRC.DiracML.Xγ i w :=
  And.intro @FRC.DiracML.lift_adjoint (@FRC.DiracML.lift_transport)
