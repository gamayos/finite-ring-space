namespace FRC.FieldsML

open Real

/-- 27:C1 — the phase cycle inside `U(1)`: `ζ_M = exp(2πi/M)` is a primitive `M`-th root of unity, `k ↦ ζ_M^k` is a
homomorphism of the cycle (`ζ^{j+k} = ζ^j ζ^k`), injective on `0 ≤ k < M`, and every image is an `M`-th root. -/
theorem roots_inclusion (M : ℕ) (hM : M ≠ 0) :
    IsPrimitiveRoot (Complex.exp (2 * π * Complex.I / M)) M ∧
    (∀ j k : ℕ, Complex.exp (2 * π * Complex.I / M) ^ (j + k) =
      Complex.exp (2 * π * Complex.I / M) ^ j * Complex.exp (2 * π * Complex.I / M) ^ k) ∧
    (∀ j k : ℕ, j < M → k < M →
      Complex.exp (2 * π * Complex.I / M) ^ j = Complex.exp (2 * π * Complex.I / M) ^ k → j = k) ∧
    (∀ k : ℕ, (Complex.exp (2 * π * Complex.I / M) ^ k) ^ M = 1) := by
  have h := Complex.isPrimitiveRoot_exp M hM
  refine ⟨h, fun j k => pow_add _ _ _, fun j k hj hk e => h.pow_inj hj hk e, fun k => ?_⟩
  rw [← pow_mul, Nat.mul_comm k M, pow_mul, h.pow_eq_one, one_pow]

/-- 27:C1 — the Wilson weight on the unit circle: for `‖ζ‖ = 1`, `0 ≤ 1 − Re ζ`, with equality exactly at `ζ = 1`. -/
theorem wilson_weight_nonneg (ζ : ℂ) (h : ‖ζ‖ = 1) : 0 ≤ 1 - ζ.re ∧ (1 - ζ.re = 0 ↔ ζ = 1) := by
  have hre : ζ.re ≤ 1 := h ▸ Complex.re_le_norm ζ
  refine ⟨by linarith, ⟨fun h0 => ?_, fun h1 => by rw [h1]; simp⟩⟩
  have hre1 : ζ.re = 1 := by linarith
  have h2 : ζ.re * ζ.re + ζ.im * ζ.im = 1 := by
    rw [← Complex.normSq_apply, Complex.normSq_eq_norm_sq, h, one_pow]
  have him : ζ.im = 0 := by nlinarith
  exact Complex.ext (by simpa using hre1) (by simpa using him)

/-- 27:C1, 27:C7, 27:X7 — the area law from positivity on `2T`: for `x = e^{β/2} > 1` the coefficient
`c₁ = (x⁴ + 4x³ − 4x − 1)/(x⁴ + 8x³ + 6x² + 8x + 1)` lies in `(0, 1)`, so the string tension `σ = −ln c₁` is positive. -/
theorem area_law_positive (x : ℝ) (hx : 1 < x) :
    0 < (x ^ 4 + 4 * x ^ 3 - 4 * x - 1) / (x ^ 4 + 8 * x ^ 3 + 6 * x ^ 2 + 8 * x + 1) ∧
    (x ^ 4 + 4 * x ^ 3 - 4 * x - 1) / (x ^ 4 + 8 * x ^ 3 + 6 * x ^ 2 + 8 * x + 1) < 1 := by
  have hx0 : 0 < x := by linarith
  have hD : 0 < x ^ 4 + 8 * x ^ 3 + 6 * x ^ 2 + 8 * x + 1 := by positivity
  have hN : 0 < x ^ 4 + 4 * x ^ 3 - 4 * x - 1 := by
    have e : x ^ 4 + 4 * x ^ 3 - 4 * x - 1 = (x - 1) * (x ^ 3 + 5 * x ^ 2 + 5 * x + 1) := by ring
    rw [e]; exact mul_pos (by linarith) (by positivity)
  refine ⟨div_pos hN hD, (div_lt_one hD).2 ?_⟩
  nlinarith

/-- 27:C6 — the Fermi constant: with `M_W² = g² v²/4` and `G_F/√2 = g²/(8 M_W²)`, `G_F = 1/(√2 v²)`. -/
theorem fermi_constant (g v G MW2 : ℝ) (hg : g ≠ 0) (hv : v ≠ 0) (hM : MW2 = g ^ 2 * v ^ 2 / 4)
    (hG : G / √2 = g ^ 2 / (8 * MW2)) : G = 1 / (√2 * v ^ 2) := by
  have hv2 : v ^ 2 ≠ 0 := pow_ne_zero 2 hv
  have hg2 : g ^ 2 ≠ 0 := pow_ne_zero 2 hg
  have hs : (√2 : ℝ) ≠ 0 := by positivity
  have h2 : (√2 : ℝ) * √2 = 2 := Real.mul_self_sqrt (by norm_num)
  have e : G / √2 = 1 / (2 * v ^ 2) := by rw [hG, hM]; field_simp; ring
  calc G = √2 * (G / √2) := by field_simp
    _ = √2 * (1 / (2 * v ^ 2)) := by rw [e]
    _ = 1 / (√2 * v ^ 2) := by
        rw [mul_one_div, div_eq_div_iff (mul_ne_zero two_ne_zero hv2) (mul_ne_zero hs hv2), ← mul_assoc, h2, one_mul]

/-- 27:P3 [chart] — the one-loop running of the measured couplings with the Standard-Model coefficients
`b = (41/10, −19/6, −7)`: at the meeting `α₁ = α₂` the strong coupling misses by less than a fifth, and the meeting
scale `M_Z e^{2πu}` lies in `[10¹², 10¹⁴]` GeV. The inputs are the measured `α⁻¹(M_Z) = 127.951`, `sin²θ_W = 0.23121`,
`α_s = 0.1179` and `M_Z = 91.1876` GeV (the paper's A6). -/
theorem running_near_miss (ainv s2 as b1 b2 b3 MZ : ℝ) (h1 : ainv = 127.951) (h2 : s2 = 0.23121)
    (h3 : as = 0.1179) (hb1 : b1 = 41 / 10) (hb2 : b2 = -19 / 6) (hb3 : b3 = -7) (hZ : MZ = 91.1876) :
    |1 / as - b3 * ((3 / 5 * (1 - s2) * ainv - s2 * ainv) / (b1 - b2)) - (s2 * ainv - b2 * ((3 / 5 * (1 - s2) * ainv - s2 * ainv) / (b1 - b2)))| / (s2 * ainv - b2 * ((3 / 5 * (1 - s2) * ainv - s2 * ainv) / (b1 - b2))) < 1 / 5 ∧
    (10 : ℝ) ^ 12 < MZ * exp (2 * π * ((3 / 5 * (1 - s2) * ainv - s2 * ainv) / (b1 - b2))) ∧
    MZ * exp (2 * π * ((3 / 5 * (1 - s2) * ainv - s2 * ainv) / (b1 - b2))) < (10 : ℝ) ^ 14 := by
  set u : ℝ := ((3 / 5 * (1 - s2) * ainv - s2 * ainv) / (b1 - b2)) with hudef
  have hu : u = (3 / 5 * (1 - 0.23121) * 127.951 - 0.23121 * 127.951) / (41 / 10 - -19 / 6) := by
    rw [hudef, h1, h2, hb1, hb2]
  have hu25 : 25 < 2 * π * u := by
    rw [hu]; nlinarith [pi_gt_d2]
  have hu26 : 2 * π * u < 26 := by
    rw [hu]; nlinarith [pi_lt_d2]
  have e25 : (2.7182818283 : ℝ) ^ 25 < exp (2 * π * u) := by
    calc (2.7182818283 : ℝ) ^ 25 < exp 1 ^ 25 := by
          exact pow_lt_pow_left₀ exp_one_gt_d9 (by norm_num) (by norm_num)
      _ = exp 25 := by rw [← exp_nat_mul]; norm_num
      _ < exp (2 * π * u) := exp_lt_exp.2 hu25
  have e26 : exp (2 * π * u) < (2.7182818286 : ℝ) ^ 26 := by
    calc exp (2 * π * u) < exp 26 := exp_lt_exp.2 hu26
      _ = exp 1 ^ 26 := by rw [← exp_nat_mul]; norm_num
      _ < (2.7182818286 : ℝ) ^ 26 := pow_lt_pow_left₀ exp_one_lt_d9 (exp_pos 1).le (by norm_num)
  refine ⟨?_, ?_, ?_⟩
  · rw [hu, h1, h2, h3, hb2, hb3]; norm_num [abs_lt]
  · rw [hZ]; nlinarith [e25]
  · rw [hZ]; nlinarith [e26]

/-- 27:P4 [chart] — the proton lifetime `τ_p = M_X⁴/(α² m_p⁵)` in years, with `m_p = 0.938` GeV, `α_GUT = 1/40`,
`ħ = 6.582 × 10⁻²⁵` GeV s and the year `3.156 × 10⁷` s: at the Planck scale `M_X = 1.22 × 10¹⁹` GeV it exceeds `10⁴⁵` yr,
at `M_X = 10¹⁶` GeV it exceeds the Super-Kamiokande bound `10³⁴` yr, and two lifetimes stand in the ratio `(M′/M)⁴`. -/
theorem proton_lifetime (mp a hbar yr : ℚ) (hm : mp = 0.938) (ha : a = 1 / 40) (hh : hbar = 6.582e-25)
    (hy : yr = 3.156e7) :
    (10 : ℚ) ^ 45 ≤ (1.22e19 : ℚ) ^ 4 / (a ^ 2 * mp ^ 5) * hbar / yr ∧
    (10 : ℚ) ^ 34 < (1e16 : ℚ) ^ 4 / (a ^ 2 * mp ^ 5) * hbar / yr ∧
    ∀ M M' : ℚ, 0 < M → 0 < M' →
      (M' ^ 4 / (a ^ 2 * mp ^ 5) * hbar / yr) / (M ^ 4 / (a ^ 2 * mp ^ 5) * hbar / yr) = (M' / M) ^ 4 := by
  subst hm ha hh hy
  refine ⟨by norm_num, by norm_num, fun M M' hM hM' => ?_⟩
  have hM0 : M ≠ 0 := hM.ne'
  field_simp

/-- 27:P5 [chart] — the seesaw `m_ν = y² v²/M_R` with `v = 174` GeV: for `y = 0.3` at `M_R = 10¹⁴` GeV and for `y = 1`
at `M_R = 10¹⁵` GeV the light mass lies in `(0.01, 0.1)` eV; and `m_b/m_τ = 4.18/1.777` lies in `(2, 3)`. -/
theorem seesaw_band (v mb mt : ℚ) (hv : v = 174) (hb : mb = 4.18) (ht : mt = 1.777) :
    (0.01 : ℚ) < (0.3 : ℚ) ^ 2 * v ^ 2 / 1e14 * 1e9 ∧ (0.3 : ℚ) ^ 2 * v ^ 2 / 1e14 * 1e9 < 0.1 ∧
    (0.01 : ℚ) < (1 : ℚ) ^ 2 * v ^ 2 / 1e15 * 1e9 ∧ (1 : ℚ) ^ 2 * v ^ 2 / 1e15 * 1e9 < 0.1 ∧
    (2 : ℚ) < mb / mt ∧ mb / mt < 3 := by
  subst hv hb ht
  norm_num

end FRC.FieldsML

/-! inlined: FrcMathlib/Theme/Flavour.lean (verbatim, minus its import lines) -/

/-!
# FrcMathlib.Theme.Flavour — the chart theme's readings of the flavour sector (28-flavour, 17 October 2026)

The clauses of 28-flavour that read measured data against the exact content of `FrcCore/Theme/Flavour.lean`. Every
measured input enters as a hypothesis (the masses in MeV as the paper's validation suite states them, the NuFIT 6.0 splittings in eV² and angles, `V_us`),
every conclusion is a rational bound, and the square roots are bracketed by their squares (`Real.lt_sqrt`,
`Real.sqrt_lt'`), so that `norm_num` and `nlinarith` decide the reading. The charged-lepton Koide value to `10⁻⁵`
(`koide_measured`, 28:P1, X1); the up-quark Koide value in three schemes, all inside the band `[0.83, 0.89]` that holds
`5/6` (`koide_up_band`, 28:C4, X2, P2); the Gatto relation's leading term within `0.3 %` of `V_us` and its value at
`φ = π/2` (`gatto_leading`, 28:C6, X4, P3); the effective Froggatt–Nielsen powers bracketed by the integers `(4, 2)`,
`(4, 2)`, `(8, 4)` (`texture_powers`, 28:C7, X3, X6); the Georgi–Jarlskog double ratio and its `10–20 %` excess over `9`
(`gj_ratio`, 28:X5); the leading-order mass ratio `7 − 4√3` (`lo_ratio`, 28:C3, X7); the reactor-angle estimate `6–7 %`
above the measured value (`theta13_estimate`, 28:C9, X9); the maximal Jarlskog `1/(6√3)` and `J² = 1/108` (`jarlskog`,
28:C10, X10, P8); the TM2 relation at maximal atmospheric mixing (`tm2_at_maximal`, 28:C10, P8); the exact-TM2 solar
value (`exact_tm2_solar`, 28:C10); the `m₁ = 0` floor of the neutrino mass sum (`neutrino_floor`, 28:P5, P6, X11); and
the effective Majorana mass band at `m₁ = 0` (`majorana_band`, 28:P7).
-/

namespace FRC.FlavourML

open Real

/-- 28:P1, 28:X1 — the measured charged-lepton Koide value: with the PDG masses `m_e = 0.51099895`, `m_μ = 105.6583755`,
`m_τ = 1776.86` MeV, `|Q − 2/3| < 10⁻⁵` (the paper's `−6 × 10⁻⁶`); the square roots bracketed to seven digits. -/
theorem koide_measured (me mmu mtau : ℝ) (h1 : me = 0.51099895) (h2 : mmu = 105.6583755) (h3 : mtau = 1776.86) :
    |(me + mmu + mtau) / (sqrt me + sqrt mmu + sqrt mtau) ^ 2 - 2 / 3| < 1 / 100000 := by
  subst h1 h2 h3
  have e1 : 0.7148419 < sqrt 0.51099895 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have e2 : sqrt 0.51099895 < 0.7148420 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have m1 : 10.2790259 < sqrt 105.6583755 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have m2 : sqrt 105.6583755 < 10.2790261 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have t1 : 42.1528172 < sqrt 1776.86 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have t2 : sqrt 1776.86 < 42.1528173 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  set S := sqrt 0.51099895 + sqrt 105.6583755 + sqrt 1776.86 with hS
  have lo : 53.146685 < S := by rw [hS]; linarith
  have hi : S < 53.1466854 := by rw [hS]; linarith
  have Spos : 0 < S ^ 2 := by positivity
  rw [abs_lt]
  constructor
  · rw [lt_sub_iff_add_lt, lt_div_iff₀ Spos]; nlinarith
  · rw [sub_lt_iff_lt_add, div_lt_iff₀ Spos]; nlinarith

/-- The Koide value of three masses from brackets of their square roots: `Q = Σm/S²` with `S = Σ√m` between `lo` and
`hi`, so `Σm/hi² < Q < Σm/lo²`. -/
theorem koide_of_brackets (m1 m2 m3 lo hi : ℝ) (hm : 0 < m1 + m2 + m3) (hlo : 0 < lo)
    (h1 : lo < sqrt m1 + sqrt m2 + sqrt m3) (h2 : sqrt m1 + sqrt m2 + sqrt m3 < hi) :
    (m1 + m2 + m3) / hi ^ 2 < (m1 + m2 + m3) / (sqrt m1 + sqrt m2 + sqrt m3) ^ 2 ∧
    (m1 + m2 + m3) / (sqrt m1 + sqrt m2 + sqrt m3) ^ 2 < (m1 + m2 + m3) / lo ^ 2 := by
  have hS : 0 < sqrt m1 + sqrt m2 + sqrt m3 := lt_trans hlo h1
  constructor
  · apply div_lt_div_of_pos_left hm (by positivity)
    exact pow_lt_pow_left₀ h2 hS.le (by norm_num)
  · apply div_lt_div_of_pos_left hm (by positivity)
    exact pow_lt_pow_left₀ h1 hlo.le (by norm_num)

/-- 28:C4, 28:X2, 28:P2 — the up-quark Koide value in three schemes, each inside the band `[0.83, 0.89]` that holds the
framed value `5/6`: the working scheme (`m_u = 2.16`, `m_c = 1270`, `m_t = 172570` MeV) gives `Q_u ∈ (0.8489, 0.8490)`,
the pole masses (`2.2`, `1670`, `172800`) give `(0.8316, 0.8317)`, and MS-bar at `M_Z` (`1.27`, `619`, `168300`) gives
`(0.8875, 0.8876)`. -/
theorem koide_up_band :
    (0.8489 < (2.16 + 1270 + 172570) / (sqrt 2.16 + sqrt 1270 + sqrt 172570) ^ 2 ∧
      (2.16 + 1270 + 172570) / (sqrt 2.16 + sqrt 1270 + sqrt 172570) ^ 2 < (0.8490 : ℝ)) ∧
    (0.8316 < (2.2 + 1670 + 172800) / (sqrt 2.2 + sqrt 1670 + sqrt 172800) ^ 2 ∧
      (2.2 + 1670 + 172800) / (sqrt 2.2 + sqrt 1670 + sqrt 172800) ^ 2 < (0.8317 : ℝ)) ∧
    (0.8875 < (1.27 + 619 + 168300) / (sqrt 1.27 + sqrt 619 + sqrt 168300) ^ 2 ∧
      (1.27 + 619 + 168300) / (sqrt 1.27 + sqrt 619 + sqrt 168300) ^ 2 < (0.8876 : ℝ)) ∧
    (0.83 : ℝ) < 5 / 6 ∧ (5 / 6 : ℝ) < 0.89 := by
  have w1 : 1.4696938 < sqrt 2.16 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have w2 : sqrt 2.16 < 1.4696939 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have w3 : 35.6370593 < sqrt 1270 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have w4 : sqrt 1270 < 35.6370594 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have w5 : 415.4154546 < sqrt 172570 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have w6 : sqrt 172570 < 415.4154547 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have p1 : 1.4832396 < sqrt 2.2 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have p2 : sqrt 2.2 < 1.4832397 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have p3 : 40.8656334 < sqrt 1670 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have p4 : sqrt 1670 < 40.8656335 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have p5 : 415.6921938 < sqrt 172800 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have p6 : sqrt 172800 < 415.6921939 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have z1 : 1.1269427 < sqrt 1.27 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have z2 : sqrt 1.27 < 1.1269428 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have z3 : 24.8797106 < sqrt 619 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have z4 : sqrt 619 < 24.8797107 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have z5 : 410.2438299 < sqrt 168300 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have z6 : sqrt 168300 < 410.2438300 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have W := koide_of_brackets 2.16 1270 172570 452.5222077 452.5222080 (by norm_num) (by norm_num) (by linarith) (by linarith)
  have P := koide_of_brackets 2.2 1670 172800 458.0410668 458.0410671 (by norm_num) (by norm_num) (by linarith) (by linarith)
  have Z := koide_of_brackets 1.27 619 168300 436.2504832 436.2504835 (by norm_num) (by norm_num) (by linarith) (by linarith)
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, by norm_num, by norm_num⟩
  · exact lt_trans (by norm_num) W.1
  · exact lt_trans W.2 (by norm_num)
  · exact lt_trans (by norm_num) P.1
  · exact lt_trans P.2 (by norm_num)
  · exact lt_trans (by norm_num) Z.1
  · exact lt_trans Z.2 (by norm_num)

/-- 28:C6, 28:X4, 28:P3 — the Gatto relation's leading term: with `m_d = 4.67`, `m_s = 93.4` MeV (the suite's values),
`√(m_d/m_s) ∈ (0.2236, 0.22361)`, within `0.35 %` of `V_us = 0.2243` (the paper's `0.3 %`); and at `φ = π/2`, with
`m_u = 2.16`, `m_c = 1270`, `√(m_d/m_s + m_u/m_c) ∈ (0.2273, 0.2275)` (the paper's `0.228`). -/
theorem gatto_leading (md ms mu mc Vus : ℝ) (hd : md = 4.67) (hs : ms = 93.4) (hu : mu = 2.16) (hc : mc = 1270)
    (hV : Vus = 0.2243) :
    0.2236 < sqrt (md / ms) ∧ sqrt (md / ms) < 0.22361 ∧ |sqrt (md / ms) - Vus| < 0.0035 * Vus ∧
    0.2273 < sqrt (md / ms + mu / mc) ∧ sqrt (md / ms + mu / mc) < 0.2275 := by
  subst hd hs hu hc hV
  have a1 : 0.2236 < sqrt (4.67 / 93.4) := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have a2 : sqrt (4.67 / 93.4) < 0.22361 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have b1 : 0.2273 < sqrt (4.67 / 93.4 + 2.16 / 1270) := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have b2 : sqrt (4.67 / 93.4 + 2.16 / 1270) < 0.2275 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  refine ⟨a1, a2, ?_, b1, b2⟩
  rw [abs_lt]; constructor <;> linarith

/-- 28:C7, 28:X3, 28:X6 — the effective Froggatt–Nielsen powers bracketed by the integers of the role depths, at
`λ = V_us = 0.2243`: `λ⁵ < m_d/m_b < λ⁴`, `λ³ < m_s/m_b < λ²` (down `(4, 2)`), `λ⁶ < m_e/m_τ < λ⁵`, `λ² < m_μ/m_τ < λ`
(lepton, the electron the Georgi–Jarlskog outlier one power below), `λ⁸ < m_u/m_t < λ⁷`, `λ⁴ < m_c/m_t < λ³` (up
`(8, 4)`, the doubled exponents). -/
theorem texture_powers (lam md ms mb me mmu mtau mu mc mt : ℚ) (hl : lam = 0.2243) (hd : md = 4.67) (hs : ms = 93.4)
    (hb : mb = 4180) (he : me = 0.51099895) (hmu : mmu = 105.6583755) (ht : mtau = 1776.86) (hu : mu = 2.16)
    (hc : mc = 1270) (htop : mt = 172570) :
    (lam ^ 5 < md / mb ∧ md / mb < lam ^ 4) ∧ (lam ^ 3 < ms / mb ∧ ms / mb < lam ^ 2) ∧
    (lam ^ 6 < me / mtau ∧ me / mtau < lam ^ 5) ∧ (lam ^ 2 < mmu / mtau ∧ mmu / mtau < lam) ∧
    (lam ^ 8 < mu / mt ∧ mu / mt < lam ^ 7) ∧ (lam ^ 4 < mc / mt ∧ mc / mt < lam ^ 3) := by
  subst hl hd hs hb he hmu ht hu hc htop
  norm_num

/-- 28:X5, 00:P3 — the Georgi–Jarlskog double ratio `(m_μ/m_e)/(m_s/m_d)` at the measured masses lies in `(10.3, 10.5)`, between
`10 %` and `20 %` above the colour count's `N_c² = 9`: the open excess of the minimal Clebsch. -/
theorem gj_ratio (me mmu md ms : ℚ) (he : me = 0.51099895) (hmu : mmu = 105.6583755) (hd : md = 4.67) (hs : ms = 93.4) :
    10.3 < (mmu / me) / (ms / md) ∧ (mmu / me) / (ms / md) < 10.5 ∧
    9 * 1.10 < (mmu / me) / (ms / md) ∧ (mmu / me) / (ms / md) < 9 * 1.20 := by
  subst he hmu hd hs
  norm_num

/-- 28:C3, 28:X7 — the leading-order mass ratio `m_μ/m_τ = 7 − 4√3 ∈ (0.0717, 0.0719)`, against the observed
`m_μ/m_τ = 105.6583755/1776.86 ∈ (0.0594, 0.0595)`. -/
theorem lo_ratio (mmu mtau : ℝ) (h2 : mmu = 105.6583755) (h3 : mtau = 1776.86) :
    (0.0717 : ℝ) < 7 - 4 * sqrt 3 ∧ 7 - 4 * sqrt 3 < 0.0719 ∧ 0.0594 < mmu / mtau ∧ mmu / mtau < 0.0595 := by
  subst h2 h3
  have s1 : 1.732050 < sqrt 3 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have s2 : sqrt 3 < 1.732051 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  refine ⟨by linarith, by linarith, by norm_num, by norm_num⟩

/-- 28:C9, 28:X9 — the reactor angle at leading order: `sin θ_C/√2` with `sin θ_C = V_us = 0.2243` lies in
`(0.1585, 0.1587)`, between `6 %` and `7 %` above the measured `sin θ₁₃ = 0.1488`: an estimate, not a prediction. -/
theorem theta13_estimate (Vus s13 : ℝ) (hV : Vus = 0.2243) (hs : s13 = 0.1488) :
    0.1585 < Vus / sqrt 2 ∧ Vus / sqrt 2 < 0.1587 ∧ 1.06 * s13 < Vus / sqrt 2 ∧ Vus / sqrt 2 < 1.07 * s13 := by
  subst hV hs
  have r1 : 1.4142135 < sqrt 2 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have r2 : sqrt 2 < 1.4142136 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have hpos : (0 : ℝ) < sqrt 2 := by positivity
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [lt_div_iff₀ hpos]; nlinarith
  · rw [div_lt_iff₀ hpos]; nlinarith
  · rw [lt_div_iff₀ hpos]; nlinarith
  · rw [div_lt_iff₀ hpos]; nlinarith

/-- 28:C10, 28:X10, 28:P8 — the maximal Jarlskog invariant: `1/(6√3) = √3/18` and `(1/(6√3))² = 1/108`. -/
theorem jarlskog : (1 : ℝ) / (6 * sqrt 3) = sqrt 3 / 18 ∧ ((1 : ℝ) / (6 * sqrt 3)) ^ 2 = 1 / 108 := by
  have h3 : sqrt 3 * sqrt 3 = 3 := Real.mul_self_sqrt (by norm_num)
  have hne : sqrt 3 ≠ 0 := by positivity
  constructor
  · field_simp; linarith
  · field_simp; nlinarith

/-- 28:C10, 28:P8 — the TM2 relation at maximal atmospheric mixing: `cos δ_CP = cot 2θ₂₃ · (1 − 2s₁₃²)/(s₁₃ √(2 − 3s₁₃²))`
vanishes at `θ₂₃ = π/4`, where `cos 2θ₂₃ = 0`, so `|δ_CP| = π/2`. -/
theorem tm2_at_maximal (s13 : ℝ) :
    Real.cos (2 * (π / 4)) / Real.sin (2 * (π / 4)) * ((1 - 2 * s13 ^ 2) / (s13 * sqrt (2 - 3 * s13 ^ 2))) = 0 ∧
    Real.arccos 0 = π / 2 := by
  refine ⟨?_, Real.arccos_zero⟩
  rw [show 2 * (π / 4) = π / 2 by ring, Real.cos_pi_div_two, zero_div, zero_mul]

/-- 28:C10 — the exact-TM2 solar value: `sin²θ₁₂ = 1/(3 c₁₃²)` at `sin²θ₁₃ = 0.02215` lies in `(0.3408, 0.3410)`, above
the measured `0.307`. -/
theorem exact_tm2_solar (s13sq : ℚ) (h : s13sq = 0.02215) :
    0.3408 < 1 / (3 * (1 - s13sq)) ∧ 1 / (3 * (1 - s13sq)) < 0.3410 ∧ (0.307 : ℚ) < 1 / (3 * (1 - s13sq)) := by
  subst h; norm_num

/-- 28:P5, 28:P6, 28:X11, 00:P3 — the `m₁ = 0` floor of the neutrino mass sum at NuFIT 6.0 (`Δm²₂₁ = 7.49 × 10⁻⁵`,
`Δm²₃₁ = 2.513 × 10⁻³` eV²): `√Δm²₂₁ + √Δm²₃₁ ∈ (0.0587, 0.0589)` eV, the `58.8` meV of the row. -/
theorem neutrino_floor (dm21 dm31 : ℝ) (h21 : dm21 = 7.49e-5) (h31 : dm31 = 2.513e-3) :
    0.0587 < sqrt dm21 + sqrt dm31 ∧ sqrt dm21 + sqrt dm31 < 0.0589 := by
  subst h21 h31
  have a1 : 0.0086544 < sqrt 7.49e-5 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have a2 : sqrt 7.49e-5 < 0.0086545 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have b1 : 0.0501298 < sqrt 2.513e-3 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have b2 : sqrt 2.513e-3 < 0.0501299 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  constructor <;> linarith

/-- 28:P7 — the effective Majorana mass at `m₁ = 0` on the normal ordering: with `s₁₂² = 0.307`, `s₁₃² = 0.02215` and the
NuFIT 6.0 splittings, the two terms `c₁₃² s₁₂² m₂` and `s₁₃² m₃` lie in `(2.59, 2.61)` and `(1.10, 1.12)` meV, so
`m_ββ = |c₁₃² s₁₂² m₂ + e^{iα} s₁₃² m₃|` lies between `1.47` and `3.71` meV over the Majorana phase: the row's
`1.5–3.7` meV. -/
theorem majorana_band (dm21 dm31 s12sq s13sq : ℝ) (h21 : dm21 = 7.49e-5) (h31 : dm31 = 2.513e-3)
    (h12 : s12sq = 0.307) (h13 : s13sq = 0.02215) :
    2.59 < (1 - s13sq) * s12sq * (1000 * sqrt dm21) ∧ (1 - s13sq) * s12sq * (1000 * sqrt dm21) < 2.61 ∧
    1.10 < s13sq * (1000 * sqrt dm31) ∧ s13sq * (1000 * sqrt dm31) < 1.12 ∧
    1.47 < (1 - s13sq) * s12sq * (1000 * sqrt dm21) - s13sq * (1000 * sqrt dm31) ∧
    (1 - s13sq) * s12sq * (1000 * sqrt dm21) + s13sq * (1000 * sqrt dm31) < 3.71 := by
  subst h21 h31 h12 h13
  have a1 : 0.0086544 < sqrt 7.49e-5 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have a2 : sqrt 7.49e-5 < 0.0086545 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have b1 : 0.0501298 < sqrt 2.513e-3 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  have b2 : sqrt 2.513e-3 < 0.0501299 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  refine ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩

end FRC.FlavourML

/-! inlined: FrcMathlib/Theme/Dark.lean (verbatim, minus its import lines) -/

/-!
# FrcMathlib.Theme.Dark — the chart theme's readings of the dark sector (32-dark, 18 October 2026)

The clauses of 32-dark that read the continuum law or measured data against the exact content of
`FrcCore/Theme/Dark.lean`. Every measured input enters as a hypothesis (the Hubble rate, the cosmological parameters,
the SPARC-derived accelerations), every conclusion is a rational bound or an inequality, and the exponentials are
bracketed by their Taylor sums (`Real.exp_bound`) as `FRC.Strong.interpolant_discriminant` does. The first-passage
factor as an algebraic identity (`passage_factor`, 32:C7); the reduction `arcosh e^s = √(2s)(1 + O(s))` as a bracket
(`passage_reduction`, 32:C7); the registration theorem's conditional count and chart angle (`rar_from_count`, 32:C6);
the relation as a strictly increasing function of the one variable (`rar_monotone`, 32:X11, P6); the external field
lowering the boost (`nu_antitone`, `collinear_bound`, 32:C9, X6); the scatter's deep rise (`scatter_deep`, 32:C8, X5,
P2); the coherence weight in `[0, 1]` and the bounds `1 ≤ N_eff ≤ N` (`coherence_weight`, `neff_bounds`, 32:C10, X7,
X8); the small-tilt slope one of an odd response (`odd_linear_response`, 32:C4); the sign of `Λ` (`lambda_positive`,
32:C11, X9); the Tully–Fisher zero-point at redshift (`ez_quarter_brackets`, 32:P1); the wide-binary enhancement
(`wide_binary_band`, 32:P3); the pressure-supported offset (`coherence_offset`, 32:P4); the Λ-face floor
(`floor_lambda_face`, 32:C2).
-/

namespace FRC.DarkML

open Real

/-! ## The first-passage law (32:C7, B8) -/

/-- 32:C7, 32:B8 — the first-passage factor is algebraic: for `u ≥ 1` (`u = e^s`), the root `f(1/u) = (1 − √(1 − 1/u²))·u`
of `(z/2)f² − f + z/2 = 0` equals `u − √(u² − 1)`, and `(u − √(u² − 1))(u + √(u² − 1)) = 1`: the factor is
`e^{−δ}` for the `δ` with `e^{δ} = u + √(u² − 1)`, that is `δ = arcosh u`. -/
theorem passage_factor (u : ℝ) (hu : 1 ≤ u) :
    (1 - √(1 - (1 / u) ^ 2)) / (1 / u) = u - √(u ^ 2 - 1) ∧
    (u - √(u ^ 2 - 1)) * (u + √(u ^ 2 - 1)) = 1 ∧
    exp (-Real.log (u + √(u ^ 2 - 1))) = u - √(u ^ 2 - 1) := by
  have hu0 : 0 < u := by linarith
  have hsq : 0 ≤ u ^ 2 - 1 := by nlinarith
  have hs := Real.sq_sqrt hsq
  have hpos : 0 < u + √(u ^ 2 - 1) := by positivity
  have hprod : (u - √(u ^ 2 - 1)) * (u + √(u ^ 2 - 1)) = 1 := by nlinarith [hs]
  refine ⟨?_, hprod, ?_⟩
  · have h1 : 1 - (1 / u) ^ 2 = (u ^ 2 - 1) / u ^ 2 := by field_simp
    rw [h1, Real.sqrt_div hsq, Real.sqrt_sq hu0.le]
    field_simp
  · rw [Real.exp_neg, Real.exp_log hpos]
    field_simp
    linarith [hprod]

/-- 32:C7 — the resolvable reading of the exact transform: for `0 < s` the `δ` with `cosh δ = e^s`, that is
`δ = log(e^s + √(e^{2s} − 1))`, lies between `√(2s)` and `√(2s)·e^{s/2}`, so `arcosh(e^s) = √(2s)(1 + O(s))`
(`cosh δ ≤ e^{δ²/2}` for the lower bound, `cosh δ ≥ 1 + δ²/2` and `e^s − 1 ≤ s e^s` for the upper). -/
theorem passage_reduction (s : ℝ) (hs : 0 < s) :
    √(2 * s) ≤ Real.log (exp s + √(exp s ^ 2 - 1)) ∧
    Real.log (exp s + √(exp s ^ 2 - 1)) ≤ √(2 * s) * exp (s / 2) := by
  set δ := Real.log (exp s + √(exp s ^ 2 - 1)) with hδ
  have hu : 1 < exp s := by rw [← Real.exp_zero]; exact Real.exp_lt_exp.mpr hs
  have hsq : 0 ≤ exp s ^ 2 - 1 := by nlinarith
  have hr := Real.sq_sqrt hsq
  have hpos : 0 < exp s + √(exp s ^ 2 - 1) := by positivity
  have hδ0 : 0 ≤ δ := Real.log_nonneg (by linarith [Real.sqrt_nonneg (exp s ^ 2 - 1)])
  -- cosh δ = e^s
  have hcosh : cosh δ = exp s := by
    rw [Real.cosh_eq, hδ, Real.exp_log hpos, Real.exp_neg, Real.exp_log hpos]
    have hprod : (exp s - √(exp s ^ 2 - 1)) * (exp s + √(exp s ^ 2 - 1)) = 1 := by nlinarith [hr]
    have hinv : (exp s + √(exp s ^ 2 - 1))⁻¹ = exp s - √(exp s ^ 2 - 1) :=
      inv_eq_of_mul_eq_one_right (by rw [mul_comm]; exact hprod)
    rw [hinv]; ring
  constructor
  · -- e^s = cosh δ ≤ e^{δ²/2}, so 2s ≤ δ²
    have h := Real.cosh_le_exp_half_sq δ
    rw [hcosh] at h
    have h2 : s ≤ δ ^ 2 / 2 := Real.exp_le_exp.mp h
    exact Real.sqrt_le_iff.mpr ⟨hδ0, by nlinarith⟩
  · -- cosh δ = 1 + 2 sinh²(δ/2) ≥ 1 + δ²/2, so δ² ≤ 2(e^s − 1) ≤ 2 s e^s
    have hsinh : δ / 2 ≤ sinh (δ / 2) := Real.self_le_sinh_iff.mpr (by linarith)
    have hc2 : cosh δ = 1 + 2 * sinh (δ / 2) ^ 2 := by
      have := Real.cosh_two_mul (δ / 2)
      rw [show 2 * (δ / 2) = δ by ring, Real.cosh_sq'] at this
      linarith
    have hlow : 1 + δ ^ 2 / 2 ≤ exp s := by
      rw [← hcosh, hc2]; nlinarith [hsinh, show 0 ≤ δ / 2 by linarith]
    have hexp : exp s - 1 ≤ s * exp s := by
      have := Real.add_one_le_exp (-s)
      have := mul_le_mul_of_nonneg_left this (Real.exp_pos s).le
      rw [← Real.exp_add, add_neg_cancel, Real.exp_zero] at this
      nlinarith
    have hδ2 : δ ^ 2 ≤ 2 * s * exp s := by nlinarith
    have hsqe : √(exp s) = exp (s / 2) := by
      have h2 : exp (s / 2) ^ 2 = exp s := by
        rw [← Real.exp_nat_mul]; congr 1; push_cast; ring
      rw [← h2, Real.sqrt_sq (Real.exp_pos _).le]
    have hrhs : √(2 * s * exp s) = √(2 * s) * exp (s / 2) := by
      rw [Real.sqrt_mul (by positivity : (0 : ℝ) ≤ 2 * s), hsqe]
    rw [← hrhs]
    exact Real.le_sqrt_of_sq_le hδ2

/-! ## The registration theorem (32:C6, X4, X11, P6) -/

/-- 32:C6, 32:X4 — the conditional count: with `f = 1 − e^{−√x} > 0`, `f · g_obs = g_b ↔ g_obs = g_b / f`; and the chart
angle `α = arcsin(√(e^{−√x}))` has `sin²α = e^{−√x}` and `cos²α = 1 − e^{−√x} = f`, the resolved fraction. -/
theorem rar_from_count (x gb gobs : ℝ) (hx : 0 < x) :
    0 < 1 - exp (-√x) ∧
    ((1 - exp (-√x)) * gobs = gb ↔ gobs = gb / (1 - exp (-√x))) ∧
    sin (arcsin (√(exp (-√x)))) ^ 2 = exp (-√x) ∧
    cos (arcsin (√(exp (-√x)))) ^ 2 = 1 - exp (-√x) := by
  have hsx : 0 < √x := Real.sqrt_pos.mpr hx
  have he : exp (-√x) < 1 := by rw [← Real.exp_zero]; exact Real.exp_lt_exp.mpr (by linarith)
  have hf : 0 < 1 - exp (-√x) := by linarith
  have he0 : 0 ≤ exp (-√x) := (Real.exp_pos _).le
  have hsq : √(exp (-√x)) ≤ 1 := Real.sqrt_le_one.mpr he.le
  have hsin : sin (arcsin (√(exp (-√x)))) = √(exp (-√x)) :=
    Real.sin_arcsin (by linarith [Real.sqrt_nonneg (exp (-√x))]) hsq
  refine ⟨hf, ⟨fun h => ?_, fun h => ?_⟩, ?_, ?_⟩
  · rw [eq_div_iff hf.ne', mul_comm]; exact h
  · rw [h, mul_div_cancel₀ _ hf.ne']
  · rw [hsin, Real.sq_sqrt he0]
  · rw [Real.cos_sq', hsin, Real.sq_sqrt he0]

/-- 32:X11, 32:P6 — the relation is a strictly increasing function of the one variable: `t ↦ t²/(1 − e^{−t})` is
strictly increasing on `t > 0` (its derivative `(2t(1 − e^{−t}) − t² e^{−t})/(1 − e^{−t})²` is positive, because
`2(e^t − 1) > t`), so `x ↦ x/(1 − e^{−√x})` is strictly increasing on `x > 0`: one registered acceleration fixes one
baryonic acceleration, with no second component and no direction in the law. -/
theorem rar_monotone : StrictMonoOn (fun x : ℝ => x / (1 - exp (-√x))) (Set.Ioi 0) := by
  have hφ : StrictMonoOn (fun t : ℝ => t ^ 2 / (1 - exp (-t))) (Set.Ioi 0) := by
    apply strictMonoOn_of_deriv_pos (convex_Ioi 0)
    · apply ContinuousOn.div (by fun_prop) (by fun_prop)
      intro t ht
      have : exp (-t) < 1 := by rw [← Real.exp_zero]; exact Real.exp_lt_exp.mpr (by simpa using ht)
      linarith
    · intro t ht
      rw [interior_Ioi] at ht
      have ht0 : 0 < t := ht
      have he : exp (-t) < 1 := by rw [← Real.exp_zero]; exact Real.exp_lt_exp.mpr (by linarith)
      have hd : HasDerivAt (fun t : ℝ => t ^ 2 / (1 - exp (-t)))
          ((2 * t * (1 - exp (-t)) - t ^ 2 * exp (-t)) / (1 - exp (-t)) ^ 2) t := by
        have h1 : HasDerivAt (fun t : ℝ => t ^ 2) (2 * t) t := by
          simpa using hasDerivAt_pow 2 t
        have h2 : HasDerivAt (fun t : ℝ => 1 - exp (-t)) (exp (-t)) t := by
          have := ((Real.hasDerivAt_exp (-t)).comp t (hasDerivAt_neg t))
          have h3 := this.const_sub 1
          simpa using h3
        have := h1.div h2 (by linarith)
        convert this using 1
      rw [hd.deriv]
      apply div_pos
      · -- 2(1 − e^{−t}) − t e^{−t} > 0 ⟺ 2(e^t − 1) > t
        have h3 : t + 1 < exp t := Real.add_one_lt_exp ht0.ne'
        have h4 : exp (-t) * exp t = 1 := by rw [← Real.exp_add]; simp
        have h5 : 0 < exp (-t) := Real.exp_pos _
        nlinarith [h3, h4, h5, mul_pos ht0 h5]
      · positivity
  intro x hx y hy hxy
  have hx0 : (0 : ℝ) < x := hx
  have hy0 : (0 : ℝ) < y := hy
  have hsx : 0 < √x := Real.sqrt_pos.mpr hx0
  have hsy : 0 < √y := Real.sqrt_pos.mpr hy0
  have := hφ (show √x ∈ Set.Ioi 0 from hsx) (show √y ∈ Set.Ioi 0 from hsy) (Real.sqrt_lt_sqrt hx0.le hxy)
  simpa [Real.sq_sqrt hx0.le, Real.sq_sqrt hy0.le] using this

/-! ## The external field (32:C9, X6) -/

/-- 32:C9, 32:X6 — a stronger total field lowers the boost: `ν(y) = 1/(1 − e^{−√y})` is strictly decreasing, so the
environment uses up the deep enhancement. -/
theorem nu_antitone (y₁ y₂ : ℝ) (h0 : 0 < y₁) (h : y₁ < y₂) :
    1 / (1 - exp (-√y₂)) < 1 / (1 - exp (-√y₁)) := by
  have hs1 : 0 < √y₁ := Real.sqrt_pos.mpr h0
  have hs : √y₁ < √y₂ := Real.sqrt_lt_sqrt h0.le h
  have he1 : exp (-√y₁) < 1 := by rw [← Real.exp_zero]; exact Real.exp_lt_exp.mpr (by linarith)
  have he : exp (-√y₂) < exp (-√y₁) := Real.exp_lt_exp.mpr (by linarith)
  exact one_div_lt_one_div_of_lt (by linarith) (by linarith)

/-- 32:C9 — the argument of the registration is the magnitude of the vector total field, bounded by the collinear
sum `|g_in| + |g_ext|` (the triangle inequality), the estimate the text uses. -/
theorem collinear_bound (gin gext : EuclideanSpace ℝ (Fin 3)) : ‖gin + gext‖ ≤ ‖gin‖ + ‖gext‖ :=
  norm_add_le gin gext

/-! ## The scatter (32:C8, X5, P2) -/

/-- 32:C8, 32:X5, 32:P2 — the scatter's deep rise: `tan²α = 1/(e^{√x} − 1)` is strictly decreasing in `x` (the
scatter is smallest at high acceleration), and for `0 < x ≤ 1` it is bracketed by `(1 − √x)/√x` and `1/√x`, so
`tan α` rises as `x^{−1/4}` into the deep regime. -/
theorem scatter_deep (x y : ℝ) (hx : 0 < x) (hxy : x < y) :
    1 / (exp (√y) - 1) < 1 / (exp (√x) - 1) ∧
    (x ≤ 1 → (1 - √x) / √x ≤ 1 / (exp (√x) - 1) ∧ 1 / (exp (√x) - 1) < 1 / √x) := by
  have hsx : 0 < √x := Real.sqrt_pos.mpr hx
  have hsxy : √x < √y := Real.sqrt_lt_sqrt hx.le hxy
  have hex : 1 < exp (√x) := by rw [← Real.exp_zero]; exact Real.exp_lt_exp.mpr hsx
  have hey : exp (√x) < exp (√y) := Real.exp_lt_exp.mpr hsxy
  refine ⟨?_, fun hx1 => ⟨?_, ?_⟩⟩
  · apply one_div_lt_one_div_of_lt (by linarith) (by linarith)
  · -- (1 − t)(e^t − 1) ≤ t, from e^t(1 − t) ≤ e^t e^{−t} = 1 (e^{−t} ≥ 1 − t)
    have hneg := Real.add_one_le_exp (-√x)
    have hprod : exp (√x) * (1 - √x) ≤ 1 := by
      have := mul_le_mul_of_nonneg_left hneg (Real.exp_pos (√x)).le
      rw [← Real.exp_add, add_neg_cancel, Real.exp_zero] at this
      linarith
    rw [div_le_div_iff₀ hsx (by linarith)]
    nlinarith [hprod]
  · -- e^t − 1 > t for t > 0
    have := Real.add_one_lt_exp (ne_of_gt hsx)
    exact one_div_lt_one_div_of_lt hsx (by linarith)

/-! ## The coherence law (32:C10, X7, X8, B9) -/

/-- 32:C10, 32:X7, 32:B9 — the bulk-coherence weight of unit phasors is at most one, `‖Σ z_k / n‖² ≤ 1`, and equals one
for a clump sharing one phase. -/
theorem coherence_weight (n : ℕ) (hn : 0 < n) (z : Fin n → ℂ) (h : ∀ k, ‖z k‖ = 1) (z₀ : ℂ) (h₀ : ‖z₀‖ = 1) :
    ‖(∑ k, z k) / n‖ ^ 2 ≤ 1 ∧ ‖(∑ _k : Fin n, z₀) / n‖ ^ 2 = 1 := by
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  constructor
  · have h1 : ‖∑ k, z k‖ ≤ n := by
      calc ‖∑ k, z k‖ ≤ ∑ k, ‖z k‖ := norm_sum_le _ _
        _ = ∑ _k : Fin n, (1 : ℝ) := Finset.sum_congr rfl (fun k _ => h k)
        _ = n := by simp
    have h2 : ‖(∑ k, z k) / n‖ ≤ 1 := by
      rw [norm_div, Complex.norm_natCast, div_le_one hn']; exact h1
    nlinarith [norm_nonneg ((∑ k, z k) / n)]
  · have hnz : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_div_assoc,
      show (n : ℂ) * (z₀ / n) = z₀ by field_simp, h₀]; norm_num

/-- 32:X8, 32:C10 — the effective number of coherent composites, `N_eff = (Σ√g_i)²/Σ g_i`, lies between one and `N`:
`Σ g ≤ (Σ √g)² ≤ N · Σ g` for non-negative `g` (the cross terms non-negative; Cauchy–Schwarz). -/
theorem neff_bounds (n : ℕ) (g : Fin n → ℝ) (hg : ∀ k, 0 ≤ g k) :
    ∑ k, g k ≤ (∑ k, √(g k)) ^ 2 ∧ (∑ k, √(g k)) ^ 2 ≤ n * ∑ k, g k := by
  constructor
  · have : ∑ k, g k = ∑ k, √(g k) ^ 2 := Finset.sum_congr rfl (fun k _ => (Real.sq_sqrt (hg k)).symm)
    rw [this]
    exact Finset.sum_sq_le_sq_sum_of_nonneg (fun k _ => Real.sqrt_nonneg _)
  · have := sq_sum_le_card_mul_sum_sq (s := Finset.univ) (f := fun k => √(g k))
    simp only [Finset.card_univ, Fintype.card_fin] at this
    calc (∑ k, √(g k)) ^ 2 ≤ n * ∑ k, √(g k) ^ 2 := this
      _ = n * ∑ k, g k := by
        congr 1; exact Finset.sum_congr rfl (fun k _ => Real.sq_sqrt (hg k))

/-! ## The deep regime (32:C4) -/

/-- 32:C4 — the small-tilt response is linear: an odd function `f` (the transmitted flux against the tilt) with
derivative `χ ≠ 0` at zero has `f(T)/(χT) → 1` as `T → 0`, the log-slope one of the stationary mean — the mean force
Newtonian at leading order, the square root a registration, not a force law. -/
theorem odd_linear_response (f : ℝ → ℝ) (χ : ℝ) (hodd : ∀ T, f (-T) = -f T) (hd : HasDerivAt f χ 0)
    (hχ : χ ≠ 0) :
    Filter.Tendsto (fun T : ℝ => f T / (χ * T)) (nhdsWithin 0 {0}ᶜ) (nhds 1) := by
  have hf0 : f 0 = 0 := by
    have := hodd 0; simp at this; linarith
  have h := (hasDerivAt_iff_tendsto_slope_zero.mp hd)
  simp only [zero_add, hf0, sub_zero, smul_eq_mul] at h
  have h2 : Filter.Tendsto (fun t : ℝ => t⁻¹ * f t / χ) (nhdsWithin 0 {0}ᶜ) (nhds (χ / χ)) :=
    h.div_const χ
  rw [div_self hχ] at h2
  refine h2.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with t ht
  have ht0 : t ≠ 0 := ht
  field_simp

/-! ## The cosmological constant (32:C11, X9, X10) -/

/-- 32:C11, 32:X9, 32:X10 — the curvature of the finite chart is positive: `Λ = 3/r² > 0` for `r ≠ 0`, and with
`r² = S/π` the product `Λ · S` is `3π`, the one cardinality read twice (`lambda_face`). -/
theorem lambda_positive (r S : ℝ) (hr : r ≠ 0) (hS : r ^ 2 = S / π) : 0 < 3 / r ^ 2 ∧ 3 / r ^ 2 * S = 3 * π := by
  have hπ := Real.pi_pos
  have hr2 : 0 < r ^ 2 := by positivity
  have hS0 : S ≠ 0 := by
