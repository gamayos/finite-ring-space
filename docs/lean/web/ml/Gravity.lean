theorem ez_quarter_brackets :
    (1.072 : ℝ) < √(√(√(0.315 * 1.5 ^ 3 + 0.685))) ∧ √(√(√(0.315 * 1.5 ^ 3 + 0.685))) < 1.073 ∧
