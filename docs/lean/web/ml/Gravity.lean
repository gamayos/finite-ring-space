/-- A bracket of `√a` from a bracket of `a` and the squares of the ends. -/
theorem sqrt_step (a lo hi lo' hi' : ℝ) (h1 : lo < a) (h2 : a < hi) (h3 : lo' ^ 2 ≤ lo) (h4 : hi ≤ hi' ^ 2)
