/-- The shell Fourier matrix, `W k j = g^(j·k)`. -/
def W (g : K) : Matrix (Fin n) (Fin n) K := fun k j => g ^ ((j : ℕ) * (k : ℕ))

/-- The reversal `J k l = [l = −k]`. -/
def J : Matrix (Fin n) (Fin n) K := fun k l => if l = -k then 1 else 0

