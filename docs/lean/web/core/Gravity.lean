  rw [pow_succ, pow_two, h, ← neg_mul, one_mul]
theorem neg_cube_pow {i : Shell p} (h : i * i = -1) : (-i) ^ 3 = i := by
  rw [pow_succ, neg_sq_pow h, neg_mul_neg, one_mul]

