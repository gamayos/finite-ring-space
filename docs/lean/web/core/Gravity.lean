theorem scale_shift (F : Frame p κ g) {z : Shell p} (hz : g * z = 1) :
    (∀ m r, (meridian g κ m).map (scale g r) = meridian g κ (m + r)) ∧
    (∀ r x, scale g (r + (p - 1)) x = scale g r x) ∧
