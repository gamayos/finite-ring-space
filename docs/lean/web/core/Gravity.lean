theorem proj_conj (F : Frame p κ g) {z : Shell p} (hz : g * z = 1) (ℓ : Nat) {k j : Nat} (hk : k < p - 1)
    (hj : j < p - 1) : proj z κ ℓ k j = proj g κ (ℓ + 2) k j := by
  have h := F.quarter_turn_sq
