  rw [sum_eq_single hk (fun l _ hne => by
    show (if k = l then a ^ k else 0) * X l j = 0
    rw [ite_eq_right (fun e => hne e.symm), zero_mul])]
  show (if k = k then a ^ k else 0) * X k j = _
  rw [ite_eq_left rfl]

