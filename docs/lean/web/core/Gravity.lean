    F.pow_inj hm hm' (by
      have e1 := find4_spec (fun ℓ => (z ^ s) ^ ℓ = g ^ m) (match heig m with | ⟨ℓ, hℓ, e⟩ => ⟨ℓ, hℓ, e.symm⟩)
