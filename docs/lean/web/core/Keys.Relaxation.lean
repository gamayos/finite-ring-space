def firstReturn (L a : Nat) : Nat := least (isReturn L a) L 1

theorem firstReturn_pos (L a : Nat) : 1 ≤ firstReturn L a := least_le _ L 1

theorem firstReturn_le (L a : Nat) : firstReturn L a ≤ L + 1 := by
