/-- 3:E3 (p03022) — The window is sharp: no integer point with coordinates bounded by $R$, where $3R^{2}<\p$ and $\g R^{2}<\p$, is a null point of the shell off the real cone; for $\p=a^{2}+b^{2}$, $0<a\le b$, the point $(0,a,b,0)$ is one, so the least such half-width $R_{\star}$ has $\p\le\max(\g,3)R_{\star}^{2}$ and $R_{\star}\le b<\sqrt{\p}$. -/
theorem window_sharpness : (∀ {p ν R x y z t : Nat}, x ≤ R → y ≤ R → z ≤ R → t ≤ R → R * R + R * R + R * R < p → ν * (R * R) < p → (x * x + y * y + z * z) % p = ν * (t * t) % p → x * x + y * y + z * z = ν * (t * t)) ∧ ∀ {p ν a b : Nat}, (0 : Nat) < a → a * a + b * b = p → (a * a + b * b + (0 : Nat) * (0 : Nat)) % p = ν * ((0 : Nat) * (0 : Nat)) % p ∧ a * a + b * b + (0 : Nat) * (0 : Nat) ≠ ν * ((0 : Nat) * (0 : Nat)) ∧ b * b < p :=
  @FRC.Ledger.p03022
/-- 3:E4 (p03026) — The temporal fibres: above each nonzero pair $(t,x)$ the null cone of $Q_{\g}$ has $\p-1$ points, above the origin $2\p-1$; the null cone spreads evenly over the temporal plane. -/
theorem temporal_fibres : ∀ {p : Nat} [FRC.Pos p] {κ : Nat} {g : FRC.Shell p}, FRC.Shell.Frame p κ g → ∀ (t x : FRC.Shell p), FRC.Grav.nsum (fun y => FRC.Grav.count fun z => FRC.Shell.ofNat y * FRC.Shell.ofNat y + z * z = (0 : FRC.Shell p) + -FRC.Shell.Frame.Q2 g t x) p = p - (1 : Nat) + if t = (0 : FRC.Shell p) ∧ x = (0 : FRC.Shell p) then p else (0 : Nat) :=
  @FRC.Ledger.p03026
