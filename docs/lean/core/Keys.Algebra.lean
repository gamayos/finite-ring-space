def p01035 := And.intro @FRC.Shell.Frame.frac_window (And.intro @FRC.Shell.Frame.frac_window_inv (And.intro @FRC.Shell.Frame.frac_mul_readback (@FRC.Shell.Frame.frac_add_readback)))
