      (Fin (Fintype.card (ZMod p) - 1)) (ZMod p)) ^ 2 = J := by
  have hc : Fintype.card (ZMod p) = p := ZMod.card p
  exact (shell_relations κ (by rw [hc, hκ]) g (by rw [hc]; exact hg)).2.1

